# Identity is deliberately not here. This file is tracked and published, so a
# name and address in it are both a disclosure and a trap: a fork that runs
# ./install would author every commit as this repository's owner until someone
# noticed. `funk git-identity` writes the file included below, which is local
# and untracked. The path is spelled absolutely rather than relatively because
# a relative include resolves against the directory of the *link* git opened,
# which is only outside the checkout while the git package stays --no-folding.
[include]
    path = ~/.config/git/config.local
[alias]
    st = status
    ci = commit
    cp = cherry-pick
    br = branch -v
    df = diff
    dfc = diff --cached
    dfh = diff HEAD
    co = checkout
    pl = log --pretty=oneline
    pls = log --pretty=oneline -5
    plm = log --pretty=oneline -10
    pll = log --pretty=oneline -20
    tree = log --graph --pretty=oneline --decorate
    amend = commit --amend -C HEAD
    s = stash --include-untracked
    sa = stash apply
    sk = stash --include-untracked --keep-index

    l  = log --pretty='format:%h%d %s %an, %ar'
    lg = log --pretty='format:%h%d %s %an, %ar' --graph
    lga = log --pretty='format:%h%d %s %an, %ar' --graph --all
    r = rev-parse
    rs = rev-parse --short
    brl = for-each-ref --sort=committerdate refs/heads/ --format='%(HEAD) %(refname:short) - %(objectname:short) - %(contents:subject) - %(authorname) (%(committerdate:relative))'
    t = ls-tree -r HEAD --name-only
[core]
    pager = delta
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true
    side-by-side = false
    line-numbers = true
[push]
    default = simple
[init]
	defaultBranch = main
[pull]
	rebase = true
[credential "https://github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper =
	helper = !/opt/homebrew/bin/gh auth git-credential
