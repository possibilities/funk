+
+/**
+ * Send one state-vector echo to every supplied connection.
+ *
+ * The post-persist caller supplies only clients whose changed updates belong to
+ * the completed save, so they receive the advanced durability generation that
+ * can confirm their pending local candidates. The immediate post-apply echo
+ * deliberately remains weaker: it reports in-memory receipt while the save is
+ * still outstanding.
+ */
+export function trySendSvEchoToConnections(
+	connections: Iterable<SendableConnection>,
+	doc: Y.Doc,
+	kind: SvEchoKind,
+	durability?: SvEchoDurability,
+): SvEchoSendResult[] {
+	const results: SvEchoSendResult[] = [];
+	for (const connection of connections) {
+		results.push(trySendSvEcho(connection, doc, kind, durability));
+	}
+	return results;
+}
