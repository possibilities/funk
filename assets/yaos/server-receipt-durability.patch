+async function waitForPersistedGeneration(
+	getDurabilityEchoes: () => Array<{ generation: number; epoch: string }>,
+	baseline: { generation: number; epoch: string },
+	label: string,
+): Promise<number> {
+	const deadline = Date.now() + 10_000;
+	while (Date.now() < deadline) {
+		const advanced = getDurabilityEchoes().find(
+			(echo) => echo.epoch === baseline.epoch && echo.generation > baseline.generation,
+		);
+		if (advanced) return advanced.generation;
+		await wait(50);
+	}
+	throw new Error(`${label}: timed out waiting for post-persist generation advance`);
+}
