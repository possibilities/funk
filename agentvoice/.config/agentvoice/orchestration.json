      "verifyCommand": "bun test && bun run typecheck",
      "allowDirectMain": true,
      "push": "ask"
    },
    {
      "name": "agentvoice-ui-spike",
      "path": "/Users/arthack/code/agentvoice-ui-spike",
      "defaultBranch": "main",
      "verifyCommand": "bun test && bun run typecheck",
