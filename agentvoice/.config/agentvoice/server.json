{
  "$schema": "./server.schema.json",
  "accounts": {
    "balance": true
  },
  "orchestrator": {
    "dispatch": true,
    "dispatch-reports": true,
    "effort": "high",
    "sandbox": "workspace-write",
    "approval-policy": "on-request",
    "approvals-reviewer": "auto_review",
    "config": {
      "model_auto_compact_token_limit": 60000,
      "agents": { "enabled": false }
    }
  },
  "voice": {
    "codex-response-handoff-mode": "bemTags"
  }
}
