# Focus windows.
cmd - h : yabai -m window --focus west
cmd - j : yabai -m window --focus south
cmd - k : yabai -m window --focus north
cmd - l : yabai -m window --focus east

# Move windows within the layout.
cmd + shift - h : yabai -m window --warp west
cmd + shift - j : yabai -m window --warp south
cmd + shift - k : yabai -m window --warp north
cmd + shift - l : yabai -m window --warp east

# Toggle layout, floating, and rebalance.
cmd - space : if yabai -m query --spaces --space | /usr/bin/grep -Eq '"type"[[:space:]]*:[[:space:]]*"bsp"'; then yabai -m space --layout stack; else yabai -m space --layout bsp; fi
cmd + shift - f : yabai -m window --toggle float
ctrl + cmd + shift - g : yabai -m space --balance

# Karabiner maps Cmd+1…8 to F13…F20 and Cmd+9 to F12. Keeping this
# indirection here lets
# Ctrl+1…9 become ordinary browser Cmd+number shortcuts without recursion.
f13 : yabai -m space --focus 1
f14 : yabai -m space --focus 2
f15 : yabai -m space --focus 3
f16 : yabai -m space --focus 4
f17 : yabai -m space --focus 5
f18 : yabai -m space --focus 6
f19 : yabai -m space --focus 7
# This skhd build does not recognize the F20 literal; 0x5A is its raw keycode.
0x5A : yabai -m space --focus 8
f12 : yabai -m space --focus 9

# Moving windows between Spaces requires Yabai's scripting addition.
cmd + shift - 1 : yabai -m window --space 1
cmd + shift - 2 : yabai -m window --space 2
cmd + shift - 3 : yabai -m window --space 3
cmd + shift - 4 : yabai -m window --space 4
cmd + shift - 5 : yabai -m window --space 5
cmd + shift - 6 : yabai -m window --space 6
cmd + shift - 7 : yabai -m window --space 7
cmd + shift - 8 : yabai -m window --space 8
cmd + shift - 9 : yabai -m window --space 9

# Preserve Ctrl+L muscle memory for the address bar without synthesizing Cmd+L,
# which is reserved above for focusing the window to the east.
ctrl - l [
    "Google Chrome" : ~/.local/bin/focus-address-bar
    "Google Chrome Canary" : ~/.local/bin/focus-address-bar
    "Firefox" : ~/.local/bin/focus-address-bar
    "Brave Browser" : ~/.local/bin/focus-address-bar
    * ~
]

# Additional screenshot bindings; stock macOS shortcuts remain untouched.
ctrl + shift - 3 : /usr/sbin/screencapture -c
ctrl + shift - 4 : /usr/sbin/screencapture -i -c
ctrl + shift - 5 : /usr/sbin/screencapture -i "$HOME/Desktop/screenshot-$(date +\%Y\%m\%d-\%H\%M\%S).png"

# Dismiss every terminal-notifier notification.
ctrl + cmd - escape : terminal-notifier -remove ALL

# Raycast Clipboard History.
cmd + shift - v : /usr/bin/open "raycast://extensions/raycast/clipboard-history/clipboard-history"
