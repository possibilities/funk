#!/bin/bash

set -euo pipefail

[ "${1:-}" = "-q" ] && [ "${2:-}" = host ] \
    && [ "${3:-}" = "-a" ] && [ "${4:-}" = name ] && [ "$#" -eq 5 ] \
    || {
        printf 'unexpected dscacheutil fixture command: %s\n' "$*" >&2
        exit 64
    }

[ "${FUNK_TEST_MAGICDNS_FAIL:-0}" -eq 0 ] || exit 0
printf 'name: %s\n' "$5"
printf 'ip_address: 100.64.0.20\n'
