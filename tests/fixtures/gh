#!/bin/bash

set -euo pipefail

: "${FUNK_TEST_GH_LOG:?FUNK_TEST_GH_LOG is not set}"

case "${1:-} ${2:-}" in
    'repo create')
        shift 2
        {
            printf 'cwd=%s\n' "$PWD"
            printf 'arg=%s\n' "$@"
        } >"$FUNK_TEST_GH_LOG"
        # Stand in for a repository that already exists on GitHub.
        [ -n "${FUNK_TEST_GH_CREATE_FAILS:-}" ] || exit 0
        printf 'gh-stub: name already exists on this account\n' >&2
        exit 1
        ;;
    'repo view')
        case " $* " in
            *' --json visibility '*)
                [ -n "${FUNK_TEST_GH_VISIBILITY_FILE:-}" ] || exit 1
                cat "$FUNK_TEST_GH_VISIBILITY_FILE"
                ;;
            *)
                # gh repo view <repo> --json <field> --jq .<field>
                [ -n "${FUNK_TEST_GH_REPO_URL:-}" ] || exit 1
                printf '%s\n' "$FUNK_TEST_GH_REPO_URL"
                ;;
        esac
        ;;
    'repo edit')
        shift 2
        requested_visibility=
        while [ "$#" -gt 0 ]; do
            case "$1" in
                --visibility)
                    requested_visibility=$2
                    shift 2
                    ;;
                --accept-visibility-change-consequences)
                    shift
                    ;;
                *)
                    printf 'gh-stub: unexpected repo edit argument: %s\n' "$1" >&2
                    exit 64
                    ;;
            esac
        done
        [ -n "${FUNK_TEST_GH_VISIBILITY_FILE:-}" ] || exit 1
        [ -n "${FUNK_TEST_GH_VISIBILITY_LOG:-}" ] || exit 1
        printf '%s\n' "$requested_visibility" >"$FUNK_TEST_GH_VISIBILITY_FILE"
        printf '%s\n' "$requested_visibility" >>"$FUNK_TEST_GH_VISIBILITY_LOG"
        ;;
    'config get')
        printf '%s\n' "${FUNK_TEST_GH_GIT_PROTOCOL:-https}"
        ;;
    *)
        printf 'gh-stub: unexpected command\n' >&2
        exit 64
        ;;
esac
