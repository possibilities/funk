#!/bin/bash

set -euo pipefail

[ "${1:-}" = -n ] || exit 1
router=${2:-}

address=${FUNK_TEST_HA_ROUTER_MAC-c8:7f:54:42:ac:b8}

# An address that has aged out reads as incomplete until something probes it.
if [ -n "${FUNK_TEST_HA_ARP_COLD_FILE:-}" ] && [ ! -e "${FUNK_TEST_HA_ARP_COLD_FILE}" ]; then
    printf '? (%s) at (incomplete) on en5 ifscope [ethernet]\n' "$router"
    exit 0
fi

if [ -z "$address" ]; then
    printf 'arp: %s -- no entry\n' "$router" >&2
    exit 1
fi

printf '? (%s) at %s on en5 ifscope [ethernet]\n' "$router" "$address"
