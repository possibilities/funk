#!/bin/bash

set -euo pipefail

[ "${1:-}" = :app:assembleDebug ] && [ "$#" -eq 1 ] || exit 64
[ -f "app/src/main/assets/themes/Signal Room" ] || exit 1
mkdir -p app/build/outputs/apk/debug
: >app/build/outputs/apk/debug/app-debug.apk
printf ':app:assembleDebug\n' >"${FUNK_TEST_CHUCHU_GRADLE_LOG:?}"
