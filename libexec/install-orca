#!/bin/bash

set -euo pipefail

die() {
    printf 'Funk Orca installer: %s\n' "$*" >&2
    exit 1
}

find_brew() {
    if [ -n "${FUNK_BREW_BIN:-}" ] && [ -x "$FUNK_BREW_BIN" ]; then
        printf '%s\n' "$FUNK_BREW_BIN"
        return
    fi
    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return
    fi
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    return 1
}

case "${1:-}" in
    "")
        ;;
    --check)
        [ "$#" -eq 1 ] || {
            printf 'Usage: install-orca [--check]\n' >&2
            exit 64
        }
        cat <<'EOF'
Orca:
  brew install --cask --yes stablyai/orca/orca  # when missing
  leave an installed Orca to its own updater  # never brew upgrade
  remove com.apple.quarantine only from Homebrew's declared Orca.app target
  npx --yes skills add https://github.com/stablyai/orca --agent codex claude-code opencode pi --skill orca-cli orchestration computer-use --global --yes
  verify the cask receipt and the three global skill records
EOF
        exit 0
        ;;
    -h|--help)
        printf 'Usage: install-orca [--check]\n'
        exit 0
        ;;
    *)
        printf 'Usage: install-orca [--check]\n' >&2
        exit 64
        ;;
esac

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

script_dir=$(cd -P -- "$(dirname -- "$0")" && pwd)
brew_bin=$(find_brew) || die "Homebrew is not installed"
brew_prefix=$("$brew_bin" --prefix)
original_path=$PATH
export FUNK_BREW_BIN="$brew_bin"
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$brew_prefix/bin:/usr/bin:/bin:/usr/sbin:/sbin:$original_path"

# Install-only, because Orca ships its own updater and the cask says so:
# `auto_updates true` exists to keep Homebrew from competing with it, and
# `--greedy` is precisely the flag that overrides that. Homebrew replaces the
# bundle in place without quitting the app, so upgrading a running Orca leaves
# its renderer resolving code-split chunks out of a bundle that is no longer
# the one it started from -- the app breaks mid-session, most visibly on the
# first lazily loaded pane. Orca's own updater stages the download and applies
# it on quit, when nothing is left to break.
"$script_dir/converge-brew-casks" --install-only stablyai/orca/orca

if [ -n "${FUNK_NPX_BIN:-}" ] && [ -x "$FUNK_NPX_BIN" ]; then
    npx_bin="$FUNK_NPX_BIN"
elif ! command -v npx >/dev/null 2>&1; then
    nvm_script="$brew_prefix/opt/nvm/nvm.sh"
    if [ -s "$nvm_script" ]; then
        export NVM_DIR="$HOME/.nvm"
        # shellcheck disable=SC1090
        source "$nvm_script" --no-use
        if nvm version default >/dev/null 2>&1; then
            nvm use --silent default
        fi
    fi
    npx_bin=$(command -v npx) || die "npx is required to synchronize Orca skills"
else
    npx_bin=$(command -v npx)
fi

printf 'Synchronizing the globally managed Orca agent skills.\n'
"$npx_bin" --yes skills add https://github.com/stablyai/orca \
    --agent codex claude-code opencode pi \
    --skill orca-cli orchestration computer-use \
    --global --yes

installed=$("$brew_bin" list --cask --versions orca 2>/dev/null || true)
[ -n "$installed" ] || die "Orca cask verification failed"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/funk-orca-install.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT
skills_json="$tmpdir/skills.json"
"$npx_bin" --yes skills list --global --json >"$skills_json"

/usr/bin/jq -e '
  def has_agent($name): .agents | index($name) != null;
  [
    .[]
    | select(
        (.name == "orca-cli" or
         .name == "orchestration" or
         .name == "computer-use") and
        .scope == "global" and
        .source == "stablyai/orca" and
        has_agent("Codex") and
        has_agent("Claude Code") and
        has_agent("OpenCode") and
        has_agent("Pi")
      )
    | .name
  ]
  | unique
  | sort == ["computer-use", "orca-cli", "orchestration"]
' "$skills_json" >/dev/null || die "Orca global skill verification failed"

printf 'Verified Orca cask and global skills for Codex, Claude Code, OpenCode, and Pi.\n'
