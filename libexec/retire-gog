#!/usr/bin/env python3
"""Retire Funk's Gog package and helper after the Executor email cutover.

Full-install step only; never used by the scheduled updater. Active consumers
must already use Executor. Account credentials are not removed or copied.
"""

import json
import os
from pathlib import Path
import shutil
import subprocess
import sys


def fail(message):
    raise RuntimeError(message)


def main():
    if len(sys.argv) != 1:
        fail("this helper accepts no arguments")
    if sys.platform != "darwin" or os.geteuid() == 0:
        fail("run as the target user on macOS")
    root = Path(__file__).resolve().parent.parent
    target_home = Path.home()
    link = target_home / ".local/bin/gog-ensure-authed"
    expected = target_home / "code/funk/bin/.local/bin/gog-ensure-authed"

    def owned_link():
        if not link.exists() and not link.is_symlink():
            return None
        if not link.is_symlink() or link.resolve() != expected.resolve():
            fail(f"refusing to remove an unowned auth helper: {link}")
        info = link.lstat()
        return info.st_dev, info.st_ino, os.readlink(link)

    previous_link = owned_link()
    brew = os.environ.get("FUNK_BREW_BIN") or shutil.which("brew")
    if not brew:
        fail("Homebrew is required to inspect package ownership")
    environment = {**os.environ, "HOMEBREW_NO_AUTO_UPDATE": "1",
                   "HOMEBREW_NO_ANALYTICS": "1", "HOMEBREW_NO_ASK": "1",
                   "HOMEBREW_NO_AUTOREMOVE": "1"}

    def installed():
        result = subprocess.run([brew, "info", "--json=v2", "--installed"],
                                env=environment, stdin=subprocess.DEVNULL,
                                capture_output=True, text=True, timeout=60, check=True)
        rows = json.loads(result.stdout).get("formulae")
        if not isinstance(rows, list) or not all(isinstance(row, dict) for row in rows):
            fail("Homebrew returned an invalid formula inventory")
        matches = [row for row in rows if row.get("name") == "gogcli"]
        if len(matches) > 1:
            fail("multiple Gog formula records; package ownership is ambiguous")
        if not matches:
            return False
        record = matches[0]
        if record.get("full_name") != "openclaw/tap/gogcli" or record.get("tap") != "openclaw/tap":
            fail("refusing to uninstall an independently sourced Gog formula")
        if not isinstance(record.get("installed"), list) or not record["installed"]:
            fail("Homebrew returned an incomplete installed Gog record")
        return True

    present = installed()
    # Preflight link and formula ownership before the existing service owner
    # performs its guarded retirement. No general launchd or brew cleanup.
    subprocess.run([str(root / "libexec/retire-gog-auth-agent")], check=True)
    if present:
        subprocess.run([brew, "uninstall", "--formula", "openclaw/tap/gogcli"],
                       env=environment, stdin=subprocess.DEVNULL, timeout=120, check=True)
        if installed():
            fail("Homebrew still reports Gog installed")
    if owned_link() != previous_link:
        fail("auth helper changed during retirement; preserved")
    if previous_link is not None:
        link.unlink()
    print("Retired the Gog package and owned auth helper; account credentials retained.")


if __name__ == "__main__":
    try:
        main()
    except (RuntimeError, ValueError, OSError, subprocess.SubprocessError) as error:
        print(f"Funk Gog retirement: {error}", file=sys.stderr)
        sys.exit(1)
