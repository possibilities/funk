#!/bin/bash

set -euo pipefail

check_only=0

usage() {
    cat <<'EOF'
Usage: install-local-services [--check]

Install the resident services owned by local project checkouts: the Agentbrain
worker and share ingress, the Agentweb daemon, and the Agentusage daemon.

Options:
  --check  Print the installation plan without changing the system
EOF
}

die() {
    printf 'Funk local services installer: %s\n' "$*" >&2
    exit 1
}

case "${1:-}" in
    "") ;;
    --check) check_only=1 ;;
    -h|--help) usage; exit 0 ;;
    *) usage >&2; exit 64 ;;
esac
[ "$#" -le 1 ] || { usage >&2; exit 64; }

agentbrain_root="$HOME/code/agentbrain"
agentweb_root="$HOME/code/agentweb"
agentusage_root="$HOME/code/agentusage"
agentdots_root="$HOME/code/agentdots"

# Each project owns its own installer and its own refusal rules for foreign
# files; Agentdots owns every fleet launch agent. Funk decides only that these
# services should be resident on this machine, and supplies the one fact none
# know for itself: which address this host answers on inside the tailnet.
tailnet_address() {
    command -v tailscale >/dev/null 2>&1 || return 1
    tailscale ip -4 2>/dev/null | head -n 1 | grep -E '^[0-9.]+$' || return 1
}

if [ "$check_only" -eq 1 ]; then
    cat <<'EOF'
Resident services from local checkouts. The checkouts install their commands;
Agentdots installs every fleet launch agent that runs them.
  ~/code/agentbrain/scripts/install.sh --install
  ~/code/agentweb/scripts/install.sh --install
  ~/code/agentusage/scripts/install.sh --install  # + cswap and codex-swap provider CLIs
  ~/code/agentdots/scripts/install-launchagents --install
      AGENTDOTS_INSTALL_SHARE_HOST=<tailscale ip -4>  # agentbrain.share, only when the tailnet is up
      AGENTDOTS_INSTALL_CONDUIT_SOCKET / _TOKEN_FILE  # Agentweb's socket, for Agentscrape
EOF
    exit 0
fi

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

[ -f "$agentbrain_root/scripts/install.sh" ] \
    || die "Agentbrain checkout not found: $agentbrain_root/scripts/install.sh is missing"
[ -f "$agentweb_root/scripts/install.sh" ] \
    || die "Agentweb checkout not found: $agentweb_root/scripts/install.sh is missing"
[ -f "$agentusage_root/scripts/install.sh" ] \
    || die "Agentusage checkout not found: $agentusage_root/scripts/install.sh is missing"
[ -x "$agentdots_root/scripts/install-launchagents" ] \
    || die "Agentdots checkout not found: $agentdots_root/scripts/install-launchagents is missing"

# The ingress is the only listener among these services, and Agentbrain refuses
# to expose one that nobody named an address for. A tailnet that is down at
# install time is not a reason to fail the run, and not a reason to withdraw an
# ingress either: an unset variable leaves an already-installed one alone.
# Agentweb brokers the browser sessions a human established, and Agentscrape —
# which Agentbrain's worker spawns for every fetch — asks it whether a site has
# one before navigating. Wiring the two together is Funk's business because
# neither project may assume the other is installed: Agentbrain passes these
# through without interpreting them, and unset simply means extraction proceeds
# without a session.
agentweb_state="${XDG_STATE_HOME:-$HOME/.local/state}/agentweb"
conduit_socket="$agentweb_state/runtime/agentweb.sock"
conduit_token_file="$agentweb_state/worker-token"

printf 'Installing Agentbrain.\n'
"$agentbrain_root/scripts/install.sh" --install

printf 'Installing Agentweb.\n'
"$agentweb_root/scripts/install.sh" --install

printf 'Installing Agentusage.\n'
"$agentusage_root/scripts/install.sh" --install

# The commands are installed; the services that run them are Agentdots', which
# owns every fleet launch agent. The wiring above stays here because it is a
# fact about this machine rather than about any one project — which address the
# tailnet handed out, and where Agentweb keeps the socket Agentscrape asks for
# a session on. Agentdots renders it; Funk decides it.
printf 'Installing the fleet services through Agentdots.\n'
if share_host=$(tailnet_address); then
    printf 'The share ingress binds to %s.\n' "$share_host"
    AGENTDOTS_INSTALL_SHARE_HOST="$share_host" \
        AGENTDOTS_INSTALL_CONDUIT_SOCKET="$conduit_socket" \
        AGENTDOTS_INSTALL_CONDUIT_TOKEN_FILE="$conduit_token_file" \
        "$agentdots_root/scripts/install-launchagents" --install
else
    printf 'No tailnet address, so the share ingress is left as it is.\n' >&2
    AGENTDOTS_INSTALL_CONDUIT_SOCKET="$conduit_socket" \
        AGENTDOTS_INSTALL_CONDUIT_TOKEN_FILE="$conduit_token_file" \
        "$agentdots_root/scripts/install-launchagents" --install
fi
