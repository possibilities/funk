#!/bin/bash

set -euo pipefail

case "${1:-}" in
    "") ;;
    -h|--help)
        printf 'Usage: funk verify-local-services\n\nShow owner-reported launchd status for Funk and the agent fleet.\n'
        exit 0
        ;;
    *)
        printf 'Usage: funk verify-local-services\n' >&2
        exit 64
        ;;
esac

# The owner manifests are authoritative. Funk reports only its own labels and
# asks AgentStart to report the fleet labels it installs; this avoids another
# stale copy of that manifest here.
status=0
"${FUNK_ROOT:?FUNK_ROOT is not set}/libexec/launchd-status" || status=1
agentstart_status="$HOME/code/agentstart/scripts/install-launchagents"
if [ ! -x "$agentstart_status" ]; then
    printf 'Agent fleet\n  FAIL  owner status command is missing: %s\n' "$agentstart_status" >&2
    status=1
else
    "$agentstart_status" --status || status=1
fi
exit "$status"
