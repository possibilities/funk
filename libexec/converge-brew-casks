#!/bin/bash

set -euo pipefail

die() {
    printf 'Funk cask installer: %s\n' "$*" >&2
    exit 1
}

find_brew() {
    if [ -n "${FUNK_BREW_BIN:-}" ] && [ -x "$FUNK_BREW_BIN" ]; then
        printf '%s\n' "$FUNK_BREW_BIN"
        return
    fi
    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return
    fi
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    return 1
}

usage() {
    cat <<'EOF'
Usage: converge-brew-casks [--install-only] CASK [...]

Install each cask when missing and upgrade it when present.

Options:
  --install-only  Install a missing cask, but leave an installed one alone.
                  For a cask that ships its own updater, Homebrew upgrading it
                  is not convergence but a second updater competing with the
                  first -- and Homebrew replaces a bundle without quitting the
                  app, so an application that is running when it happens keeps
                  serving code that is no longer on disk.
EOF
}

install_only=0
while [ "$#" -gt 0 ]; do
    case "$1" in
        --install-only)
            install_only=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            usage >&2
            exit 64
            ;;
        *)
            break
            ;;
    esac
    shift
done

[ "$#" -gt 0 ] || {
    usage >&2
    exit 64
}

script_dir=$(cd -P -- "$(dirname -- "$0")" && pwd)
release_quarantine="$script_dir/release-cask-quarantine"
repair_artifacts="$script_dir/repair-cask-artifacts"
[ -x "$release_quarantine" ] || die "missing helper: $release_quarantine"
[ -x "$repair_artifacts" ] || die "missing helper: $repair_artifacts"

brew_bin=$(find_brew) || die "Homebrew is not installed"
export FUNK_BREW_BIN="$brew_bin"
export HOMEBREW_NO_ASK=1

# Undo any aborted-upgrade Caskroom state before Homebrew tries to move an app.
"$repair_artifacts" "$@"

for cask in "$@"; do
    receipt_name=${cask##*/}
    if "$brew_bin" list --cask --versions "$receipt_name" >/dev/null 2>&1; then
        if [ "$install_only" -eq 1 ]; then
            printf 'Leaving installed Homebrew cask %s to its own updater.\n' "$cask"
        else
            printf 'Upgrading Homebrew cask %s.\n' "$cask"
            "$brew_bin" upgrade --cask --greedy --yes "$cask"
        fi
    else
        printf 'Installing Homebrew cask %s.\n' "$cask"
        "$brew_bin" install --cask --yes "$cask"
    fi

    installed=$("$brew_bin" list --cask --versions "$receipt_name" 2>/dev/null || true)
    [ -n "$installed" ] || die "Homebrew did not record cask as installed: $cask"
    "$release_quarantine" "$cask"
done
