#!/bin/bash

set -euo pipefail

die() {
    printf 'Funk agentsurface shims installer: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 0 ] || {
    printf 'Usage: install-agentsurface-shims\n' >&2
    exit 64
}

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

# Bare `claude`, `codex`, and `pi` become balanced launches: each shim execs
# `agentsurface open <harness> -- "$@"`, which asks agentusage for the
# account and wraps the real binary in the swap tool (agentsurface ADR
# 0003/0004). Managed launches carry AGENTSURFACE_LAUNCH=1 and fall through
# to the real binary, found by scanning PATH past the shim directory —
# that sentinel is what makes the composition non-recursive. The shim dir
# is prepended to PATH by Funk's .zshrc, guarded on its existence.
shim_dir="$HOME/.local/share/agentsurface/shims"

command -v agentsurface >/dev/null 2>&1 ||
    die "agentsurface is not on PATH; run ~/code/agentsurface/scripts/install.sh first"

mkdir -p "$shim_dir"

for harness in claude codex pi; do
    shim="$shim_dir/$harness"
    cat >"$shim" <<EOF
#!/usr/bin/env bash
# Funk-managed agentsurface shim: bare \`$harness\` balances across accounts.
# AGENTSURFACE_LAUNCH=1 (managed launch) or AGENTSURFACE_SHIM_BYPASS=1
# (manual escape) exec the real binary instead. Regenerate with
# \`funk install-agentsurface-shims\`; do not edit in place.
set -euo pipefail
shim_dir=\$(cd -- "\$(dirname -- "\${BASH_SOURCE[0]}")" && pwd -P)
find_real() {
    local IFS=':' dir
    for dir in \$PATH; do
        [ -n "\$dir" ] || continue
        [ -e "\$dir" ] && [ "\$dir" -ef "\$shim_dir" ] && continue
        if [ -x "\$dir/$harness" ]; then
            printf '%s/$harness\n' "\$dir"
            return 0
        fi
    done
    return 1
}
if [ -n "\${AGENTSURFACE_LAUNCH:-}" ] || [ -n "\${AGENTSURFACE_SHIM_BYPASS:-}" ]; then
    real=\$(find_real) || { printf 'agentsurface shim: no real $harness on PATH\n' >&2; exit 127; }
    exec "\$real" "\$@"
fi
exec agentsurface open $harness -- "\$@"
EOF
    chmod 0755 "$shim"
    printf 'Installed shim: %s\n' "$shim"
done

printf 'Shims ready. New shells pick them up via .zshrc; current shells need `exec zsh`.\n'
