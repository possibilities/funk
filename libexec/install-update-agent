#!/bin/bash

set -euo pipefail

label=io.arthack.funk.update
legacy_label=com.arthack.funk.update

die() {
    printf 'funk install-updater: %s\n' "$*" >&2
    exit 1
}

check_only=0
case "${1:-}" in
    "") ;;
    --check)
        [ "$#" -eq 1 ] || {
            printf 'Usage: funk install-updater [--check]\n' >&2
            exit 64
        }
        check_only=1
        ;;
    *)
        printf 'Usage: funk install-updater [--check]\n' >&2
        exit 64
        ;;
esac

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run this command as the target user, not root"

funk_root=${FUNK_ROOT:?FUNK_ROOT is not set}
template="$funk_root/launchd/$label.plist.in"
funk_executable="$funk_root/bin/funk"
agent_dir="$HOME/Library/LaunchAgents"
agent_path="$agent_dir/$label.plist"
log_dir="$HOME/Library/Logs/Funk"
log_path="$log_dir/update.log"

[ -f "$template" ] || die "template not found: $template"
[ -x "$funk_executable" ] || die "funk executable is missing or not executable: $funk_executable"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/funk-update-agent.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT
rendered="$tmpdir/$label.plist"

cp "$template" "$rendered"
/usr/bin/plutil -remove ProgramArguments.0 "$rendered"
/usr/bin/plutil -insert ProgramArguments.0 -string "$funk_executable" "$rendered"
/usr/bin/plutil -replace StandardOutPath -string "$log_path" "$rendered"
/usr/bin/plutil -replace StandardErrorPath -string "$log_path" "$rendered"
/usr/bin/plutil -lint "$rendered" >/dev/null

[ "$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$rendered")" = "$funk_executable" ] \
    || die "rendered updater executable is incorrect"
[ "$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:1' "$rendered")" = update ] \
    || die "rendered updater command is incorrect"
[ "$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:2' "$rendered")" = --notify ] \
    || die "rendered updater notification flag is incorrect"
if /usr/libexec/PlistBuddy -c 'Print :ProgramArguments:3' "$rendered" >/dev/null 2>&1; then
    die "rendered updater has an unexpected extra argument"
fi

if [ "$check_only" -eq 1 ]; then
    printf 'Update LaunchAgent renders and validates successfully.\n'
    exit 0
fi

mkdir -p "$agent_dir" "$log_dir"
"$funk_root/libexec/install-user-launchagent" \
    "$label" "$legacy_label" "$rendered" "$log_dir"

printf 'Installed %s (daily at 00:00, 06:00, 12:00, and 18:00 local time)\n' "$agent_path"
printf 'Logs append to %s\n' "$log_path"
