#!/bin/bash

set -euo pipefail

die() {
    printf 'Funk cask quarantine: %s\n' "$*" >&2
    exit 1
}

find_brew() {
    if [ -n "${FUNK_BREW_BIN:-}" ] && [ -x "$FUNK_BREW_BIN" ]; then
        printf '%s\n' "$FUNK_BREW_BIN"
        return
    fi
    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return
    fi
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    return 1
}

usage() {
    cat <<'EOF'
Usage: release-cask-quarantine [--brewfile FILE] [CASK ...]

Remove only com.apple.quarantine from installed .app artifacts declared by
the selected Homebrew casks.
EOF
}

brewfile=
casks=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --brewfile)
            [ "$#" -ge 2 ] || {
                usage >&2
                exit 64
            }
            brewfile="$2"
            shift
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        -*)
            usage >&2
            exit 64
            ;;
        *)
            casks+=("$1")
            ;;
    esac
    shift
done

brew_bin=$(find_brew) || die "Homebrew is not installed"
spctl_bin=${FUNK_SPCTL_BIN:-/usr/sbin/spctl}
[ -x "$spctl_bin" ] || die "Gatekeeper assessment tool is unavailable: $spctl_bin"

if [ -n "$brewfile" ]; then
    [ -f "$brewfile" ] || die "Brewfile not found: $brewfile"
    while IFS= read -r cask; do
        [ -n "$cask" ] && casks+=("$cask")
    done < <("$brew_bin" bundle list --file="$brewfile" --cask)
fi

if [ "${#casks[@]}" -eq 0 ]; then
    printf 'Funk cask quarantine: no casks selected\n'
    exit 0
fi

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/funk-cask-quarantine.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT
json="$tmpdir/casks.json"
targets="$tmpdir/targets"

"$brew_bin" info --cask --json=v2 "${casks[@]}" >"$json"
/usr/bin/jq -r '
  .casks[]
  | .artifacts[]
  | select(has("app"))
  | .target? // empty
' "$json" | LC_ALL=C sort -u >"$targets"

checked=0
while IFS= read -r target; do
    [ -n "$target" ] || continue
    # shellcheck disable=SC2088 # Match Homebrew's literal ~/ target form.
    case "$target" in
        "~/"*) target="$HOME/${target#~/}" ;;
    esac

    case "$target" in
        /*.app) ;;
        *) die "refusing non-app cask artifact target: $target" ;;
    esac
    case "$target" in
        *"/../"*|*"/./"*)
            die "refusing non-canonical cask artifact target: $target"
            ;;
    esac

    target_parent=$(cd -P -- "$(dirname -- "$target")" 2>/dev/null && pwd) \
        || die "app target parent is unavailable: $target"
    home_applications=$(
        cd -P -- "$HOME/Applications" 2>/dev/null && pwd
    ) || home_applications=
    if [ "$target_parent" != /Applications ] \
        && [ "$target_parent" != "$home_applications" ]; then
        die "refusing app target outside an approved Applications directory: $target"
    fi
    target="$target_parent/$(basename -- "$target")"

    [ -d "$target" ] || die "declared cask app target is missing: $target"
    [ ! -L "$target" ] || die "refusing symlinked cask app target: $target"

    "$spctl_bin" --assess --type execute "$target" >/dev/null 2>&1 \
        || die "Gatekeeper rejected declared cask app target: $target"
    /usr/bin/xattr -dr com.apple.quarantine "$target"
    remaining=$(
        /usr/bin/xattr -pr com.apple.quarantine "$target" 2>/dev/null || true
    )
    [ -z "$remaining" ] \
        || die "quarantine remains on files inside cask app target: $target"

    checked=$((checked + 1))
done <"$targets"

printf 'Funk cask quarantine: checked %d declared app bundle(s)\n' "$checked"
