#!/bin/bash

# Remove the retired periodic Google-auth probe without claiming similarly
# named jobs or definitions owned by anything else.

set -euo pipefail

die() {
    printf 'funk retire-gog-auth-agent: %s\n' "$*" >&2
    exit 1
}

[ "$#" -eq 0 ] || die 'this helper accepts no arguments'
[ "$(uname -s)" = Darwin ] || die 'macOS is required'
[ "$(id -u)" -ne 0 ] || die 'run this command as the target user, not root'

label=io.arthack.funk.ensure-gog-auth
legacy_label=com.arthack.funk.gog-authed
agent_dir="${FUNK_LAUNCHAGENTS_DIR:-$HOME/Library/LaunchAgents}"
log_dir="${FUNK_USER_LOG_DIR:-$HOME/Library/Logs/Funk}"
state_dir="${FUNK_STATE_DIR:-$HOME/.local/state/funk}"
launchctl_bin="${FUNK_LAUNCHCTL_BIN:-/bin/launchctl}"
current="$agent_dir/$label.plist"
legacy="$agent_dir/$legacy_label.plist"
domain="gui/$(id -u)"
helper="$HOME/code/funk/bin/.local/bin/gog-ensure-authed"
log="$log_dir/gog-authed.log"
alert="$state_dir/gog-ensure-authed.alert"

owned_current() {
    [ -f "$current" ] && [ ! -L "$current" ] \
        && [ "$(/usr/libexec/PlistBuddy -c 'Print :Label' "$current" 2>/dev/null || true)" = "$label" ] \
        && [ "$(/usr/libexec/PlistBuddy -c 'Print :FunkInstallerOwner' "$current" 2>/dev/null || true)" = "$label.v1" ]
}

owned_legacy() {
    [ -f "$legacy" ] && [ ! -L "$legacy" ] || return 1
    /usr/bin/python3 - "$legacy" "$legacy_label" "$helper" "$HOME" "$log" <<'PYTHON'
import plistlib
import sys

path, label, helper, home, log = sys.argv[1:]
with open(path, "rb") as handle:
    actual = plistlib.load(handle)
expected = {
    "Label": label,
    "ProgramArguments": [helper],
    "EnvironmentVariables": {"HOME": home},
    "RunAtLoad": True,
    "StartInterval": 900,
    "ProcessType": "Background",
    "StandardOutPath": log,
    "StandardErrorPath": log,
}
raise SystemExit(0 if actual == expected else 1)
PYTHON
}

for pair in "$label:$current:current" "$legacy_label:$legacy:legacy"; do
    job=${pair%%:*}
    rest=${pair#*:}
    plist=${rest%%:*}
    kind=${pair##*:}
    if [ -e "$plist" ] || [ -L "$plist" ]; then
        if [ "$kind" = current ]; then
            owned_current || die "refusing to remove an unowned LaunchAgent: $plist"
        else
            owned_legacy || die "refusing to remove an unowned legacy LaunchAgent: $plist"
        fi
    elif "$launchctl_bin" print "$domain/$job" >/dev/null 2>&1; then
        die "refusing to stop a loaded LaunchAgent without its owned plist: $domain/$job"
    fi
done

for job in "$label" "$legacy_label"; do
    "$launchctl_bin" print "$domain/$job" >/dev/null 2>&1 || continue
    "$launchctl_bin" bootout "$domain/$job" \
        || die "could not stop retired LaunchAgent: $domain/$job"
done

rm -f -- "$current" "$legacy"
for artifact in "$log" "$alert"; do
    if [ -L "$artifact" ]; then
        die "refusing to remove symlinked retired state: $artifact"
    fi
    [ ! -f "$artifact" ] || rm -- "$artifact"
done

printf 'Retired the periodic Google auth LaunchAgent.\n'
