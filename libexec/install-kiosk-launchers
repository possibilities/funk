#!/bin/bash

set -euo pipefail

die() {
    printf 'funk install-kiosk-launchers: %s\n' "$*" >&2
    exit 1
}

usage() {
    printf 'Usage: funk install-kiosk-launchers [--check]\n' >&2
}

check_only=0
case "${1:-}" in
    '') ;;
    --check) [ "$#" -eq 1 ] || { usage; exit 64; }; check_only=1 ;;
    *) usage; exit 64 ;;
esac

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run this command as the target user, not root"
[ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "HOME is not an existing directory"

funk_root=${FUNK_ROOT:?FUNK_ROOT is not set}
source_file="$funk_root/libexec/kiosk-launcher.m"
icon_source_dir="$funk_root/assets/kiosk-icons"
applications_dir=${FUNK_KIOSK_APPLICATIONS_DIR:-"$HOME/Applications"}
codesign_bin=/usr/bin/codesign
iconutil_bin=/usr/bin/iconutil
lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
sips_bin=/usr/bin/sips

case "$applications_dir" in
    /*) ;;
    *) die "applications directory must be an absolute path: $applications_dir" ;;
esac
[ -f "$source_file" ] || die "native kiosk launcher source is missing: $source_file"
[ -x "$codesign_bin" ] || die "Apple codesign is unavailable: $codesign_bin"
[ -x "$iconutil_bin" ] || die "Apple iconutil is unavailable: $iconutil_bin"
[ -x "$sips_bin" ] || die "Apple sips is unavailable: $sips_bin"
clang_bin=${FUNK_CLANG:-/usr/bin/clang}
[ -x "$clang_bin" ] || die "Apple clang is unavailable: $clang_bin"

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/funk-kiosk-launchers.XXXXXX")
lock_file=
lock_acquired=0
active_target=
active_backup=
active_incoming=
active_new_target=0
active_transaction=
active_owner_file=
launcher="$tmpdir/FunkKioskLauncher"

cleanup() {
    if [ -n "$active_backup" ] && [ -e "$active_backup" ]; then
        /bin/rm -rf "$active_target"
        /bin/mv "$active_backup" "$active_target" || true
    elif [ "$active_new_target" -eq 1 ] && [ -n "$active_target" ]; then
        /bin/rm -rf "$active_target"
    fi
    [ -z "$active_incoming" ] || /bin/rm -rf "$active_incoming"
    if [ -n "$active_transaction" ] && [ -d "$active_transaction" ] \
        && [ ! -L "$active_transaction" ] \
        && [ ! -e "$active_backup" ] && [ ! -e "$active_incoming" ] \
        && [ -f "$active_owner_file" ]; then
        /bin/rm "$active_owner_file"
        /bin/rmdir "$active_transaction" 2>/dev/null || true
    fi
    /bin/rm -rf "$tmpdir"
    if [ "$lock_acquired" -eq 1 ]; then
        /bin/rm -f "$lock_file"
    fi
}
trap cleanup EXIT

render_icon() {
    local source=$1 destination=$2 key=$3
    local iconset="$tmpdir/$key.iconset"
    local size scale pixels output

    [ -f "$source" ] || die "kiosk icon source is missing: $source"
    /usr/bin/install -d -m 0755 "$iconset"
    while IFS=' ' read -r size scale pixels; do
        [ "$scale" != - ] || scale=
        output="$iconset/icon_${size}x${size}${scale}.png"
        "$sips_bin" -s format png -z "$pixels" "$pixels" "$source" \
            --out "$output" >/dev/null \
            || die "could not render kiosk icon: $source"
    done <<'EOF'
16 - 16
16 @2x 32
32 - 32
32 @2x 64
128 - 128
128 @2x 256
256 - 256
256 @2x 512
512 - 512
512 @2x 1024
EOF
    "$iconutil_bin" -c icns "$iconset" -o "$destination" \
        || die "could not compile kiosk icon: $source"
    /bin/chmod 0644 "$destination"
}

render_bundle() {
    local name=$1 identifier=$2 url=$3 icon_name=$4
    local bundle="$tmpdir/$name.app"
    local contents="$bundle/Contents"
    local plist="$contents/Info.plist"

    /usr/bin/install -d -m 0755 "$bundle" "$contents" "$contents/MacOS" "$contents/Resources"
    /usr/bin/install -m 0755 "$launcher" "$contents/MacOS/FunkKioskLauncher"
    printf '%s\n' "$url" >"$contents/Resources/launcher-url"
    /bin/chmod 0644 "$contents/Resources/launcher-url"
    render_icon "$icon_source_dir/$icon_name.svg" \
        "$contents/Resources/AppIcon.icns" "$icon_name"

    /usr/bin/plutil -create xml1 "$plist"
    /usr/bin/plutil -insert CFBundleDevelopmentRegion -string en "$plist"
    /usr/bin/plutil -insert CFBundleDisplayName -string "$name" "$plist"
    /usr/bin/plutil -insert CFBundleExecutable -string FunkKioskLauncher "$plist"
    /usr/bin/plutil -insert CFBundleIdentifier -string "$identifier" "$plist"
    /usr/bin/plutil -insert CFBundleIconFile -string AppIcon "$plist"
    /usr/bin/plutil -insert CFBundleInfoDictionaryVersion -string 6.0 "$plist"
    /usr/bin/plutil -insert CFBundleName -string "$name" "$plist"
    /usr/bin/plutil -insert CFBundlePackageType -string APPL "$plist"
    /usr/bin/plutil -insert CFBundleShortVersionString -string 1.0 "$plist"
    /usr/bin/plutil -insert CFBundleVersion -string 1 "$plist"
    /usr/bin/plutil -insert LSMinimumSystemVersion -string 13.0 "$plist"
    /usr/bin/plutil -insert LSUIElement -bool true "$plist"
    /usr/bin/plutil -insert NSHighResolutionCapable -bool true "$plist"
    /bin/chmod 0644 "$plist"
    /usr/bin/plutil -lint "$plist" >/dev/null

    "$codesign_bin" --force --sign - --identifier "$identifier" "$bundle" \
        >/dev/null 2>&1 || die "could not sign rendered application: $name"
    /bin/chmod 0755 "$contents/_CodeSignature"
    /bin/chmod 0644 "$contents/_CodeSignature/CodeResources"
    "$codesign_bin" --verify --deep --strict "$bundle" >/dev/null 2>&1 \
        || die "rendered application has an invalid signature: $name"
}

"$clang_bin" \
    -std=c11 -Os -Wall -Wextra -Werror -fobjc-arc \
    -mmacosx-version-min=13.0 \
    -I "$funk_root/libexec" \
    -framework AppKit -framework Foundation -framework WebKit \
    "$source_file" -o "$launcher"

render_bundle 'AgentVoice Transcripts' com.arthack.funk.kiosk.agentvoice \
    https://agentvoice.localhost/ AgentVoice
render_bundle 'AgentVoice TEST Transcripts' com.arthack.funk.kiosk.agentvoice-test \
    https://agentvoice-test.localhost AgentVoiceTest
render_bundle 'AgentChats Transcripts' com.arthack.funk.kiosk.agentchats \
    https://agentchats.localhost/ AgentChats
render_bundle 'AgentHUD' com.arthack.funk.kiosk.agenthud \
    https://agenthud.localhost/ AgentHUD

if [ "$check_only" -eq 1 ]; then
    printf 'Kiosk launcher app bundles render and validate successfully.\n'
    exit 0
fi

[ ! -L "$applications_dir" ] \
    || die "refusing to install through a symlink: $applications_dir"
/bin/mkdir -p "$applications_dir"
lock_file="$applications_dir/.com.arthack.funk.kiosk-launchers.lock"
shlock_bin=${SHLOCK:-/usr/bin/shlock}
[ -x "$shlock_bin" ] || die "cannot serialize application installation because shlock is missing"
attempts=0
until "$shlock_bin" -f "$lock_file" -p "$$"; do
    attempts=$((attempts + 1))
    [ "$attempts" -lt 10 ] || die "another kiosk launcher installer is still running"
    sleep 1
done
lock_acquired=1

bundle_matches() {
    /usr/bin/diff -qr "$1" "$2" >/dev/null || return 1
    while IFS=' ' read -r expected_mode path; do
        [ "$(/usr/bin/stat -f '%Lp' "$2/$path" 2>/dev/null || true)" = "$expected_mode" ] \
            || return 1
    done <<'EOF'
755 .
755 Contents
755 Contents/MacOS
755 Contents/Resources
755 Contents/_CodeSignature
755 Contents/MacOS/FunkKioskLauncher
644 Contents/Resources/AppIcon.icns
644 Contents/Resources/launcher-url
644 Contents/Info.plist
644 Contents/_CodeSignature/CodeResources
EOF
}

recover_transaction() {
    local name=$1 identifier=$2 target=$3 transaction=$4
    local owner_file="$transaction/owner"
    local owner="funk-kiosk-launcher-transaction-v1:$identifier"
    local incoming="$transaction/incoming.app"
    local backup="$transaction/backup.app"
    local artifact_identifier unexpected

    [ -e "$transaction" ] || return 0
    [ -d "$transaction" ] && [ ! -L "$transaction" ] \
        || die "refusing invalid application transaction: $transaction"
    unexpected=$(
        /usr/bin/find "$transaction" -mindepth 1 -maxdepth 1 \
            ! -name owner ! -name incoming.app ! -name backup.app \
            -print -quit
    )
    [ -z "$unexpected" ] \
        || die "application transaction has an unexpected artifact: $unexpected"
    if { [ ! -f "$owner_file" ] || [ -L "$owner_file" ] \
        || [ "$(cat "$owner_file" 2>/dev/null || true)" != "$owner" ]; } \
        && [ ! -e "$incoming" ] && [ ! -e "$backup" ]; then
        [ ! -e "$owner_file" ] || /bin/rm "$owner_file"
        /bin/rmdir "$transaction" \
            || die "could not recover incomplete application transaction: $transaction"
        printf 'Recovered incomplete application transaction %s\n' "$transaction"
        return 0
    fi
    [ -f "$owner_file" ] && [ ! -L "$owner_file" ] \
        && [ "$(cat "$owner_file")" = "$owner" ] \
        || die "refusing foreign application transaction: $transaction"

    if [ -e "$backup" ]; then
        [ -d "$backup" ] && [ ! -L "$backup" ] \
            || die "application transaction has an invalid backup: $backup"
        artifact_identifier=$(
            /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
                "$backup/Contents/Info.plist" 2>/dev/null || true
        )
        [ "$artifact_identifier" = "$identifier" ] \
            || die "application transaction backup does not belong to $name: $backup"
        if [ -e "$target" ]; then
            artifact_identifier=$(
                /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
                    "$target/Contents/Info.plist" 2>/dev/null || true
            )
            [ "$artifact_identifier" = "$identifier" ] \
                || die "refusing to discard backup for unrelated application: $target"
            /bin/rm -rf "$backup"
        else
            /bin/mv "$backup" "$target" \
                || die "could not recover interrupted application backup: $target"
            printf 'Recovered interrupted application backup %s\n' "$target"
        fi
    fi
    [ ! -e "$incoming" ] || /bin/rm -rf "$incoming"
    /bin/rm "$owner_file"
    /bin/rmdir "$transaction" \
        || die "could not finish recovered application transaction: $transaction"
}

install_bundle() {
    local name=$1 identifier=$2
    local rendered="$tmpdir/$name.app"
    local target="$applications_dir/$name.app"
    local transaction="$applications_dir/.$name.app.funk-transaction"
    local owner_file="$transaction/owner"
    local owner="funk-kiosk-launcher-transaction-v1:$identifier"
    local incoming="$transaction/incoming.app"
    local backup="$transaction/backup.app"
    local existing_identifier

    case "$target" in
        "$applications_dir/AgentVoice Transcripts.app"|\
        "$applications_dir/AgentVoice TEST Transcripts.app"|\
        "$applications_dir/AgentChats Transcripts.app"|\
        "$applications_dir/AgentHUD.app") ;;
        *) die "refusing unexpected application target: $target" ;;
    esac
    recover_transaction "$name" "$identifier" "$target" "$transaction"
    [ ! -L "$target" ] || die "refusing to replace symlink: $target"
    if [ -e "$target" ]; then
        existing_identifier=$(
            /usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' \
                "$target/Contents/Info.plist" 2>/dev/null || true
        )
        [ "$existing_identifier" = "$identifier" ] \
            || die "refusing to replace unrelated application: $target"
        if bundle_matches "$rendered" "$target"; then
            printf 'Already installed %s\n' "$target"
            [ "${FUNK_SKIP_LAUNCHSERVICES_REGISTRATION:-0}" = 1 ] \
                || "$lsregister" -f "$target" >/dev/null 2>&1 || true
            return
        fi
    fi

    /bin/mkdir -m 0700 "$transaction" \
        || die "could not create application transaction: $transaction"
    printf '%s\n' "$owner" >"$owner_file"
    /bin/chmod 0600 "$owner_file"
    active_target=$target
    active_incoming=$incoming
    active_backup=$backup
    active_transaction=$transaction
    active_owner_file=$owner_file
    [ -e "$target" ] || active_new_target=1
    /bin/cp -Rp "$rendered" "$incoming"
    if [ -e "$target" ]; then
        /bin/mv "$target" "$backup" || die "could not back up application: $target"
    fi
    if ! /bin/mv "$incoming" "$target"; then
        [ ! -e "$backup" ] || /bin/mv "$backup" "$target" || true
        die "could not install application: $target"
    fi
    active_incoming=
    bundle_matches "$rendered" "$target" \
        || die "installed application did not match rendered bundle: $target"
    [ ! -e "$backup" ] || /bin/rm -rf "$backup"
    /bin/rm "$owner_file"
    /bin/rmdir "$transaction" \
        || die "could not finish application transaction: $transaction"
    active_backup=
    active_target=
    active_new_target=0
    active_transaction=
    active_owner_file=
    [ "${FUNK_SKIP_LAUNCHSERVICES_REGISTRATION:-0}" = 1 ] \
        || "$lsregister" -f "$target" >/dev/null 2>&1 \
        || printf 'Warning: could not register %s with Launch Services.\n' "$target" >&2
    printf 'Installed %s\n' "$target"
}

install_bundle 'AgentVoice Transcripts' com.arthack.funk.kiosk.agentvoice
install_bundle 'AgentVoice TEST Transcripts' com.arthack.funk.kiosk.agentvoice-test
install_bundle 'AgentChats Transcripts' com.arthack.funk.kiosk.agentchats
install_bundle 'AgentHUD' com.arthack.funk.kiosk.agenthud
