#!/bin/bash

set -euo pipefail

check_only=0
script_dir=$(cd -P -- "$(dirname -- "$0")" && pwd)

usage() {
    cat <<'EOF'
Usage: install-ai-tools [--check]

Install the AI desktop applications and command-line tools managed by Funk.

Options:
  --check  Print the installation plan without changing the system
EOF
}

die() {
    printf 'Funk AI tools installer: %s\n' "$*" >&2
    exit 1
}

find_brew() {
    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return
    fi
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    return 1
}

install_official() {
    local name="$1"
    local url="$2"
    local interpreter="$3"
    shift 3

    printf 'Installing %s with its official installer.\n' "$name"
    /usr/bin/curl -fsSL "$url" | "$interpreter" "$@"
}

# Pi's installer reads its prompts from /dev/tty instead of stdin, so redirecting
# input does not make it unattended: run from a terminal it stops on its
# install/reinstall menu and offers to append a PATH line to the shell profile
# that Funk's zsh package owns. Running it in its own session leaves it with no
# controlling terminal, which is exactly the condition its documented
# "No terminal detected; continuing without confirmation" path tests for.
# OpenCode's installer resolves its release through the unauthenticated GitHub
# API, which allows 60 requests an hour per address. Reinstalling a few times in
# an hour exhausts that, and the installer then exits with "Failed to fetch
# version information", failing the whole run over a transient external limit.
# Funk already installs and authenticates gh, whose limit is 5000 an hour, so
# resolve the tag here and hand it over. With a version supplied the installer
# verifies the release with a plain HTTP request and never calls the API.
install_opencode() {
    local repo=anomalyco/opencode
    local version

    printf 'Installing OpenCode with its official installer.\n'

    version=
    if command -v gh >/dev/null 2>&1; then
        version=$(
            gh release view --repo "$repo" --json tagName --jq '.tagName' \
                2>/dev/null
        ) || version=
    fi
    version=${version#v}

    if [ -n "$version" ]; then
        printf 'Resolved OpenCode %s with the authenticated GitHub CLI.\n' "$version"
        /usr/bin/curl -fsSL https://opencode.ai/install \
            | VERSION="$version" /bin/bash -s -- --no-modify-path
        return
    fi

    printf 'Could not resolve the latest OpenCode release with gh; letting the installer choose.\n' >&2
    /usr/bin/curl -fsSL https://opencode.ai/install \
        | /bin/bash -s -- --no-modify-path
}

run_without_controlling_terminal() {
    /usr/bin/perl -e '
        use POSIX ();
        my $pid = fork();
        die "fork failed: $!\n" unless defined $pid;
        if ($pid == 0) {
            POSIX::setsid();
            exec { $ARGV[0] } @ARGV or exit 127;
        }
        waitpid($pid, 0);
        exit($? >> 8);
    ' -- "$@"
}

configure_livekit_docs_mcp() {
    local livekit_docs_url="https://docs.livekit.io/mcp"

    printf 'Configuring the LiveKit documentation MCP server for Codex.\n'
    codex mcp remove livekit-docs >/dev/null 2>&1 || true
    codex mcp add --url "$livekit_docs_url" livekit-docs

    printf 'Configuring the LiveKit documentation MCP server for Claude Code.\n'
    claude mcp remove --scope user livekit-docs >/dev/null 2>&1 || true
    claude mcp add --scope user --transport http livekit-docs "$livekit_docs_url"

    printf 'Configuring the LiveKit documentation MCP server for OpenCode.\n'
    opencode mcp add livekit-docs --url "$livekit_docs_url"
}

configure_shadcn_mcp() {
    printf 'Configuring the shadcn registry MCP server for Codex.\n'
    codex mcp remove shadcn >/dev/null 2>&1 || true
    codex mcp add shadcn -- npx shadcn@latest mcp

    printf 'Configuring the shadcn registry MCP server for Claude Code.\n'
    claude mcp remove --scope user shadcn >/dev/null 2>&1 || true
    claude mcp add --scope user shadcn -- npx shadcn@latest mcp

    printf 'Configuring the shadcn registry MCP server for OpenCode.\n'
    opencode mcp add shadcn -- npx shadcn@latest mcp
}

migrate_gh_credentials() {
    local old_home
    local old_hosts
    local target_dir="$HOME/.config/gh"
    local target_hosts="$target_dir/hosts.yml"
    local target_group
    local staged_hosts

    old_home=$(
        /usr/bin/dscacheutil -q user -a name mike 2>/dev/null \
            | /usr/bin/awk '$1 == "dir:" { print $2; exit }'
    )
    if [ -z "$old_home" ]; then
        printf 'No old mike account found for GitHub CLI credential migration.\n'
        return
    fi
    old_hosts="$old_home/.config/gh/hosts.yml"

    if [ -e "$target_hosts" ] || [ -L "$target_hosts" ]; then
        printf 'Preserving existing GitHub CLI credentials at %s.\n' "$target_hosts"
        return
    fi
    if [ ! -f "$old_hosts" ]; then
        printf 'No old GitHub CLI host configuration found to migrate.\n'
        return
    fi

    mkdir -p "$target_dir"
    chmod 0700 "$target_dir"
    staged_hosts=$(mktemp "$target_dir/.hosts.yml.XXXXXX")
    target_group=$(id -gn)

    if [ -r "$old_hosts" ]; then
        /usr/bin/install -m 0600 "$old_hosts" "$staged_hosts"
    else
        printf 'Checking the protected old GitHub CLI configuration for a portable credential.\n'
        if ! /usr/bin/sudo /usr/bin/install -m 0600 \
            -o "$(id -un)" -g "$target_group" \
            "$old_hosts" "$staged_hosts"; then
            rm -f "$staged_hosts"
            die "could not stage the old GitHub CLI configuration"
        fi
    fi

    # Modern gh releases normally store tokens in the macOS keyring. Such a
    # token belongs to the old login keychain and cannot be migrated by copying
    # hosts.yml. Only adopt the file when it contains a portable token itself.
    if grep -Eq '^[[:space:]]*oauth_token:' "$staged_hosts"; then
        chmod 0600 "$staged_hosts"
        mv "$staged_hosts" "$target_hosts"
        printf 'Migrated portable GitHub CLI credentials to %s.\n' "$target_hosts"
    else
        rm -f "$staged_hosts"
        printf 'Old GitHub CLI authentication is keyring-backed; no portable credential was copied.\n'
    fi
}

case "${1:-}" in
    "")
        ;;
    --check)
        check_only=1
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
[ "$#" -le 1 ] || {
    usage >&2
    exit 64
}

if [ "$check_only" -eq 1 ]; then
    cat <<'EOF'
Desktop applications:
  brew install or upgrade --cask --greedy claude
  brew install or upgrade --cask --greedy chatgpt

Command-line tools:
  brew install or upgrade gh  # intentional duplicate of the Brewfile
  brew install or upgrade livekit-cli
  curl -fsSL https://claude.ai/install.sh | bash
  curl -fsSL https://chatgpt.com/codex/install.sh | CODEX_NON_INTERACTIVE=1 sh
  gh release view --repo anomalyco/opencode --json tagName  # avoids the anonymous API limit
  curl -fsSL https://opencode.ai/install | VERSION=<resolved> bash -s -- --no-modify-path
  curl -fsSL https://pi.dev/install.sh | sh  # in its own session, no controlling terminal
  brew install or upgrade zig  # AgentVoice native packaging needs 0.16 or newer
  npm install --global @native-sdk/cli@0.7  # AgentVoice refuses other lines

Desktop applications from local checkouts:
  bun run --cwd "$HOME/code/agentvoice" app:install  # AgentVoice owns packaging and launch

Agent documentation:
  codex mcp add --url https://docs.livekit.io/mcp livekit-docs
  claude mcp add --scope user --transport http livekit-docs https://docs.livekit.io/mcp
  opencode mcp add livekit-docs --url https://docs.livekit.io/mcp
  codex mcp add shadcn -- npx shadcn@latest mcp
  claude mcp add --scope user shadcn -- npx shadcn@latest mcp
  opencode mcp add shadcn -- npx shadcn@latest mcp
  lk docs overview
  native skills list

Agent skills:
EOF
    "$script_dir/install-orca" --check
    cat <<'EOF'
  npx --yes skills remove livekit-agents --global --yes  # when installed
  npx --yes skills add https://github.com/vercel-labs/skills --agent codex claude-code opencode pi --skill find-skills --global --yes
  npx --yes skills add https://github.com/anthropics/skills --agent codex claude-code opencode pi --skill frontend-design --global --yes
  npx --yes skills add https://github.com/vercel-labs/agent-skills --agent codex claude-code opencode pi --skill web-design-guidelines --global --yes
  npx --yes skills add https://github.com/vercel-labs/agent-skills --agent codex claude-code opencode pi --skill vercel-react-best-practices --global --yes
  npx --yes skills add https://github.com/vercel/ai --agent codex claude-code opencode pi --skill ai-sdk --global --yes
  npx --yes skills add https://github.com/vercel/ai-elements --agent codex claude-code opencode pi --skill ai-elements --global --yes
  npx --yes skills add https://github.com/shadcn/ui --agent codex claude-code opencode pi --skill shadcn --global --yes
  npx --yes skills add https://github.com/livekit/agent-skills --agent codex claude-code opencode pi --skill livekit-simulations --global --yes
  npx --yes skills add https://github.com/vercel-labs/native --agent codex claude-code opencode pi --skill native-sdk --global --yes
  npx --yes skills add "$HOME/code/arthack" --agent codex claude-code opencode pi --skill hack --global --yes
EOF
    exit 0
fi

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

art_hack_root="$HOME/code/arthack"
[ -f "$art_hack_root/hack/SKILL.md" ] \
    || die "Art Hack skill source is missing: $art_hack_root/hack/SKILL.md"
[ -f "$art_hack_root/hack/agents/openai.yaml" ] \
    || die "Art Hack skill manifest is missing: $art_hack_root/hack/agents/openai.yaml"

brew_bin=$(find_brew) || die "Homebrew is not installed"
brew_prefix=$("$brew_bin" --prefix)
brew_owner=$(stat -f '%Su' "$brew_prefix")
[ "$brew_owner" = "$(id -un)" ] \
    || die "Homebrew prefix $brew_prefix is owned by $brew_owner, not $(id -un)"

# Funk already owns these PATH entries in its Stow-managed zsh configuration.
# Supplying them here prevents vendor installers from appending equivalent lines
# to shell startup files during this run.
original_path=$PATH
export FUNK_BREW_BIN="$brew_bin"
export PATH="$HOME/.local/bin:$HOME/.opencode/bin:$brew_prefix/bin:/usr/bin:/bin:/usr/sbin:/sbin:$original_path"

install_or_upgrade_formula() {
    local formula="$1"

    if "$brew_bin" list --formula --versions "$formula" >/dev/null 2>&1; then
        "$brew_bin" upgrade --formula --yes "$formula"
    else
        "$brew_bin" install --formula --yes "$formula"
    fi
    "$brew_bin" list --formula --versions "$formula" >/dev/null \
        || die "Homebrew formula verification failed: $formula"
}

export HOMEBREW_NO_ASK=1

printf 'Installing or upgrading GitHub CLI with Homebrew (intentional duplicate of the Brewfile).\n'
install_or_upgrade_formula gh
migrate_gh_credentials

printf 'Installing or upgrading the LiveKit CLI for agent, simulation, and documentation workflows.\n'
install_or_upgrade_formula livekit-cli

printf 'Installing or upgrading AI desktop applications with their supported Homebrew casks.\n'
"$script_dir/converge-brew-casks" claude chatgpt

install_official "Claude Code" \
    https://claude.ai/install.sh \
    /bin/bash

printf 'Installing Codex CLI with its official installer.\n'
/usr/bin/curl -fsSL https://chatgpt.com/codex/install.sh \
    | CODEX_NON_INTERACTIVE=1 /bin/sh

install_opencode

# Pi requires Node.js 22.19 or newer. The main Funk installer initializes the
# pinned NVM default before reaching this script; load that default into this
# subprocess so Pi's official installer can use it.
nvm_script="$brew_prefix/opt/nvm/nvm.sh"
if [ -s "$nvm_script" ]; then
    export NVM_DIR="$HOME/.nvm"
    # shellcheck disable=SC1090
    source "$nvm_script" --no-use
    if nvm version default >/dev/null 2>&1; then
        nvm use --silent default
    fi
fi

printf 'Installing Pi with its official installer.\n'
/usr/bin/curl -fsSL https://pi.dev/install.sh \
    | run_without_controlling_terminal /bin/sh

# AgentVoice's native packaging refuses to build against a Zig older than 0.16,
# and the Brewfile alone cannot guarantee the toolchain is present in a session
# that only runs this script (intentional duplicate of the Brewfile, like gh).
printf 'Installing or upgrading Zig for Native SDK packaging (intentional duplicate of the Brewfile).\n'
install_or_upgrade_formula zig

command -v npm >/dev/null 2>&1 || die "npm is required to install the Native SDK CLI"

# AgentVoice's native packaging refuses any Native SDK CLI outside the 0.7 line,
# so pin the compatible line here instead of tracking latest.
native_sdk_version=0.7
printf 'Installing the Native SDK CLI %s and its version-matched agent helpers.\n' \
    "$native_sdk_version"
npm install --global "@native-sdk/cli@$native_sdk_version"

configure_livekit_docs_mcp

command -v npx >/dev/null 2>&1 || die "npx is required to install agent skills"

configure_shadcn_mcp

"$script_dir/install-orca"

if npx --yes skills list --global --json \
    | jq -e '.[] | select(.name == "livekit-agents")' >/dev/null; then
    printf 'Removing the no-longer-managed LiveKit agent-development skill.\n'
    npx --yes skills remove livekit-agents --global --yes
fi

printf 'Installing the global skill discovery helper.\n'
npx --yes skills add https://github.com/vercel-labs/skills \
    --agent codex claude-code opencode pi \
    --skill find-skills \
    --global --yes

printf 'Installing the globally managed design skills.\n'
npx --yes skills add https://github.com/anthropics/skills \
    --agent codex claude-code opencode pi \
    --skill frontend-design \
    --global --yes
npx --yes skills add https://github.com/vercel-labs/agent-skills \
    --agent codex claude-code opencode pi \
    --skill web-design-guidelines \
    --global --yes

printf 'Installing Vercel React engineering guidance.\n'
npx --yes skills add https://github.com/vercel-labs/agent-skills \
    --agent codex claude-code opencode pi \
    --skill vercel-react-best-practices \
    --global --yes

printf 'Installing the official Vercel AI SDK and AI Elements skills.\n'
npx --yes skills add https://github.com/vercel/ai \
    --agent codex claude-code opencode pi \
    --skill ai-sdk \
    --global --yes
npx --yes skills add https://github.com/vercel/ai-elements \
    --agent codex claude-code opencode pi \
    --skill ai-elements \
    --global --yes

printf 'Installing the official shadcn skill.\n'
npx --yes skills add https://github.com/shadcn/ui \
    --agent codex claude-code opencode pi \
    --skill shadcn \
    --global --yes

printf 'Installing the globally managed LiveKit simulation skill.\n'
npx --yes skills add https://github.com/livekit/agent-skills \
    --agent codex claude-code opencode pi \
    --skill livekit-simulations \
    --global --yes

printf 'Installing the Native SDK discovery skill.\n'
npx --yes skills add https://github.com/vercel-labs/native \
    --agent codex claude-code opencode pi \
    --skill native-sdk \
    --global --yes

printf 'Synchronizing the personal Hack agent skill.\n'
npx --yes skills add "$art_hack_root" \
    --agent codex claude-code opencode pi \
    --skill hack \
    --global --yes

printf 'Verifying the installed LiveKit and Native SDK agent documentation helpers.\n'
lk docs overview >/dev/null
native skills list >/dev/null

# The pinned Native SDK CLI and Zig above are AgentVoice's packaging
# prerequisites, so the desktop application is installed last. AgentVoice owns
# packaging, bundle replacement, launch, and readiness verification; Funk only
# invokes that contract. The scheduled updater deliberately stays skills-only.
agentvoice_app_status=0
"$script_dir/install-agentvoice-app" || agentvoice_app_status=$?
if [ "$agentvoice_app_status" -ne 0 ]; then
    printf 'Funk AI tools installer: AgentVoice desktop application install failed (exit %s). Fix the reported problem, then rerun ./install or libexec/install-agentvoice-app.\n' \
        "$agentvoice_app_status" >&2
    exit "$agentvoice_app_status"
fi
