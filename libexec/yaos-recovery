#!/bin/bash
# shellcheck disable=SC2154 # Variables come from the checked-in yaos-facts fragment.

set -euo pipefail

script_dir=$(cd -P -- "$(dirname -- "$0")" && pwd)
# shellcheck source=libexec/yaos-facts
. "$script_dir/yaos-facts"

worker_url=$yaos_worker_url
worker_name=$yaos_worker_name
r2_bucket=$yaos_r2_bucket
r2_binding=$yaos_r2_binding
upstream_url=$yaos_upstream_url
fork_url=$yaos_fork_url
carried_branch=$yaos_carried_branch
pinned_commit=$yaos_pinned_commit
plugin_version=$yaos_plugin_version
server_version=$yaos_server_version
server_schema=$yaos_server_schema
max_attachment_bytes=$yaos_max_attachment_bytes

mac_vault=${FUNK_YAOS_MAC_VAULT:-"$HOME/obsidian/work"}
checkout=${FUNK_YAOS_CHECKOUT:-"$HOME/src/yaos"}
curl_bin=${FUNK_YAOS_CURL_BIN:-curl}
jq_bin=${FUNK_YAOS_JQ_BIN:-jq}
check_only=0
failures=0

usage() {
    cat <<'EOF'
Usage: funk yaos-recovery [--check]

Print the secret-safe status and recovery handoff for this machine's YAOS
deployment. --check returns nonzero when the active Mac configuration or
public server capabilities are incomplete; the recovery guide is always
printed and never changes local, Cloudflare, or Android state.
EOF
}

case "${1:-}" in
    "") ;;
    --check) check_only=1 ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
[ "$#" -le 1 ] || {
    usage >&2
    exit 64
}

ready() {
    printf '  ready: %s\n' "$1"
}

needs_attention() {
    printf '  needs attention: %s\n' "$1"
    failures=$((failures + 1))
}

file_mode() {
    stat -f '%Lp' "$1" 2>/dev/null || stat -c '%a' "$1" 2>/dev/null
}

plugin_dir="$mac_vault/.obsidian/plugins/yaos"
plugin_manifest="$plugin_dir/manifest.json"
plugin_data="$plugin_dir/data.json"

printf '\nYAOS resurrection handoff\n\n'
printf 'Current readiness (read-only):\n'

if [ -d "$mac_vault" ]; then
    ready "greybird authoritative vault exists"
else
    needs_attention "restore greybird's authoritative vault before connecting another device"
fi

jq_available=0
if command -v "$jq_bin" >/dev/null 2>&1; then
    jq_available=1
else
    needs_attention "jq is unavailable, so plugin configuration cannot be checked safely"
fi

if [ -f "$plugin_manifest" ] && [ -f "$plugin_dir/main.js" ]; then
    if [ "$jq_available" -eq 1 ] \
        && "$jq_bin" -e --arg version "$plugin_version" \
            '.id == "yaos" and .version == $version' \
            "$plugin_manifest" >/dev/null 2>&1; then
        ready "YAOS plugin $plugin_version is installed"
    else
        needs_attention "YAOS plugin files are incomplete or not version $plugin_version"
    fi
else
    needs_attention "YAOS plugin files are missing from greybird's vault"
fi

if [ -f "$plugin_data" ] && [ "$jq_available" -eq 1 ]; then
    if "$jq_bin" -e 'type == "object"' "$plugin_data" >/dev/null 2>&1; then
        if "$jq_bin" -e --arg host "$worker_url" '.host == $host' \
            "$plugin_data" >/dev/null 2>&1; then
            ready "plugin host matches the deployed Worker"
        else
            needs_attention "plugin host does not match the deployed Worker"
        fi
        if "$jq_bin" -e '((.token // "") | type == "string" and length >= 16)' \
            "$plugin_data" >/dev/null 2>&1; then
            ready "plugin has a recovery-capable setup token (value withheld)"
        else
            needs_attention "plugin setup token is missing; recover it from backup or a surviving device"
        fi
        if "$jq_bin" -e '((.vaultId // "") | type == "string" and length > 0)' \
            "$plugin_data" >/dev/null 2>&1; then
            ready "plugin has a vault ID (value withheld)"
        else
            needs_attention "plugin vault ID is missing; recover it without printing or committing it"
        fi
        if "$jq_bin" -e '.deviceName == "greybird"' \
            "$plugin_data" >/dev/null 2>&1; then
            ready "plugin device identity is greybird"
        else
            needs_attention "plugin device identity is not greybird"
        fi
        if "$jq_bin" -e '.enableAttachmentSync == true' \
            "$plugin_data" >/dev/null 2>&1; then
            ready "attachment sync is enabled on greybird"
        else
            needs_attention "attachment sync is disabled or absent on greybird"
        fi
    else
        needs_attention "plugin data.json is not valid JSON"
    fi

    mode=$(file_mode "$plugin_data" || true)
    if [ "$mode" = 600 ]; then
        ready "plugin data.json permissions are 0600"
    else
        needs_attention "plugin data.json permissions must be 0600"
    fi
elif [ ! -f "$plugin_data" ]; then
    needs_attention "plugin data.json is missing; recover connection fields from backup or a surviving device"
fi

if [ -d "$checkout/.git" ] && command -v git >/dev/null 2>&1; then
    checkout_commit=$(git -C "$checkout" rev-parse HEAD 2>/dev/null || true)
    checkout_origin=$(git -C "$checkout" remote get-url origin 2>/dev/null || true)
    checkout_status=$(git -C "$checkout" status --porcelain --untracked-files=normal 2>/dev/null || true)
    if [ "$checkout_commit" = "$pinned_commit" ] \
        && [ "$checkout_origin" = "$fork_url" ] \
        && [ -z "$checkout_status" ]; then
        ready "checkout matches the pinned public fork commit"
    else
        printf '  note: checkout differs from the deployed source identity\n'
    fi
else
    printf '  note: checkout is absent; funk install-yaos recreates the pinned source and overlay\n'
fi

plugin_links_ready=1
for artifact in main.js manifest.json styles.css; do
    [ -L "$plugin_dir/$artifact" ] \
        && [ -e "$checkout/$artifact" ] \
        && [ "$plugin_dir/$artifact" -ef "$checkout/$artifact" ] \
        || plugin_links_ready=0
done
if [ "$plugin_links_ready" -eq 1 ]; then
    ready "plugin public artifacts are linked to the Funk-managed checkout"
else
    needs_attention "plugin public artifacts are not linked to the Funk-managed checkout; run funk install-yaos"
fi

capabilities=""
if command -v "$curl_bin" >/dev/null 2>&1; then
    capabilities=$("$curl_bin" -fsS --max-time 8 \
        "$worker_url/api/capabilities" 2>/dev/null || true)
fi
if [ -n "$capabilities" ] && [ "$jq_available" -eq 1 ]; then
    if printf '%s\n' "$capabilities" | "$jq_bin" -e \
        --arg version "$server_version" \
        --argjson schema "$server_schema" \
        --argjson max_bytes "$max_attachment_bytes" \
        '.claimed == true and
         .attachments == true and
         .snapshots == true and
         .socketTicketAuth == true and
         .serverVersion == $version and
         .schemaVersion == $schema and
         .maxBlobUploadBytes == $max_bytes' >/dev/null 2>&1; then
        ready "Worker is claimed and advertises the pinned server, schema, auth, R2, and size capabilities"
    else
        needs_attention "Worker capabilities differ from the pinned deployment facts"
    fi
else
    needs_attention "Worker capabilities could not be verified; retry when the public endpoint is reachable"
fi

cat <<EOF

Deployment facts (safe to retain):
  Worker: $worker_name at $worker_url
  R2: bucket $r2_bucket bound as $r2_binding
  Upstream: $upstream_url
  Public fork: $fork_url
  Carried branch: $carried_branch
  Deployed source: fork commit $pinned_commit
  Plugin/server/schema: $plugin_version / $server_version / $server_schema
  Attachments and snapshots: enabled through R2; attachment limit 10 MiB
  Authority: greybird at ~/obsidian/work
  Secondary: smolbird at /sdcard/Documents/obsidian/work
  Network: Tailscale reaches devices; YAOS sync uses the public authenticated Worker

Recovery order:
  1. Restore ~/obsidian/work from backup onto greybird first. Greybird is truth;
     do not use smolbird or R2 snapshots to overwrite it implicitly.
  2. Restore or install YAOS plugin $plugin_version, compatible with the pinned
     server. Do not open a second writer until the primary vault is sound.
  3. Recover host, token, and vaultId from a backed-up data.json or a surviving
     configured device. The Worker retains only the token hash, so Cloudflare
     cannot reveal the token. Never print it, pass it on a command line, or
     commit it. Do not copy smolbird's whole data.json onto greybird: merge only
     connection fields or use YAOS setup, preserving greybird's device identity
     and regenerated disk/cache state. Never claim an already claimed server.
  4. Probe $worker_url/api/capabilities and require claimed=true,
     attachments=true, snapshots=true, socketTicketAuth=true,
     serverVersion=$server_version, schemaVersion=$server_schema, and
     maxBlobUploadBytes=$max_attachment_bytes.
  5. Before YAOS writes on smolbird, confirm the Syncthing folder root's
     .stignore contains the exact line /work. This prevents dual writers.
  6. Connect one secondary device at a time, with smolbird subordinate to the
     restored greybird vault. Enable attachment sync explicitly on each device.
  7. Verify note hashes, then create, edit, and delete a disposable note from
     the editor. Confirm propagation both ways without making smolbird the
     source of truth. Remove verification files and resolve any conflicts to
     greybird's content.
  8. Treat R2 snapshots as recovery support, not authority to trample greybird.

Guarded Cloudflare reconstruction (does not run automatically):
  funk install-yaos
  funk install-yaos --check
  # The installer recreates $fork_url at the pinned $carried_branch commit,
  # builds the plugin, and links only its public artifacts. It never reads or
  # replaces the live plugin data.json.
  cd ~/src/yaos/server
  npm ci
  npm exec -- wrangler whoami
  npm exec -- wrangler r2 bucket list
  # Create bucket '$r2_bucket' only if the list proves it is absent:
  npm exec -- wrangler r2 bucket create $r2_bucket
  # Inspect the existing Worker/deployments and server/wrangler.toml first.
  # It must name Worker '$worker_name' and bind '$r2_bucket' as '$r2_binding'.
  npm exec -- wrangler deployments list --name $worker_name
  # Deploy only after confirming the account, existing state, pinned commit,
  # Durable Object migrations, and R2 binding; deployment is intentionally manual:
  npm exec -- wrangler deploy

Guarded smolbird checks (read-only until an agent has inspected the results):
  adb devices -l
  export FUNK_SMOLBIRD_ADB_SERIAL='replace-with-serial-from-adb-devices'
  adb -s "\$FUNK_SMOLBIRD_ADB_SERIAL" shell \
    'grep -Fx /work /sdcard/Documents/obsidian/.stignore'
  # If missing, add /work through Syncthing's supported ignore editor before
  # connecting YAOS. Do not copy or delete the Android vault automatically.

Run 'funk yaos-recovery --check' for a readiness exit code. Funk deliberately
stores no token, vaultId, plugin data.json, Cloudflare account identity, R2
objects or snapshots, Android configuration, or live tailnet identity.
EOF

if [ "$check_only" -eq 1 ] && [ "$failures" -ne 0 ]; then
    exit 1
fi
