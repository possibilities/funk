#!/bin/bash
# shellcheck disable=SC2154 # Variables come from the checked-in yaos-facts fragment.

set -euo pipefail

die() {
    printf 'funk install-yaos: %s\n' "$*" >&2
    exit 1
}

note() {
    printf 'funk install-yaos: %s\n' "$*"
}

usage() {
    cat <<'EOF'
Usage: funk install-yaos [--check]

Converge Funk's pinned public YAOS fork checkout, build the plugin, and link
only its public artifacts into the authoritative Obsidian vault.
Existing data.json state is never read, replaced, linked, or removed.
EOF
}

check_only=0
case "${1:-}" in
    "") ;;
    --check) check_only=1 ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
[ "$#" -le 1 ] || {
    usage >&2
    exit 64
}

[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"
[ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "HOME is not an existing directory"

script_dir=$(cd -P -- "$(dirname -- "$0")" && pwd)
# shellcheck source=libexec/yaos-facts
. "$script_dir/yaos-facts"

# ShellCheck cannot infer assignments from this deliberately non-executable facts fragment.
# shellcheck disable=SC2154
remote=${FUNK_YAOS_FORK_URL:-$yaos_fork_url}
carried_branch=${FUNK_YAOS_CARRIED_BRANCH:-$yaos_carried_branch}
# shellcheck disable=SC2154
pinned_commit=${FUNK_YAOS_PINNED_COMMIT:-$yaos_pinned_commit}
checkout=${FUNK_YAOS_CHECKOUT:-$HOME/src/yaos}
vault=${FUNK_YAOS_MAC_VAULT:-$HOME/obsidian/work}
plugin_dir="$vault/.obsidian/plugins/yaos"
npm_bin=${FUNK_YAOS_NPM_BIN:-npm}
plugin_version=$yaos_plugin_version

command -v git >/dev/null 2>&1 || die "git is required"
command -v shasum >/dev/null 2>&1 || die "shasum is required"

if [ ! -d "$checkout/.git" ]; then
    [ "$check_only" -eq 0 ] || die "checkout is missing: $checkout"
    [ ! -e "$checkout" ] || die "$checkout exists but is not a Git checkout"
    mkdir -p "$(dirname -- "$checkout")"
    git clone --filter=blob:none "$remote" "$checkout" \
        || die "cannot clone public fork $remote"
    git -C "$checkout" switch --detach "$pinned_commit" \
        || die "cannot select pinned commit $pinned_commit"
    note "cloned pinned YAOS fork into $checkout"
fi

origin=$(git -C "$checkout" remote get-url origin 2>/dev/null || true)
[ "$origin" = "$remote" ] \
    || die "$checkout origin is '$origin', expected '$remote'"
checkout_commit=$(git -C "$checkout" rev-parse HEAD 2>/dev/null || true)
if [ -n "$(git -C "$checkout" status --porcelain --untracked-files=normal)" ]; then
    die "$checkout has local changes; refusing to replace carried fork state"
fi

carried_ref="refs/remotes/origin/$carried_branch"
if ! git -C "$checkout" show-ref --verify --quiet "$carried_ref" \
    || ! git -C "$checkout" merge-base --is-ancestor "$pinned_commit" "$carried_ref"; then
    [ "$check_only" -eq 0 ] \
        || die "pinned commit $pinned_commit is not present on origin/$carried_branch"
    git -C "$checkout" fetch origin "$carried_branch:$carried_ref" \
        || die "cannot fetch carried branch $carried_branch from $remote"
    git -C "$checkout" merge-base --is-ancestor "$pinned_commit" "$carried_ref" \
        || die "pinned commit $pinned_commit is not carried by origin/$carried_branch"
fi

if [ "$checkout_commit" != "$pinned_commit" ]; then
    [ "$check_only" -eq 0 ] \
        || die "$checkout is at ${checkout_commit:-an unknown commit}, expected $pinned_commit"
    git -C "$checkout" switch --detach "$pinned_commit" \
        || die "cannot select pinned fork commit $pinned_commit"
    note "selected pinned YAOS fork commit $pinned_commit"
fi

artifact_ready=1
for artifact in main.js manifest.json styles.css; do
    [ -f "$checkout/$artifact" ] || artifact_ready=0
done

links_ready=1
for artifact in main.js manifest.json styles.css; do
    target="$plugin_dir/$artifact"
    [ -L "$target" ] && [ "$target" -ef "$checkout/$artifact" ] || links_ready=0
done

if [ "$check_only" -eq 1 ]; then
    [ "$artifact_ready" -eq 1 ] || die "plugin build artifacts are incomplete in $checkout"
    [ "$links_ready" -eq 1 ] || die "plugin artifacts are not linked from $plugin_dir to $checkout"
    note "pinned fork checkout, build, and plugin links are current"
    exit 0
fi

command -v "$npm_bin" >/dev/null 2>&1 || [ -x "$npm_bin" ] \
    || die "npm is required"
lock_hash=$(shasum -a 256 "$checkout/package-lock.json" | awk '{print $1}')
dep_marker="$checkout/node_modules/.funk-yaos-package-lock.sha256"
installed_lock_hash=$(cat "$dep_marker" 2>/dev/null || true)
if [ "$installed_lock_hash" != "$lock_hash" ]; then
    "$npm_bin" --prefix "$checkout" ci
    printf '%s\n' "$lock_hash" >"$dep_marker"
fi
"$npm_bin" --prefix "$checkout" run build
(
    cd "$checkout"
    node scripts/guard-production-bundles.mjs
)

for artifact in main.js manifest.json styles.css; do
    [ -f "$checkout/$artifact" ] || die "build did not produce $checkout/$artifact"
done

mkdir -p "$plugin_dir"

for artifact in main.js manifest.json styles.css; do
    target="$plugin_dir/$artifact"
    [ ! -d "$target" ] || die "refusing to replace directory: $target"
    temporary="$plugin_dir/.${artifact}.funk.$$"
    rm -f "$temporary"
    ln -s "$checkout/$artifact" "$temporary"
    mv -f "$temporary" "$target"
done

note "linked YAOS $plugin_version from $checkout into $plugin_dir"
note "reload Obsidian to load the rebuilt plugin; data.json was left untouched"
