#!/bin/bash

set -uo pipefail

log() {
    printf '[funk update] %s %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"
}

find_brew() {
    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return
    fi

    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done

    return 1
}

notify=0
case "${1:-}" in
    "")
        ;;
    --notify)
        [ "$#" -eq 1 ] || {
            printf 'Usage: funk update [--notify]\n' >&2
            exit 64
        }
        notify=1
        ;;
    *)
        printf 'Usage: funk update [--notify]\n' >&2
        exit 64
        ;;
esac

funk_root=${FUNK_ROOT:?FUNK_ROOT is not set}
brewfile="$funk_root/Brewfile"
orca_installer="$funk_root/libexec/install-orca"
brewfile_installer="$funk_root/libexec/converge-brewfile"
unattendable_lister="$funk_root/libexec/list-unattendable-casks"
cask_dir_lister="$funk_root/libexec/repair-cask-user-dirs"
code_skills_installer="$funk_root/libexec/install-code-skills"

if [ ! -f "$brewfile" ]; then
    log "FAILED: Brewfile not found at $brewfile" >&2
    exit 66
fi
[ -x "$orca_installer" ] || {
    log "FAILED: Orca installer not found at $orca_installer" >&2
    exit 66
}
[ -x "$brewfile_installer" ] || {
    log "FAILED: Brewfile installer not found at $brewfile_installer" >&2
    exit 66
}
[ -x "$unattendable_lister" ] || {
    log "FAILED: cask triage helper not found at $unattendable_lister" >&2
    exit 66
}
[ -x "$cask_dir_lister" ] || {
    log "FAILED: cask user-dir helper not found at $cask_dir_lister" >&2
    exit 66
}
[ -x "$code_skills_installer" ] || {
    log "FAILED: project skill installer not found at $code_skills_installer" >&2
    exit 66
}

if ! brew_bin=$(find_brew); then
    log "FAILED: Homebrew is not installed" >&2
    exit 127
fi

brew_prefix=$("$brew_bin" --prefix)
original_path=$PATH
export FUNK_BREW_BIN="$brew_bin"
export PATH="$HOME/.local/bin:$brew_prefix/bin:/usr/bin:/bin:/usr/sbin:/sbin:$original_path"
export HOMEBREW_NO_ASK=1

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/funk-update.XXXXXX")
trap 'rm -rf "$tmpdir"' EXIT
before="$tmpdir/before"
after="$tmpdir/after"
changes="$tmpdir/changes"

snapshot_versions() {
    local destination="$1"
    local kind
    local name
    local output
    local version
    local label
    local orca_plist
    local lock_file="$HOME/.agents/.skill-lock.json"

    : >"$destination"
    for kind in formula cask; do
        while IFS= read -r name; do
            [ -n "$name" ] || continue
            output=$("$brew_bin" list --"$kind" --versions "$name" 2>/dev/null || true)
            [ -n "$output" ] || continue
            version=${output#* }
            label=${name##*/}
            printf 'brew:%s:%s\t%s\t%s\n' "$kind" "$name" "$label" "$version" \
                >>"$destination"
        done < <("$brew_bin" bundle list --file="$brewfile" --"$kind" 2>/dev/null || true)
    done

    # Orca updates itself, so Homebrew's receipt stops describing what is
    # actually installed the first time the app's own updater applies a
    # release. The bundle is the only honest source, and reading it also keeps
    # the running-copy check below meaningful no matter which updater moved it.
    orca_plist=${FUNK_ORCA_INFO_PLIST:-/Applications/Orca.app/Contents/Info.plist}
    if [ -f "$orca_plist" ]; then
        version=$(
            /usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' \
                "$orca_plist" 2>/dev/null || true
        )
        if [ -n "$version" ]; then
            printf 'app:orca\tOrca\t%s\n' "$version" >>"$destination"
        fi
    fi

    if [ -f "$lock_file" ]; then
        for name in orca-cli orchestration computer-use; do
            version=$(
                /usr/bin/jq -r --arg name "$name" \
                    '.skills[$name].skillFolderHash // empty' \
                    "$lock_file" 2>/dev/null || true
            )
            [ -n "$version" ] || continue
            printf 'skill:%s\t%s skill\t%s\n' "$name" "$name" "$version" \
                >>"$destination"
        done
    fi

    LC_ALL=C sort -o "$destination" "$destination"
}

collect_changes() {
    local key
    local label
    local new_version
    local old_version
    local old_short
    local new_short

    : >"$changes"
    while IFS=$'\t' read -r key label new_version; do
        [ -n "$key" ] || continue
        old_version=$(
            /usr/bin/awk -F '\t' -v wanted="$key" \
                '$1 == wanted { print $3; exit }' "$before"
        )
        [ "$old_version" != "$new_version" ] || continue

        case "$key" in
            skill:*)
                old_short=${old_version:0:8}
                new_short=${new_version:0:8}
                if [ -n "$old_version" ]; then
                    printf '%s rev %s → %s\n' "$label" "$old_short" "$new_short" \
                        >>"$changes"
                else
                    printf '%s installed @ rev %s\n' "$label" "$new_short" \
                        >>"$changes"
                fi
                ;;
            *)
                if [ -n "$old_version" ]; then
                    printf '%s %s → %s\n' "$label" "$old_version" "$new_version" \
                        >>"$changes"
                else
                    printf '%s installed @ %s\n' "$label" "$new_version" \
                        >>"$changes"
                fi
                ;;
        esac
    done <"$after"
}

send_notification() {
    local title="$1"
    local message="$2"
    local group="${3:-com.arthack.funk.update}"
    local notifier
    local notifier_app
    local lsregister

    if [ -n "${FUNK_TERMINAL_NOTIFIER_BIN:-}" ] \
        && [ -x "$FUNK_TERMINAL_NOTIFIER_BIN" ]; then
        notifier="$FUNK_TERMINAL_NOTIFIER_BIN"
    elif command -v terminal-notifier >/dev/null 2>&1; then
        notifier=$(command -v terminal-notifier)
    elif [ -x "$brew_prefix/bin/terminal-notifier" ]; then
        notifier="$brew_prefix/bin/terminal-notifier"
    else
        log "FAILED: terminal-notifier is unavailable" >&2
        return 1
    fi

    notifier_app="$brew_prefix/opt/terminal-notifier/terminal-notifier.app"
    lsregister=/System/Library/Frameworks/CoreServices.framework/Frameworks/LaunchServices.framework/Support/lsregister
    if [ -d "$notifier_app" ] && [ -x "$lsregister" ]; then
        "$lsregister" -f "$notifier_app" >/dev/null 2>&1 \
            || log "warning: could not register terminal-notifier with Launch Services"
    fi

    "$notifier" \
        -title "$title" \
        -message "$message" \
        -group "$group"
}

# Funk no longer upgrades Orca -- the app's own updater does, and it applies on
# quit, so the running copy is normally the one on disk. This stays as the
# tripwire for when that is not true: whatever replaced the bundle, a running
# Orca goes on serving code that is no longer there, and the first lazily
# loaded pane fails on a chunk it can no longer resolve. Nothing else would say
# so on a machine where Orca is always open. A dedicated group keeps the prompt
# from being buried in the general "Updated: ..." summary.
orca_restart_notice() {
    local version
    local running_processes

    version=$(
        /usr/bin/awk '$1 == "Orca" { print $NF; exit }' "$changes"
    )
    [ -n "$version" ] || return 0
    # Only a running Orca needs restarting; a stopped one picks the new bundle
    # up on its next launch, and nagging about that would be noise. `pgrep -x`
    # does not match this bundle on macOS, and matching the name alone would
    # also catch the Helper processes, so compare the executable path exactly.
    #
    # Deliberately not a pipeline: `grep -q` exits on its first match, which
    # SIGPIPEs `ps`, and under this script's `pipefail` that reads as a failed
    # pipeline even though the match succeeded -- silently skipping the very
    # notification this exists to send.
    running_processes=$(/bin/ps -axo comm= || true)
    /usr/bin/grep -qxF \
        "${FUNK_ORCA_BINARY:-/Applications/Orca.app/Contents/MacOS/Orca}" \
        <<<"$running_processes" || return 0
    printf 'Orca %s is installed; the running copy is still the old one.\n' \
        "$version"
}

snapshot_versions "$before"

# A pkg cask, a cask whose removal steps run a privileged script, and an
# application still owned by another local account all need administrator
# authentication. This LaunchAgent has no terminal, so attempting one fails the
# whole run. Leave them to ./install and report them instead of failing here.
#
# A cask installed under a previous account fails the same way for a different
# reason: Homebrew recorded that account's user directories, so the upgrade
# hunts for the old version's artifacts in a home this account cannot read and
# reports only that a source file "is not there". One such cask failed every
# scheduled run for a day, which also meant nothing after the Brewfile step
# ran at all. Repairing it is a reinstall, which is not something an unattended
# run should attempt, so triage it here and leave the repair to ./install.
skipped_casks=$(
    {
        "$unattendable_lister" --brewfile "$brewfile" 2>/dev/null || true
        "$cask_dir_lister" --list --brewfile "$brewfile" 2>/dev/null || true
    } | LC_ALL=C sort -u
)
skipped_summary=
if [ -n "$skipped_casks" ]; then
    export HOMEBREW_BUNDLE_CASK_SKIP="$skipped_casks"
    skipped_summary=$(
        printf '%s\n' "$skipped_casks" \
            | /usr/bin/awk 'NF { list = list ? list ", " $0 : $0 } END { print list }'
    )
    log "skipping casks that cannot converge unattended: $skipped_summary"
fi

status=0
log "starting: $brew_bin bundle install --upgrade --file=$brewfile"
"$brewfile_installer" || status=$?
if [ "$status" -eq 0 ]; then
    "$orca_installer" || status=$?
fi
# Each agent CLI's runbook now ships as a skill inside its own checkout, and a
# stale runbook misleads a session as badly as a stale binary does. Refreshing
# them reads local directories and rewrites skill files: no downloads, no
# elevation, no application restarts. That is exactly the kind of work this
# six-hour path is for, so the runbooks track the checkouts without waiting for
# the next ./install.
if [ "$status" -eq 0 ]; then
    "$code_skills_installer" || status=$?
fi

snapshot_versions "$after"
collect_changes

if [ -s "$changes" ]; then
    change_summary=$(
        /usr/bin/awk '
          NR == 1 { summary = $0; next }
          { summary = summary "; " $0 }
          END { print summary }
        ' "$changes"
    )
    log "changed: $change_summary"
else
    change_summary=
    log "no version changes"
fi

if [ "$status" -eq 0 ]; then
    log "complete"
else
    log "FAILED with exit status $status" >&2
fi

if [ "$notify" -eq 1 ]; then
    if [ "$status" -eq 0 ]; then
        if [ -n "$change_summary" ]; then
            notification_body="Updated: $change_summary"
        else
            notification_body="Installer ran; no updates."
        fi
        if [ -n "$skipped_summary" ]; then
            notification_body="$notification_body Needs ./install: $skipped_summary."
        fi
        send_notification "Funk Update" "$notification_body" || status=1
        orca_restart=$(orca_restart_notice)
        if [ -n "$orca_restart" ]; then
            log "Orca was upgraded while running; restart is pending"
            send_notification "Restart Orca" \
                "$orca_restart Restart it when you are ready." \
                com.arthack.funk.orca-restart || true
        fi
    else
        if [ -n "$change_summary" ]; then
            notification_body="Installer failed after updating: $change_summary. See update.log."
        else
            notification_body="Installer failed; no updates completed. See update.log."
        fi
        send_notification "Funk Update Failed" "$notification_body" || true
    fi
fi

exit "$status"
