#!/bin/bash

# Initialize a new Git repository (via ginit), create a matching GitHub
# repository, and push the initial commit. New repositories are private unless
# --public is given. On an existing repository, --public and --no-public ensure
# public and private visibility respectively; without either flag, visibility
# is left alone. With no arguments, the current directory must be directly
# inside ~/code. With a project name, create and enter ~/code/<name>; any
# remaining arguments go to gh repo create.

set -euo pipefail

visibility=--private
requested_visibility=
args=()
for arg in "$@"; do
    case "$arg" in
        --public)
            visibility=--public
            requested_visibility=public
            ;;
        --no-public)
            visibility=--private
            requested_visibility=private
            ;;
        *) args+=("$arg") ;;
    esac
done
if [ "${#args[@]}" -gt 0 ]; then
    set -- "${args[@]}"
else
    # Bash 3.2 treats an empty array expansion as an unbound variable when
    # nounset is enabled, even when the array was explicitly initialized.
    set --
fi

if ! code_dir=$(cd -P -- "$HOME/code" 2>/dev/null && pwd); then
    printf 'ghinit: %s does not exist\n' "$HOME/code" >&2
    exit 1
fi

if [ "$#" -gt 0 ]; then
    name=$1
    shift
    case "$name" in
        ''|.|..|*/*)
            printf 'ghinit: project name must be one path component\n' >&2
            exit 1
            ;;
    esac

    project_dir="$code_dir/$name"
    if [ -e "$project_dir" ]; then
        printf 'ghinit: %s already exists\n' "$project_dir" >&2
        exit 1
    fi
    mkdir "$project_dir"
    cd "$project_dir"
elif [ "$(dirname -- "$(pwd -P)")" != "$code_dir" ]; then
    printf '%s\n' \
        'ghinit: run from a directory directly inside ~/code, or pass a project name (creates ~/code/<name>)' \
        >&2
    exit 1
fi

ginit

# Push the current branch, tolerating a rejected push: an existing GitHub
# repository may already carry commits this checkout does not have.
push_current_branch() {
    branch=$(git symbolic-ref --short HEAD)
    if git push -u origin "$branch"; then
        return 0
    fi
    printf 'ghinit: origin is set, but pushing %s was rejected; reconcile the histories yourself\n' \
        "$branch" >&2
}

# The repository gh repo create --source=. would have made: named for this
# directory, owned by the authenticated user.
existing_repo_url() {
    repo=$(basename -- "$(pwd -P)")
    case "$(gh config get git_protocol 2>/dev/null)" in
        ssh) field=sshUrl ;;
        *) field=url ;;
    esac
    gh repo view "$repo" --json "$field" --jq ".$field" 2>/dev/null
}

ensure_visibility() {
    current_visibility=$(gh repo view --json visibility --jq .visibility)
    case "$current_visibility" in
        PUBLIC) current_visibility=public ;;
        PRIVATE) current_visibility=private ;;
        INTERNAL) current_visibility=internal ;;
    esac
    if [ "$current_visibility" = "$requested_visibility" ]; then
        return 0
    fi
    gh repo edit \
        --visibility "$requested_visibility" \
        --accept-visibility-change-consequences
}

created_repo=0
if ! git remote get-url origin >/dev/null 2>&1; then
    create_status=0
    gh repo create --source=. "$visibility" --push "$@" || create_status=$?
    if [ "$create_status" -eq 0 ]; then
        created_repo=1
    else
        # Creation commonly fails only because the repository already exists.
        # That is not an error worth stopping for: bind this checkout to it.
        if ! remote_url=$(existing_repo_url) || [ -z "$remote_url" ]; then
            exit "$create_status"
        fi
        printf 'ghinit: that repository already exists; adding it as origin\n' >&2
        git remote add origin "$remote_url"
        push_current_branch
    fi
elif ! git rev-parse --abbrev-ref '@{upstream}' >/dev/null 2>&1; then
    push_current_branch
fi

if [ -n "$requested_visibility" ] && [ "$created_repo" -eq 0 ]; then
    ensure_visibility
fi
