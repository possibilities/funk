#!/bin/bash
# Report whether gog holds a working Google credential, alerting on change.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: gog-ensure-authed [--check]

With a working credential this command is silent. Losing one posts a clickable
alert whose action runs `gog auth login`; regaining one clears that alert and
says so. A standing outage is not re-announced until the reminder interval
elapses, so a laptop left unauthenticated overnight is not a recurring banner.

Authentication itself is never attempted here: `gog auth login` needs a browser
and a human. --check reports the verdict and exits without alerting.
EOF
}

die() {
    printf 'gog-ensure-authed: %s\n' "$*" >&2
    exit 1
}

# Delegated to funk-notify so the reasons a notification silently fails to
# appear are solved once rather than in every caller.
notify() {
    local message="$1"
    local sound="$2"
    local remedy="$3"
    local -a args

    args=(--title Google --message "$message" --group com.arthack.funk.gog-authed)
    [ -n "$sound" ] && args+=(--sound "$sound")
    # A remedy prints guidance or prompts, so it needs a terminal a reader sees.
    [ -n "$remedy" ] && args+=(--terminal "$remedy")
    "$notify_bin" "${args[@]}" || true
}

record_alert() {
    local directory
    local temporary

    directory=$(dirname "$alert_file")
    umask 077
    mkdir -p "$directory"
    temporary="${alert_file}.tmp.$$"
    printf '%s\n%s\n' "$1" "$2" >"$temporary"
    chmod 600 "$temporary"
    mv -f "$temporary" "$alert_file"
}

# A shared --group keeps one entry in Notification Center, but macOS re-displays
# the banner on every post, so re-posting each run would put the same alert back
# on screen every fifteen minutes. An unchanged condition therefore posts nothing
# at all until the reminder interval elapses; only a change in the condition
# itself is immediate, and only that plays a sound. Set terminal-notifier's alert
# style to Alerts in System Settings so the standing entry persists until
# dismissed.
alert() {
    local message="$1"
    local remedy="$2"
    local previous=
    local previous_at=0
    local now

    now=$(date +%s)
    if [ -r "$alert_file" ]; then
        previous_at=$(sed -n '1p' "$alert_file")
        previous=$(sed -n '2,$p' "$alert_file")
    fi
    case "$previous_at" in
        '' | *[!0-9]*) previous_at=0 ;;
    esac

    if [ "$previous" = "$message" ]; then
        [ "$((now - previous_at))" -ge "$alert_reminder_seconds" ] || return 0
        record_alert "$now" "$message"
        notify "$message" '' "$remedy"
        return 0
    fi
    record_alert "$now" "$message"
    notify "$message" default "$remedy"
}

# Recovery is announced once, then the history is dropped so the next outage
# reads as a change rather than a repeat.
clear_alert() {
    [ -e "$alert_file" ] || return 0
    rm -f "$alert_file"
    notify "$1" default ''
}

gog_binary() {
    local candidate
    for candidate in "${GOG:-}" gog /opt/homebrew/bin/gog /usr/local/bin/gog; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

jq_binary() {
    local candidate
    for candidate in "${JQ:-}" jq /opt/homebrew/bin/jq /usr/local/bin/jq; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

# A dead credential and an unreachable network fail the same command. Only these
# say the credential itself is the problem; anything else is an outage somewhere
# between here and Google, and alerting on it would train the reader to ignore
# the alert that matters.
credential_failure() {
    printf '%s' "$1" | tr '[:upper:]' '[:lower:]' | grep -qE \
        'invalid_grant|token has been expired|revoked|unauthorized_client|invalid_client|not authenticated|no token|missing --account'
}

# Emits "<state>|<message>|<remedy>". The stages are distinct because the alert
# is edge-triggered on the message: finishing one step changes the message, which
# announces the next. Setup walks itself forward without anyone re-running this
# by hand.
verdict() {
    local gog
    local jq
    local clients
    local listing
    local accounts
    local emails
    local detail
    local probe_status
    local probe_error
    local probe_account

    gog=$(gog_binary) || {
        printf 'down|gog is not installed|%s\n' "$brew_command"
        return 0
    }
    jq=$(jq_binary) || die "jq is required"

    # An OAuth client identifies the application to Google and must exist before
    # any browser flow can run. Without this stage the missing client reads as
    # "not signed in", which sends a reader to a login that cannot yet work.
    clients=$("$gog" auth credentials list --json 2>/dev/null \
        | "$jq" -r '.clients | length' 2>/dev/null) || clients=0
    case "$clients" in
        '' | *[!0-9]*) clients=0 ;;
    esac
    if [ "$clients" -eq 0 ]; then
        printf 'down|no OAuth client configured — set one up before signing in|%s\n' \
            "$gog auth setup"
        return 0
    fi

    listing=$("$gog" auth list --json 2>/dev/null) || {
        printf 'down|gog auth list failed|%s\n' "$gog auth doctor"
        return 0
    }
    accounts=$(printf '%s' "$listing" | "$jq" -r '.accounts | length' 2>/dev/null) || accounts=0
    case "$accounts" in
        '' | *[!0-9]*) accounts=0 ;;
    esac
    if [ "$accounts" -eq 0 ]; then
        printf 'down|OAuth client ready; no account authorized yet|%s\n' "$authorize_command"
        return 0
    fi
    emails=$(printf '%s' "$listing" \
        | "$jq" -r '[.accounts[].email // "unknown"] | join(", ")' 2>/dev/null) \
        || emails=unknown
    detail="$accounts account(s): $emails"
    probe_account=$(printf '%s' "$listing" \
        | "$jq" -r '.accounts[0].email // ""' 2>/dev/null) || probe_account=

    # Listing a stored credential does not prove Google still honors it, so the
    # verdict rests on a real call. Without this an expired refresh token reads
    # as healthy right up until the work that needed it fails.
    #
    # The account is named rather than left to the default: with several stored
    # and no default chosen, gog refuses the call for want of an --account and
    # the probe would prove nothing about any of them.
    if [ -n "$probe_account" ]; then
        probe_error=$("$gog" --account "$probe_account" gmail search 'newer_than:1d' \
            --max 1 --json 2>&1 >/dev/null) && probe_status=0 || probe_status=$?
    else
        probe_error=$("$gog" gmail search 'newer_than:1d' --max 1 --json 2>&1 >/dev/null) \
            && probe_status=0 || probe_status=$?
    fi
    if [ "$probe_status" -ne 0 ]; then
        if credential_failure "$probe_error"; then
            printf 'down|credential expired or revoked (%s)|%s\n' \
                "$detail" "$reauthorize_command"
            return 0
        fi
        printf 'gog-ensure-authed: probe failed without a credential fault: %s\n' \
            "$probe_error" >&2
    fi
    printf 'ok|%s|\n' "$detail"
}

check_only=0
case "${1:-}" in
    "") ;;
    --check) check_only=1 ;;
    -h | --help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
[ "$#" -le 1 ] || {
    usage >&2
    exit 64
}

# Ignores XDG_STATE_HOME deliberately: interactive shells and launchd must share
# one alert history so they do not re-alert on each other's behalf.
alert_file="$HOME/.local/state/funk/gog-ensure-authed.alert"
# How long an unchanged condition stays quiet before reminding once. Long enough
# that a standing outage is not a recurring interruption, short enough that a
# dismissed alert still comes back the same day.
alert_reminder_seconds=${FUNK_GOG_ALERT_REMINDER_SECONDS:-14400}
case "$alert_reminder_seconds" in
    '' | *[!0-9]*) die "FUNK_GOG_ALERT_REMINDER_SECONDS must be a whole number of seconds" ;;
esac
notify_bin=${FUNK_NOTIFY_BIN:-"$(dirname "$0")/funk-notify"}
[ -x "$notify_bin" ] || notify_bin=$(command -v funk-notify || printf 'true')
gog_path=$(gog_binary || printf gog)
brew_command="brew bundle --file $HOME/code/funk/Brewfile"
# The account is configurable because funk knows nothing about which mailbox a
# consumer needs; unset, the guided flow asks.
gog_account=${FUNK_GOG_ACCOUNT:-}
if [ -n "$gog_account" ]; then
    authorize_command="$gog_path auth add $gog_account --services gmail"
else
    authorize_command="$gog_path auth setup"
fi
reauthorize_command="$gog_path auth login"

result=$(verdict)
state=${result%%|*}
rest=${result#*|}
detail=${rest%%|*}
remedy=${rest#*|}

if [ "$check_only" -eq 1 ]; then
    printf '%s: %s\n' "$state" "$detail"
    [ "$state" = ok ]
    exit
fi

if [ "$state" = ok ]; then
    clear_alert "Google auth recovered ($detail)."
    exit 0
fi

if [ -n "$remedy" ]; then
    alert "$detail. Run: $remedy" "$remedy"
else
    alert "$detail" ""
fi
exit 1
