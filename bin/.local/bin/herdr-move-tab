#!/usr/bin/env python3
# Move the focused Herdr tab left or right within its workspace, wrapping at
# the ends the way tmux-move-window does.
# Usage: herdr-move-tab left|right
#
# Herdr 0.8.0 has the tab.move API but no CLI wrapper or move_tab_* keybind
# action; both land in the release after it. Retire this script then.

import json
import os
import socket
import sys


def fail(message):
    print(f"herdr-move-tab: {message}", file=sys.stderr)
    raise SystemExit(1)


def socket_path():
    override = os.environ.get("HERDR_SOCKET_PATH")
    if override:
        return override
    config = os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config")
    return os.path.join(config, "herdr", "herdr.sock")


# The server answers one request per connection, so each call gets its own.
def call(method, params):
    path = socket_path()
    request = {"id": f"herdr-move-tab:{method}", "method": method, "params": params}
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as sock:
        try:
            sock.connect(path)
        except OSError as error:
            fail(f"{path}: {error.strerror}")
        with sock.makefile("rwb") as stream:
            stream.write(json.dumps(request).encode() + b"\n")
            stream.flush()
            line = stream.readline()
    if not line:
        fail(f"{method}: no response")
    response = json.loads(line)
    if "error" in response:
        fail(f"{method}: {response['error'].get('message', response['error'])}")
    return response["result"]


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in ("left", "right"):
        print("usage: herdr-move-tab left|right", file=sys.stderr)
        raise SystemExit(2)
    step = -1 if sys.argv[1] == "left" else 1

    snapshot = call("session.snapshot", {})["snapshot"]
    workspace = snapshot["focused_workspace_id"]
    focused = snapshot["focused_tab_id"]
    tabs = [tab["tab_id"] for tab in snapshot["tabs"] if tab["workspace_id"] == workspace]
    if focused not in tabs or len(tabs) < 2:
        return

    index = tabs.index(focused)
    target = (index + step) % len(tabs)
    # insert_index anchors against the list before the tab is lifted out, so a
    # move toward the end has to clear the tab's own slot.
    call(
        "tab.move",
        {"tab_id": focused, "insert_index": target + 1 if target > index else target},
    )


if __name__ == "__main__":
    main()
