#!/bin/bash
# cass-window-reset -- rebuild the cass search index over the live stores.
#
# cass never deletes indexed content (its own rule number one), so an index
# that only ever ingests grows without bound: every session it has ever seen
# stays searchable forever. The rolling search window comes from here. Once a
# month this sets the data directory aside and re-ingests whatever the live
# agent stores still hold — and Claude Code prunes those at cleanupPeriodDays
# (90 on this machine), so search spans roughly the last three to four
# months. Nothing is lost by the discard: the raw transcripts are preserved
# by transcript-vault's archive and restic stages, and the whole data
# directory is derived state, rebuildable from the live stores at any time.
#
# The rebuild is a plain incremental `cass index` over an empty data
# directory, not `cass index --full`: on an empty directory the incremental
# entrypoint ingests everything through the ordinary streaming path, while
# --full's deferred authoritative rebuild hits a deterministic frankensqlite
# snapshot conflict on this corpus (cass 0.6.25, exit 7 on the same pages
# every run; filed upstream as cass issue #401 — plain incremental hits it
# too, which is what the retry loop below absorbs).
#
# The reset is guarded: it holds transcript-vault's single-instance lock so
# no hourly index pass competes, keeps the old data directory aside until the
# rebuild has proven itself with a served search, and restores it when the
# rebuild fails or exceeds its deadline.
# Runs monthly from com.arthack.funk.cass-window-reset.

set -uo pipefail

PATH="/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:$HOME/.local/bin"

[ "$#" -eq 0 ] || {
    printf 'Usage: cass-window-reset\n' >&2
    exit 64
}

DATA_DIR="$HOME/Library/Application Support/com.coding-agent-search.coding-agent-search"
KEEP="$DATA_DIR.pre-reset"
# A fresh ingest of a three-month live corpus runs minutes; hours means
# wedged. Wall-clock, because a deadline counted in sleep iterations freezes
# while the machine sleeps.
RESET_TIMEOUT=${CASS_WINDOW_RESET_TIMEOUT:-7200}

log() {
    printf '[%s] %s\n' "$(date '+%Y-%m-%dT%H:%M:%S')" "$*"
}

notify() {
    command -v funk-notify >/dev/null 2>&1 || return 0
    funk-notify --title 'cass window reset' --message "$1" \
        --group funk-cass-window-reset || true
}

command -v cass >/dev/null 2>&1 || {
    log "cass is not installed; nothing to reset"
    exit 0
}

# The data directory once lived behind a symlink onto an external volume;
# resetting through a symlink would silently rebuild somewhere else.
if [ -L "$DATA_DIR" ]; then
    log "ERROR: $DATA_DIR is a symlink; refusing to reset through it"
    exit 1
fi

# Hold transcript-vault's lock for the duration so the hourly agent skips
# instead of racing the rebuild with a second indexer.
LOCK_DIR="/tmp/transcript-vault.$(id -u).lock"
if ! mkdir "$LOCK_DIR" 2>/dev/null; then
    holder=$(cat "$LOCK_DIR/pid" 2>/dev/null || true)
    if [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null; then
        log "vault lock held by pid $holder; skipping this firing"
        exit 0
    fi
    rm -rf "$LOCK_DIR"
    mkdir "$LOCK_DIR" 2>/dev/null || {
        log "lock contention; skipping this firing"
        exit 0
    }
fi
printf '%s\n' $$ >"$LOCK_DIR/pid"
trap 'rm -rf "$LOCK_DIR"' EXIT
log "window reset starting (pid $$)"

rm -rf "$KEEP"
if [ -d "$DATA_DIR" ]; then
    mv "$DATA_DIR" "$KEEP" || {
        log "ERROR: cannot set the old data directory aside"
        exit 1
    }
fi
mkdir -p "$DATA_DIR"

restore_old() {
    rm -rf "$DATA_DIR"
    if [ -d "$KEEP" ]; then
        mv "$KEEP" "$DATA_DIR" && log "previous data directory restored"
    fi
}

# One attempt: cass index in a watched child, killed hard past the deadline.
# The child records its own status so this shell never needs `wait`, and the
# job is disowned so bash cannot print a signalled-job notice into the log
# when the deadline fires.
deadline=$(($(date +%s) + RESET_TIMEOUT))
run_attempt() {
    local out_file rc_file index_pid rc
    out_file=$(mktemp "${TMPDIR:-/tmp}/cass-window-reset.XXXXXX")
    rc_file=$(mktemp "${TMPDIR:-/tmp}/cass-window-reset-rc.XXXXXX")
    {
        nice -n 20 cass index --json --no-progress-events \
            >"$out_file" 2>&1
        printf '%s\n' "$?" >"$rc_file"
    } &
    index_pid=$!
    disown "$index_pid" 2>/dev/null || true
    rc=""
    while kill -0 "$index_pid" 2>/dev/null; do
        if [ "$(date +%s)" -ge "$deadline" ]; then
            # Kill the indexer itself, not just the subshell wrapping it.
            pkill -P "$index_pid" 2>/dev/null
            kill "$index_pid" 2>/dev/null
            sleep 2
            pkill -9 -P "$index_pid" 2>/dev/null
            kill -9 "$index_pid" 2>/dev/null
            rc=124
            break
        fi
        sleep 10
    done
    if [ -z "$rc" ]; then
        rc=$(cat "$rc_file" 2>/dev/null)
        rc=${rc:-1}
    fi
    out=$(cat "$out_file" 2>/dev/null)
    rm -f "$out_file" "$rc_file"
    return "$rc"
}

# Ingest survives its own failures: cass 0.6.25 aborts a streaming ingest
# with a retryable frankensqlite snapshot conflict (exit 7) every hundred-odd
# conversations, but everything ingested before the abort is durable, so
# resumed runs converge. Retry exit 7 until the run comes back clean or the
# deadline passes; treat any other failure as real.
rc=0
attempt=0
while :; do
    attempt=$((attempt + 1))
    rc=0
    run_attempt || rc=$?
    [ "$rc" -eq 7 ] || break
    if [ "$(date +%s)" -ge "$deadline" ]; then
        rc=124
        break
    fi
    log "attempt $attempt hit a retryable ingest conflict; resuming"
done

if [ "$rc" -ne 0 ]; then
    log "ERROR: rebuild failed (exit $rc after $attempt attempts): $(printf '%s' "$out" | tr -d '\n' | cut -c 1-300)"
    restore_old
    notify "Index rebuild failed (exit $rc); the previous index was restored."
    exit 1
fi
log "ingest clean after $attempt attempt(s)"

# The rebuild counts only once search actually serves from it.
if ! cass search "" --robot --limit 1 >/dev/null 2>&1; then
    log "ERROR: rebuilt index does not serve a search"
    restore_old
    notify "Rebuilt index failed its search probe; the previous index was restored."
    exit 1
fi

rm -rf "$KEEP"
log "window reset complete: $(printf '%s' "$out" | tr -d '\n' | cut -c 1-300)"
notify "Search index rebuilt over the live agent stores."
exit 0
