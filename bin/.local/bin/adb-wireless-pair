#!/bin/bash
# Pair this Mac with an Android phone through its Tailnet DNS name.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: adb-wireless-pair [--host TAILNET_HOST] PAIRING_PORT

Pair with the port shown under:
  Wireless debugging -> Pair device with pairing code

The default host is smallbird. TAILNET_HOST must be a single-label MagicDNS
name or a fully qualified *.ts.net name. Enter the temporary pairing code only
at adb's prompt; it is not accepted as a command-line argument or saved.
EOF
}

die() {
    printf 'adb-wireless-pair: %s\n' "$*" >&2
    exit 1
}

validate_tailnet_host() {
    local candidate=$1
    local lower

    case "$candidate" in
        ''|.*|*..*|-*|*-|*[^A-Za-z0-9.-]*)
            die "invalid Tailnet DNS hostname: $candidate"
            ;;
    esac

    lower=$(printf '%s' "$candidate" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
        *.*)
            case "$lower" in
                *.ts.net) ;;
                *) die "host must be a MagicDNS name or end in .ts.net" ;;
            esac
            ;;
    esac
}

validate_port() {
    case "$1" in
        ''|*[!0-9]*) die "pairing port must be an integer from 1 to 65535" ;;
    esac
    [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null \
        || die "pairing port must be an integer from 1 to 65535"
}

host=${ADB_WIRELESS_HOST:-smallbird}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --host)
            [ "$#" -ge 2 ] || die "--host requires a value"
            host=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

[ "$#" -eq 1 ] || {
    usage >&2
    exit 2
}
port=$1

validate_tailnet_host "$host"
validate_port "$port"

adb_bin=${ADB:-}
if [ -z "$adb_bin" ]; then
    adb_bin=$(command -v adb || true)
fi
[ -n "$adb_bin" ] || die "adb is missing; run: brew install --cask android-platform-tools"

printf 'Pairing with %s through the Tailnet.\n' "$host:$port"
printf 'Enter the temporary six-digit pairing code at the adb prompt.\n'
exec "$adb_bin" pair "$host:$port"
