#!/bin/bash
# Pair this Mac with an Android phone through its Tailnet DNS name.

set -euo pipefail

usage() {
    cat <<'EOF'
Usage: adb-wireless-pair [--host TAILNET_HOST] PAIRING_PORT

Pair with the port shown under:
  Wireless debugging -> Pair device with pairing code

The default host is smolbird. TAILNET_HOST must be a single-label MagicDNS
name or a fully qualified *.ts.net name. Single-label names are completed with
the Tailnet's MagicDNS suffix before use. Enter the temporary pairing code only
at adb's prompt; it is not accepted as a command-line argument or saved.
EOF
}

die() {
    printf 'adb-wireless-pair: %s\n' "$*" >&2
    exit 1
}

validate_tailnet_host() {
    local candidate=$1
    local lower

    case "$candidate" in
        ''|.*|*..*|-*|*-|*[^A-Za-z0-9.-]*)
            die "invalid Tailnet DNS hostname: $candidate"
            ;;
    esac

    lower=$(printf '%s' "$candidate" | tr '[:upper:]' '[:lower:]')
    case "$lower" in
        *.*)
            case "$lower" in
                *.ts.net) ;;
                *) die "host must be a MagicDNS name or end in .ts.net" ;;
            esac
            ;;
    esac
}

validate_port() {
    case "$1" in
        ''|*[!0-9]*) die "pairing port must be an integer from 1 to 65535" ;;
    esac
    [ "$1" -ge 1 ] 2>/dev/null && [ "$1" -le 65535 ] 2>/dev/null \
        || die "pairing port must be an integer from 1 to 65535"
}

tailscale_binary() {
    local candidate
    for candidate in "${TAILSCALE:-}" tailscale /usr/local/bin/tailscale \
        /Applications/Tailscale.app/Contents/MacOS/Tailscale; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

# Raycast does not run these through the interactive shell, so fall back to the
# locations Homebrew uses instead of trusting the caller's PATH.
adb_binary() {
    local candidate
    for candidate in "${ADB:-}" adb /opt/homebrew/bin/adb /usr/local/bin/adb; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

tailnet_suffix() {
    local binary
    binary=$(tailscale_binary) || return 1
    "$binary" status --json 2>/dev/null | sed -n \
        's/.*"MagicDNSSuffix"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
        | head -n 1
}

# macOS installs the Tailnet resolver as a resolver scoped to the Tailnet
# domain, so it never answers a single-label query. Complete the short name to
# the full MagicDNS name so it resolves the same way from a shell and Raycast.
qualify_host() {
    local suffix

    case "$1" in
        *.*)
            printf '%s\n' "$1"
            return 0
            ;;
    esac

    suffix=$(tailnet_suffix || true)
    if [ -n "$suffix" ]; then
        printf '%s.%s\n' "$1" "${suffix%.}"
    else
        printf '%s\n' "$1"
    fi
}

host=${ADB_WIRELESS_HOST:-smolbird}
while [ "$#" -gt 0 ]; do
    case "$1" in
        --host)
            [ "$#" -ge 2 ] || die "--host requires a value"
            host=$2
            shift 2
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        --)
            shift
            break
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            break
            ;;
    esac
done

[ "$#" -eq 1 ] || {
    usage >&2
    exit 2
}
port=$1

validate_tailnet_host "$host"
validate_port "$port"
host=$(qualify_host "$host")

adb_bin=$(adb_binary || true)
[ -n "$adb_bin" ] || die "adb is missing; run: brew install --cask android-platform-tools"

printf 'Pairing with %s through the Tailnet.\n' "$host:$port"
printf 'Enter the temporary six-digit pairing code at the adb prompt.\n'
exec "$adb_bin" pair "$host:$port"
