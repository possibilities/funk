#!/bin/bash
# Keep this Mac awake, and signed in, while it is wired into the home network.
#
# Being plugged in is not by itself evidence of being home: any dock in any
# building satisfies it. So the gate is a wired link whose own router answers
# with a recorded hardware address. Off that network the previous screen lock
# delay comes back.
#
# The recorded address is a convenience gate, not authentication. A router's
# hardware address is public on its own segment and can be spoofed by anyone who
# knows it. It separates this house from a hotel dock; it does not stand up to
# somebody who is targeting this machine.

set -euo pipefail

# Tests point this at a fixture directory. launchd supplies almost no PATH, so
# the real one has to be spelled out here rather than inherited.
PATH="${FUNK_HOME_AWAKE_PATH:-/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin}"
export PATH

helper="${FUNK_HOME_AWAKE_HELPER:-/usr/local/libexec/funk-home-awake}"
keychain_service=funk-home-awake
caffeinate_label=com.arthack.funk.home-awake-caffeinate

# security reports the Security framework's status in its exit code, and
# errSecItemNotFound arrives as 44. That one code is the whole difference
# between "nothing is stored yet" and "something is stored that this process may
# not read": a refused prompt, a locked keychain and an ACL that does not list
# the reader are all the second kind and all differ by code. Naming only 44 is
# what keeps the classification right without enumerating the rest.
security_not_found=44

state_dir="$HOME/.local/state/funk"
screenlock_state_file="$state_dir/home-awake-screenlock"
keychain_state_file="$state_dir/home-awake-keychain"
caffeinate_plist="$state_dir/$caffeinate_label.plist"
config_file="$HOME/.config/funk/home-awake.conf"

# No network ships as a default. Until --learn-network records one, nothing is
# trusted and nothing is relaxed, so a fresh account fails closed rather than
# inheriting some other machine's idea of home.
router_mac=
router_label=
awake_reason=

usage() {
    cat <<'EOF'
Usage: home-awake
       home-awake --status
       home-awake --learn-network [NAME]
       home-awake --set-password
       home-awake --authorize

With no arguments this converges sleep and screen-lock state for the network
this Mac is currently on. It is silent unless something changed.

--status         Report caffeinate, sleep, screen lock, and network state
--learn-network  Record the router this Mac is currently wired to as home,
                 optionally under a name of your choosing
--set-password   Store the login password the screen-lock change authenticates
                 with, in the login keychain
--authorize      Read that password once here, so the keychain asks for consent
                 at this terminal instead of from the unattended agent
EOF
}

die() {
    printf 'home-awake: %s\n' "$*" >&2
    exit 1
}

note() {
    logger -t home-awake "$*" 2>/dev/null || true
}

notify() {
    local message="$1"
    local notifier

    if [ -n "${FUNK_TERMINAL_NOTIFIER_BIN:-}" ] \
        && [ -x "$FUNK_TERMINAL_NOTIFIER_BIN" ]; then
        notifier="$FUNK_TERMINAL_NOTIFIER_BIN"
    elif command -v terminal-notifier >/dev/null 2>&1; then
        notifier=$(command -v terminal-notifier)
    else
        return 0
    fi

    "$notifier" \
        -title home-awake \
        -message "$message" \
        -group com.arthack.funk.home-awake >/dev/null 2>&1 || true
}

read_config() {
    local key
    local value
    local line

    [ -f "$config_file" ] || return 0
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) continue ;;
        esac
        key=${line%%=*}
        value=${line#*=}
        [ "$key" != "$line" ] || continue
        case "$key" in
            router_mac) router_mac=$(normalize_mac "$value") ;;
            router_label) router_label="$value" ;;
            *) ;;
        esac
    done <"$config_file"
}

# arp prints octets without leading zeros, so 08:00:27:… comes back as 8:0:27:….
# Both sides of the comparison go through here, or a perfectly good match fails
# on formatting alone.
normalize_mac() {
    printf '%s\n' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | awk -F: '
            NF != 6 { exit 1 }
            {
                for (i = 1; i <= 6; i++) {
                    if ($i !~ /^[0-9a-f][0-9a-f]?$/) exit 1
                    octet = (length($i) == 1) ? "0" $i : $i
                    printf "%s%s", (i > 1 ? ":" : ""), octet
                }
                printf "\n"
            }
        '
}

wifi_interface() {
    networksetup -listallhardwareports 2>/dev/null \
        | awk '/^Hardware Port: Wi-Fi$/ { getline; print $2; exit }'
}

wired_interfaces() {
    local interface
    local wifi

    wifi=$(wifi_interface)
    for interface in $(ifconfig -l 2>/dev/null | tr ' ' '\n' | grep '^en'); do
        [ "$interface" != "$wifi" ] || continue
        if ifconfig "$interface" 2>/dev/null | grep -q 'status: active'; then
            printf '%s\n' "$interface"
        fi
    done
}

# The router is read per interface rather than from the default route, so that
# a Tailscale exit node taking over the default route cannot change the answer
# to "which network is this cable on".
interface_router() {
    ipconfig getoption "$1" router 2>/dev/null | grep -E '^[0-9.]+$' || return 1
}

arp_hardware_address() {
    arp -n "$1" 2>/dev/null | awk '{ print $4 }'
}

# An address that has aged out of the cache reads as incomplete, which is not
# the same answer as "a different router". One probe repopulates it; anything
# still unreadable after that is treated as unknown, and unknown is untrusted.
router_hardware_address() {
    local router="$1"
    local address

    address=$(normalize_mac "$(arp_hardware_address "$router")" 2>/dev/null) || address=
    if [ -z "$address" ]; then
        ping -c 1 -t 1 "$router" >/dev/null 2>&1 || true
        address=$(normalize_mac "$(arp_hardware_address "$router")" 2>/dev/null) || address=
    fi
    [ -n "$address" ] || return 1
    printf '%s\n' "$address"
}

home_interface() {
    local interface
    local router
    local address

    [ -n "$router_mac" ] || return 1
    while IFS= read -r interface; do
        [ -n "$interface" ] || continue
        router=$(interface_router "$interface") || continue
        address=$(router_hardware_address "$router") || continue
        if [ "$address" = "$router_mac" ]; then
            printf '%s\n' "$interface"
            return 0
        fi
    done <<EOF
$(wired_interfaces)
EOF
    return 1
}

is_on_ac_power() {
    pmset -g batt 2>/dev/null | head -1 | grep -q "'AC Power'"
}

should_stay_awake() {
    local interface

    interface=$(home_interface) || return 1
    awake_reason="wired to ${router_label:-home} on $interface"
}

caffeinate_loaded() {
    launchctl print "gui/$(id -u)/$caffeinate_label" >/dev/null 2>&1
}

start_caffeinate() {
    caffeinate_loaded && return 0
    if [ ! -f "$caffeinate_plist" ]; then
        note "caffeinate job is not installed; run funk install-home-awake"
        return 1
    fi
    launchctl bootstrap "gui/$(id -u)" "$caffeinate_plist" 2>/dev/null || return 1
    note "started caffeinate ($awake_reason)"
    notify "Staying awake: $awake_reason"
}

stop_caffeinate() {
    caffeinate_loaded || return 0
    launchctl bootout "gui/$(id -u)/$caffeinate_label" 2>/dev/null || return 1
    note "stopped caffeinate"
    notify "Left the home network; normal sleep and screen lock restored"
}

sleep_disabled_state() {
    pmset -g 2>/dev/null | awk '/SleepDisabled/ { print $2; exit }'
}

set_sleep_disabled() {
    local desired="$1"

    [ "$(sleep_disabled_state)" != "$desired" ] || return 0
    if sudo -n "$helper" sleep "$desired" >/dev/null 2>&1; then
        note "set disablesleep=$desired"
    else
        note "could not set disablesleep=$desired; run funk install-home-awake"
        return 1
    fi
}

# Prints "off", "immediate", or a plain number of seconds, matching what the
# root helper and the saved-state file accept.
screenlock_state() {
    local output
    local seconds

    output=$(sysadminctl -screenLock status 2>&1) || true
    if printf '%s\n' "$output" | grep -qi 'screenLock is off'; then
        printf 'off\n'
        return 0
    fi
    seconds=$(printf '%s\n' "$output" | grep -oE 'delay is [0-9]+' | grep -oE '[0-9]+' || true)
    [ -n "$seconds" ] || return 1
    if [ "$seconds" -eq 0 ]; then
        printf 'immediate\n'
    else
        printf '%s\n' "$seconds"
    fi
}

# The stored login password authorizes every screen-lock change, and the item
# trusts no application, so reading it takes a human the first time.
#
# Be plain about what that buys. Clicking Always Allow at that prompt puts
# /usr/bin/security back on the item's ACL, and from then on this agent reads
# the password exactly as freely as it did when --set-password handed out the
# same grant itself. Nothing here hides the password from code running as this
# user. What changes is who granted it: a person, at a terminal, answering a
# question about their own login password, rather than an installer granting it
# on their behalf and never mentioning it again.
keychain_state() {
    local state=unknown

    [ ! -r "$keychain_state_file" ] || state=$(cat "$keychain_state_file")
    printf '%s\n' "$state"
}

record_keychain_state() {
    mkdir -p "$state_dir"
    printf '%s\n' "$1" >"$keychain_state_file"
}

# One notification per transition. The converge path retries every thirty
# seconds for as long as it is stuck, and a banner on every tick is how a
# notification stream teaches its reader to ignore it.
announce_keychain_state() {
    local state="$1"

    [ "$(keychain_state)" != "$state" ] || return 0
    record_keychain_state "$state"
    case "$state" in
        missing) notify 'Screen lock unmanaged: run home-awake --set-password' ;;
        unapproved) notify 'Screen lock unmanaged: run home-awake --authorize' ;;
    esac
}

# Prints the stored password, or records which of the three states this run is
# in -- missing, present but unapproved, approved -- and fails.
#
# An unapproved item is not read again until --authorize clears that verdict.
# This runs from a LaunchAgent inside the GUI session, so an unapproved read is
# a SecurityAgent dialog, and one every thirty seconds is not a failed
# authorization but an unusable machine. A missing item carries no such cost --
# a search that matches nothing never reaches an ACL -- so that state re-checks
# itself and recovers on its own once something is stored.
read_login_password() {
    local password
    local status=0

    if [ "$(keychain_state)" = unapproved ]; then
        note "keychain item '$keychain_service' is unapproved; run home-awake --authorize"
        return 1
    fi
    password=$(security find-generic-password -a "$(id -un)" \
        -s "$keychain_service" -w 2>/dev/null) || status=$?
    if [ "$status" -eq 0 ]; then
        announce_keychain_state approved
        printf '%s\n' "$password"
        return 0
    fi
    if [ "$status" -eq "$security_not_found" ]; then
        note "keychain item '$keychain_service' is missing; run home-awake --set-password"
        announce_keychain_state missing
    else
        note "keychain read refused (security exit $status); run home-awake --authorize"
        announce_keychain_state unapproved
    fi
    return 1
}

set_screenlock() {
    local spec="$1"
    local password

    password=$(read_login_password) || return 1
    printf '%s\n' "$password" | sudo -n "$helper" screenlock "$spec" >/dev/null 2>&1
}

disable_screenlock() {
    local current

    current=$(screenlock_state) || return 1
    [ "$current" != off ] || return 0
    mkdir -p "$state_dir"
    printf '%s\n' "$current" >"$screenlock_state_file"
    if set_screenlock off; then
        note "disabled screen lock ($awake_reason; was $current)"
        notify "Screen lock off: $awake_reason"
    else
        rm -f "$screenlock_state_file"
        return 1
    fi
}

restore_screenlock() {
    local current
    local target=immediate

    current=$(screenlock_state) || return 1
    [ "$current" = off ] || return 0
    if [ -f "$screenlock_state_file" ]; then
        target=$(cat "$screenlock_state_file")
    fi
    case "$target" in
        off) target=immediate ;;
    esac
    if set_screenlock "$target"; then
        rm -f "$screenlock_state_file"
        note "restored screen lock ($target)"
    else
        return 1
    fi
}

report_status() {
    local network=away

    if should_stay_awake; then
        network="$awake_reason"
    fi
    printf 'network: %s\n' "$network"
    if caffeinate_loaded; then
        printf 'caffeinate: yes\n'
    else
        printf 'caffeinate: no\n'
    fi
    if [ "$(sleep_disabled_state)" = 1 ]; then
        printf 'sleepdisabled: yes\n'
    else
        printf 'sleepdisabled: no\n'
    fi
    printf 'screenlock: %s\n' "$(screenlock_state || printf 'unknown\n')"
    # The recorded verdict rather than a fresh probe: anything that reaches the
    # item's data is a keychain dialog, and --status is not worth one.
    printf 'screenlock password: %s\n' "$(keychain_state)"
    if [ -n "$router_mac" ]; then
        printf 'home router: %s (%s)\n' "${router_label:-unnamed}" "$router_mac"
    else
        printf 'home router: not recorded; run home-awake --learn-network\n'
    fi
}

learn_network() {
    local label="$1"
    local interface
    local router
    local address
    local directory

    interface=$(wired_interfaces | head -1)
    [ -n "$interface" ] \
        || die "no active wired interface; plug into the home network first"
    router=$(interface_router "$interface") \
        || die "$interface has no router; wait for it to finish configuring"
    address=$(router_hardware_address "$router") \
        || die "the router at $router did not answer; retry once the link is up"
    [ -n "$label" ] || label="$router"

    directory=$(dirname "$config_file")
    mkdir -p "$directory"
    printf '# Written by home-awake --learn-network\nrouter_label=%s\nrouter_mac=%s\n' \
        "$label" "$address" >"$config_file"
    printf 'Recorded %s (%s at %s, via %s) as home in %s\n' \
        "$label" "$address" "$router" "$interface" "$config_file"
}

set_password() {
    local status=0

    printf 'Storing the login password home-awake authenticates screen-lock\n'
    printf 'changes with. Nothing reads it back without asking you first.\n'
    # Delete and recreate rather than update in place. -U is documented to
    # update the item; it is not documented to replace the access control list
    # already on it, and a revocation that quietly leaves the old grant standing
    # is worse than no revocation at all, because it reads as done. Removing the
    # item first makes the list written below the only list it has ever carried.
    #
    # A first run has nothing to remove, which security reports as
    # errSecItemNotFound. Every other failure is real and stops here rather than
    # being written over.
    security delete-generic-password -a "$(id -un)" -s "$keychain_service" \
        >/dev/null 2>&1 || status=$?
    [ "$status" -eq 0 ] || [ "$status" -eq "$security_not_found" ] \
        || die "the stored keychain item could not be removed (security exit $status)"
    # A bare trailing -w is what makes security prompt for the password instead
    # of taking it as an argument, where it would be visible in the process list
    # and, worse, stored empty if the option were left out entirely. That order
    # costs something: an aborted prompt leaves nothing stored, because the
    # alternative -- reading the password first so it could be put back -- means
    # holding it in argv, a file, or a variable, which is the property the bare
    # -w exists to preserve.
    #
    # -T "" is not the same as leaving -T out. security(1): "the application
    # which creates an item is trusted to access its data without warning. You
    # can remove this default access by explicitly specifying an empty app
    # pathname: -T ''". Omitting the option would leave the creating application
    # trusted -- security itself, the same binary the agent reads with -- and
    # this whole path would revoke nothing.
    security add-generic-password -a "$(id -un)" -s "$keychain_service" \
        -T "" -l "Funk home-awake login password" -w \
        || die "the keychain item was not stored"
    record_keychain_state unapproved
    printf 'Stored keychain item %s. Nothing may read it yet.\n' "$keychain_service"
    printf 'Run home-awake --authorize next, and choose Always Allow.\n'
}

# The first read of a fresh item raises the keychain prompt. This is where that
# happens: in the foreground, because the operator asked for it, rather than out
# of a LaunchAgent at whatever moment the machine next changes networks.
authorize_password() {
    local status=0

    printf 'Reading the stored login password once, here, so the keychain asks\n'
    printf 'at this terminal rather than from the unattended agent.\n'
    printf 'Choose Always Allow; a plain Allow answers only this one read.\n'
    # A plain Allow answers this read too, and leaves the ACL untouched, so the
    # next unattended read prompts again. Both answers return the password, so
    # nothing here can tell them apart; the recovery is the same either way,
    # because the agent records that refusal and asks for this command again.
    #
    # The password is read only to make the prompt happen, so it goes nowhere:
    # not to the terminal, not to a file, not into a variable.
    security find-generic-password -a "$(id -un)" -s "$keychain_service" -w \
        >/dev/null 2>&1 || status=$?
    if [ "$status" -eq "$security_not_found" ]; then
        record_keychain_state missing
        die "no $keychain_service item to approve; run home-awake --set-password"
    fi
    if [ "$status" -ne 0 ]; then
        record_keychain_state unapproved
        die "the keychain read was refused; the screen lock stays unmanaged"
    fi
    record_keychain_state approved
    printf '\nApproved. Always Allow put /usr/bin/security back on the item, so\n'
    printf 'the agent now reads the password unattended: the same access that\n'
    printf 'storing it used to grant on its own, granted by you instead.\n'
}

mode=converge
learn_label=
case "${1:-}" in
    '') ;;
    --status) mode=status ;;
    --learn-network)
        mode=learn
        learn_label=${2:-}
        ;;
    --set-password) mode=password ;;
    --authorize) mode=authorize ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
case "$mode" in
    learn) [ "$#" -le 2 ] || { usage >&2; exit 64; } ;;
    *) [ "$#" -le 1 ] || { usage >&2; exit 64; } ;;
esac

[ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "HOME is not an existing directory"
read_config

case "$mode" in
    status)
        report_status
        exit 0
        ;;
    learn)
        learn_network "$learn_label"
        exit 0
        ;;
    password)
        set_password
        exit 0
        ;;
    authorize)
        authorize_password
        exit 0
        ;;
esac

status=0
if should_stay_awake; then
    start_caffeinate || status=1
    if is_on_ac_power; then
        set_sleep_disabled 1 || status=1
    else
        set_sleep_disabled 0 || status=1
    fi
    disable_screenlock || status=1
else
    stop_caffeinate || status=1
    set_sleep_disabled 0 || status=1
    restore_screenlock || status=1
fi
exit "$status"
