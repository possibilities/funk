#!/bin/bash
# Keep this Mac awake, and signed in, while it is wired into the home network.
#
# Being plugged in is not by itself evidence of being home: any dock in any
# building satisfies it. So the gate is a wired link whose own router answers
# with a recorded hardware address. Off that network the previous screen lock
# delay comes back.
#
# The recorded address is a convenience gate, not authentication. A router's
# hardware address is public on its own segment and can be spoofed by anyone who
# knows it. It separates this house from a hotel dock; it does not stand up to
# somebody who is targeting this machine.

set -euo pipefail

# Tests point this at a fixture directory. launchd supplies almost no PATH, so
# the real one has to be spelled out here rather than inherited.
PATH="${FUNK_HOME_AWAKE_PATH:-/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin}"
export PATH

helper="${FUNK_HOME_AWAKE_HELPER:-/usr/local/libexec/funk-home-awake}"
keychain_service=funk-home-awake
caffeinate_label=com.arthack.funk.home-awake-caffeinate

state_dir="$HOME/.local/state/funk"
screenlock_state_file="$state_dir/home-awake-screenlock"
caffeinate_plist="$state_dir/$caffeinate_label.plist"
config_file="$HOME/.config/funk/home-awake.conf"

# No network ships as a default. Until --learn-network records one, nothing is
# trusted and nothing is relaxed, so a fresh account fails closed rather than
# inheriting some other machine's idea of home.
router_mac=
router_label=
awake_reason=

usage() {
    cat <<'EOF'
Usage: home-awake
       home-awake --status
       home-awake --learn-network [NAME]
       home-awake --set-password

With no arguments this converges sleep and screen-lock state for the network
this Mac is currently on. It is silent unless something changed.

--status         Report caffeinate, sleep, screen lock, and network state
--learn-network  Record the router this Mac is currently wired to as home,
                 optionally under a name of your choosing
--set-password   Store the login password the screen-lock change authenticates
                 with, in the login keychain
EOF
}

die() {
    printf 'home-awake: %s\n' "$*" >&2
    exit 1
}

note() {
    logger -t home-awake "$*" 2>/dev/null || true
}

notify() {
    local message="$1"
    local notifier

    if [ -n "${FUNK_TERMINAL_NOTIFIER_BIN:-}" ] \
        && [ -x "$FUNK_TERMINAL_NOTIFIER_BIN" ]; then
        notifier="$FUNK_TERMINAL_NOTIFIER_BIN"
    elif command -v terminal-notifier >/dev/null 2>&1; then
        notifier=$(command -v terminal-notifier)
    else
        return 0
    fi

    "$notifier" \
        -title home-awake \
        -message "$message" \
        -group com.arthack.funk.home-awake >/dev/null 2>&1 || true
}

read_config() {
    local key
    local value
    local line

    [ -f "$config_file" ] || return 0
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) continue ;;
        esac
        key=${line%%=*}
        value=${line#*=}
        [ "$key" != "$line" ] || continue
        case "$key" in
            router_mac) router_mac=$(normalize_mac "$value") ;;
            router_label) router_label="$value" ;;
            *) ;;
        esac
    done <"$config_file"
}

# arp prints octets without leading zeros, so 08:00:27:… comes back as 8:0:27:….
# Both sides of the comparison go through here, or a perfectly good match fails
# on formatting alone.
normalize_mac() {
    printf '%s\n' "$1" \
        | tr '[:upper:]' '[:lower:]' \
        | awk -F: '
            NF != 6 { exit 1 }
            {
                for (i = 1; i <= 6; i++) {
                    if ($i !~ /^[0-9a-f][0-9a-f]?$/) exit 1
                    octet = (length($i) == 1) ? "0" $i : $i
                    printf "%s%s", (i > 1 ? ":" : ""), octet
                }
                printf "\n"
            }
        '
}

wifi_interface() {
    networksetup -listallhardwareports 2>/dev/null \
        | awk '/^Hardware Port: Wi-Fi$/ { getline; print $2; exit }'
}

wired_interfaces() {
    local interface
    local wifi

    wifi=$(wifi_interface)
    for interface in $(ifconfig -l 2>/dev/null | tr ' ' '\n' | grep '^en'); do
        [ "$interface" != "$wifi" ] || continue
        if ifconfig "$interface" 2>/dev/null | grep -q 'status: active'; then
            printf '%s\n' "$interface"
        fi
    done
}

# The router is read per interface rather than from the default route, so that
# a Tailscale exit node taking over the default route cannot change the answer
# to "which network is this cable on".
interface_router() {
    ipconfig getoption "$1" router 2>/dev/null | grep -E '^[0-9.]+$' || return 1
}

arp_hardware_address() {
    arp -n "$1" 2>/dev/null | awk '{ print $4 }'
}

# An address that has aged out of the cache reads as incomplete, which is not
# the same answer as "a different router". One probe repopulates it; anything
# still unreadable after that is treated as unknown, and unknown is untrusted.
router_hardware_address() {
    local router="$1"
    local address

    address=$(normalize_mac "$(arp_hardware_address "$router")" 2>/dev/null) || address=
    if [ -z "$address" ]; then
        ping -c 1 -t 1 "$router" >/dev/null 2>&1 || true
        address=$(normalize_mac "$(arp_hardware_address "$router")" 2>/dev/null) || address=
    fi
    [ -n "$address" ] || return 1
    printf '%s\n' "$address"
}

home_interface() {
    local interface
    local router
    local address

    [ -n "$router_mac" ] || return 1
    while IFS= read -r interface; do
        [ -n "$interface" ] || continue
        router=$(interface_router "$interface") || continue
        address=$(router_hardware_address "$router") || continue
        if [ "$address" = "$router_mac" ]; then
            printf '%s\n' "$interface"
            return 0
        fi
    done <<EOF
$(wired_interfaces)
EOF
    return 1
}

is_on_ac_power() {
    pmset -g batt 2>/dev/null | head -1 | grep -q "'AC Power'"
}

should_stay_awake() {
    local interface

    interface=$(home_interface) || return 1
    awake_reason="wired to ${router_label:-home} on $interface"
}

caffeinate_loaded() {
    launchctl print "gui/$(id -u)/$caffeinate_label" >/dev/null 2>&1
}

start_caffeinate() {
    caffeinate_loaded && return 0
    if [ ! -f "$caffeinate_plist" ]; then
        note "caffeinate job is not installed; run funk install-home-awake"
        return 1
    fi
    launchctl bootstrap "gui/$(id -u)" "$caffeinate_plist" 2>/dev/null || return 1
    note "started caffeinate ($awake_reason)"
    notify "Staying awake: $awake_reason"
}

stop_caffeinate() {
    caffeinate_loaded || return 0
    launchctl bootout "gui/$(id -u)/$caffeinate_label" 2>/dev/null || return 1
    note "stopped caffeinate"
    notify "Left the home network; normal sleep and screen lock restored"
}

sleep_disabled_state() {
    pmset -g 2>/dev/null | awk '/SleepDisabled/ { print $2; exit }'
}

set_sleep_disabled() {
    local desired="$1"

    [ "$(sleep_disabled_state)" != "$desired" ] || return 0
    if sudo -n "$helper" sleep "$desired" >/dev/null 2>&1; then
        note "set disablesleep=$desired"
    else
        note "could not set disablesleep=$desired; run funk install-home-awake"
        return 1
    fi
}

# Prints "off", "immediate", or a plain number of seconds, matching what the
# root helper and the saved-state file accept.
screenlock_state() {
    local output
    local seconds

    output=$(sysadminctl -screenLock status 2>&1) || true
    if printf '%s\n' "$output" | grep -qi 'screenLock is off'; then
        printf 'off\n'
        return 0
    fi
    seconds=$(printf '%s\n' "$output" | grep -oE 'delay is [0-9]+' | grep -oE '[0-9]+' || true)
    [ -n "$seconds" ] || return 1
    if [ "$seconds" -eq 0 ]; then
        printf 'immediate\n'
    else
        printf '%s\n' "$seconds"
    fi
}

set_screenlock() {
    local spec="$1"
    local password

    password=$(security find-generic-password -a "$(id -un)" \
        -s "$keychain_service" -w 2>/dev/null) || {
        note "keychain item '$keychain_service' is missing; run home-awake --set-password"
        return 1
    }
    printf '%s\n' "$password" | sudo -n "$helper" screenlock "$spec" >/dev/null 2>&1
}

disable_screenlock() {
    local current

    current=$(screenlock_state) || return 1
    [ "$current" != off ] || return 0
    mkdir -p "$state_dir"
    printf '%s\n' "$current" >"$screenlock_state_file"
    if set_screenlock off; then
        note "disabled screen lock ($awake_reason; was $current)"
        notify "Screen lock off: $awake_reason"
    else
        rm -f "$screenlock_state_file"
        return 1
    fi
}

restore_screenlock() {
    local current
    local target=immediate

    current=$(screenlock_state) || return 1
    [ "$current" = off ] || return 0
    if [ -f "$screenlock_state_file" ]; then
        target=$(cat "$screenlock_state_file")
    fi
    case "$target" in
        off) target=immediate ;;
    esac
    if set_screenlock "$target"; then
        rm -f "$screenlock_state_file"
        note "restored screen lock ($target)"
    else
        return 1
    fi
}

report_status() {
    local network=away

    if should_stay_awake; then
        network="$awake_reason"
    fi
    printf 'network: %s\n' "$network"
    if caffeinate_loaded; then
        printf 'caffeinate: yes\n'
    else
        printf 'caffeinate: no\n'
    fi
    if [ "$(sleep_disabled_state)" = 1 ]; then
        printf 'sleepdisabled: yes\n'
    else
        printf 'sleepdisabled: no\n'
    fi
    printf 'screenlock: %s\n' "$(screenlock_state || printf 'unknown\n')"
    if [ -n "$router_mac" ]; then
        printf 'home router: %s (%s)\n' "${router_label:-unnamed}" "$router_mac"
    else
        printf 'home router: not recorded; run home-awake --learn-network\n'
    fi
}

learn_network() {
    local label="$1"
    local interface
    local router
    local address
    local directory

    interface=$(wired_interfaces | head -1)
    [ -n "$interface" ] \
        || die "no active wired interface; plug into the home network first"
    router=$(interface_router "$interface") \
        || die "$interface has no router; wait for it to finish configuring"
    address=$(router_hardware_address "$router") \
        || die "the router at $router did not answer; retry once the link is up"
    [ -n "$label" ] || label="$router"

    directory=$(dirname "$config_file")
    mkdir -p "$directory"
    printf '# Written by home-awake --learn-network\nrouter_label=%s\nrouter_mac=%s\n' \
        "$label" "$address" >"$config_file"
    printf 'Recorded %s (%s at %s, via %s) as home in %s\n' \
        "$label" "$address" "$router" "$interface" "$config_file"
}

set_password() {
    printf 'Storing the login password home-awake authenticates screen-lock\n'
    printf 'changes with. It is read by /usr/bin/security only.\n'
    # A bare trailing -w is what makes security prompt for the password instead
    # of taking it as an argument, where it would be visible in the process list
    # and, worse, stored empty if the option were left out entirely.
    security add-generic-password -U -a "$(id -un)" -s "$keychain_service" \
        -T /usr/bin/security -l "Funk home-awake login password" -w \
        || die "the keychain item was not stored"
    printf 'Stored keychain item %s.\n' "$keychain_service"
}

mode=converge
learn_label=
case "${1:-}" in
    '') ;;
    --status) mode=status ;;
    --learn-network)
        mode=learn
        learn_label=${2:-}
        ;;
    --set-password) mode=password ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
case "$mode" in
    learn) [ "$#" -le 2 ] || { usage >&2; exit 64; } ;;
    *) [ "$#" -le 1 ] || { usage >&2; exit 64; } ;;
esac

[ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "HOME is not an existing directory"
read_config

case "$mode" in
    status)
        report_status
        exit 0
        ;;
    learn)
        learn_network "$learn_label"
        exit 0
        ;;
    password)
        set_password
        exit 0
        ;;
esac

status=0
if should_stay_awake; then
    start_caffeinate || status=1
    if is_on_ac_power; then
        set_sleep_disabled 1 || status=1
    else
        set_sleep_disabled 0 || status=1
    fi
    disable_screenlock || status=1
else
    stop_caffeinate || status=1
    set_sleep_disabled 0 || status=1
    restore_screenlock || status=1
fi
exit "$status"
