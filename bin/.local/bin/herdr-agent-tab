#!/usr/bin/env python3
# Open a new Herdr tab in the active workspace and start an agent harness in it.
# Usage: herdr-agent-tab claude|codex|<kind>
#
# Herdr 0.8.0 has no keybind action for "new tab running an agent": `tab create`
# makes the topology and `agent start` adopts an idle shell pane, but nothing
# joins them. Retire this script if a native action lands.

import json
import os
import subprocess
import sys
import time

# A freshly created pane is not an available shell until its startup files
# finish, and `agent start` rejects it as busy until then.
SHELL_READY_TIMEOUT_SECONDS = 10.0
SHELL_POLL_SECONDS = 0.1


def fail(message):
    print(f"herdr-agent-tab: {message}", file=sys.stderr)
    raise SystemExit(1)


# Herdr exports HERDR_BIN_PATH into custom command bindings; fall back to PATH
# so the script is also usable from an ordinary shell.
def call(*args):
    binary = os.environ.get("HERDR_BIN_PATH") or "herdr"
    try:
        completed = subprocess.run(
            [binary, *args], capture_output=True, text=True, check=False
        )
    except OSError as error:
        fail(f"{binary}: {error.strerror}")
    # Successful responses come back on stdout, error responses on stderr.
    for stream in (completed.stdout, completed.stderr):
        try:
            response = json.loads(stream)
        except json.JSONDecodeError:
            continue
        return response.get("result"), response.get("error")
    detail = completed.stderr.strip() or completed.stdout.strip()
    fail(f"{' '.join(args)}: {detail or 'no response'}")


def herdr(*args):
    result, error = call(*args)
    if error is not None:
        fail(f"{' '.join(args)}: {error.get('message', error)}")
    return result


# Agent names are unique among live agents, so number per kind and take the
# first free slot rather than growing forever.
def next_name(kind):
    taken = {agent.get("name") for agent in herdr("agent", "list")["agents"]}
    index = 1
    while f"{kind}-{index}" in taken:
        index += 1
    return f"{kind}-{index}"


# The server's own readiness check is the only authority on "available shell",
# so retry against it rather than guessing from process state.
def start_when_ready(name, kind, pane):
    deadline = time.monotonic() + SHELL_READY_TIMEOUT_SECONDS
    while True:
        _, error = call("agent", "start", name, "--kind", kind, "--pane", pane)
        if error is None:
            return
        if error.get("code") != "agent_pane_busy" or time.monotonic() >= deadline:
            fail(f"agent start {name}: {error.get('message', error)}")
        time.sleep(SHELL_POLL_SECONDS)


def main():
    if len(sys.argv) != 2:
        print("usage: herdr-agent-tab <kind>", file=sys.stderr)
        raise SystemExit(2)
    kind = sys.argv[1]

    name = next_name(kind)
    # No --label: the tab keeps Herdr's default numeric name.
    pane = herdr("tab", "create", "--focus")["root_pane"]["pane_id"]
    # A failed start leaves the tab in place with its usable shell.
    start_when_ready(name, kind, pane)


if __name__ == "__main__":
    main()
