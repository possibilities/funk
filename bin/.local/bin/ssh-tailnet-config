#!/bin/bash
# Write ~/.ssh/config.d/* from the tailnet Tailscale is reporting right now.
#
# A tailnet's MagicDNS suffix and its device names are facts about one person's
# machines, so they are asked for at converge time instead of being kept as
# tracked files that every reader of this repository gets a copy of. The two
# things Tailscale cannot answer -- which account to log in as, and a
# non-default port -- come from a local file that is never tracked.

set -euo pipefail

config_file="$HOME/.config/funk/ssh-tailnet.conf"
config_dir="$HOME/.ssh/config.d"

# Exactly this line opens every generated file, and it is the only evidence this
# command has that a file under config.d is its own. See generated().
marker='# Generated by funk ssh-tailnet-config; edits are overwritten.'
marker_note='# Per-host User and Port come from ~/.config/funk/ssh-tailnet.conf'

default_user=
user_overrides=
port_overrides=
check_only=0
tailscale_bin=
jq_bin=
tailnet_status=
work_dir=

usage() {
    cat <<'EOF'
Usage: ssh-tailnet-config [--check]

Write one ssh_config file per tailnet device into ~/.ssh/config.d, taking the
MagicDNS suffix and the device names from the running Tailscale daemon. Silent
unless something changed.

Accounts and ports come from ~/.config/funk/ssh-tailnet.conf, which no
repository tracks:

  default_user=aardvark
  user.phone=u0_a000
  port.phone=8022

Without that file every host gets this account's own name and no Port.

--check  Report what would change without writing anything
EOF
}

die() {
    printf 'ssh-tailnet-config: %s\n' "$*" >&2
    exit 1
}

# Nothing is wrong with this checkout; Tailscale just cannot answer right now.
# EX_TEMPFAIL is what ./install reads to report the step as deferred rather than
# failing the installation, the same way a running Orca defers its settings
# overlay. Nothing has been written or removed when this is reached, so the
# aliases already on the machine keep working.
defer() {
    printf 'ssh-tailnet-config: %s\n' "$*" >&2
    exit 75
}

report() {
    printf '%s\n' "$*"
}

refuse() {
    printf 'ssh-tailnet-config: %s\n' "$*" >&2
}

# Reported paths are written with a tilde so the message reads the same on any
# account, and so the suite can assert on it without knowing its temporary HOME.
display_path() {
    # shellcheck disable=SC2088 # The tilde is printed as text, never expanded.
    case "$1" in
        "$HOME"/*) printf '~/%s\n' "${1#"$HOME"/}" ;;
        *) printf '%s\n' "$1" ;;
    esac
}

# Both resolvers are tailscale-ensure-online's, spelled the same way and reading
# the same two overrides, because they answer the same question: launchd,
# Raycast, and ./install all hand a script a PATH that reaches neither binary.
# They are copied rather than shared -- the bin package is stowed onto PATH, so
# a sourceable library file there would be one more thing on the operator's PATH
# that is not a command.
tailscale_binary() {
    local candidate
    for candidate in "${TAILSCALE:-}" tailscale \
        /Applications/Tailscale.app/Contents/MacOS/Tailscale \
        /opt/homebrew/bin/tailscale /usr/local/bin/tailscale; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

jq_binary() {
    local candidate
    for candidate in "${JQ:-}" jq /opt/homebrew/bin/jq /usr/local/bin/jq; do
        [ -n "$candidate" ] || continue
        if command -v "$candidate" >/dev/null 2>&1; then
            command -v "$candidate"
            return 0
        fi
    done
    return 1
}

# ssh reads Include before anything else, so a malformed file under config.d
# does not break one host -- it breaks every ssh invocation on the machine,
# including the one that would be used to go fix it. Values stop here instead.
valid_label() {
    case "$1" in
        ''|-*|*-) return 1 ;;
        *[!A-Za-z0-9-]*) return 1 ;;
    esac
}

valid_user() {
    case "$1" in
        ''|-*) return 1 ;;
        *[!A-Za-z0-9._-]*) return 1 ;;
    esac
}

valid_port() {
    case "$1" in
        ''|0*|*[!0-9]*) return 1 ;;
    esac
    [ "${#1}" -le 5 ] && [ "$1" -ge 1 ] && [ "$1" -le 65535 ]
}

# Same shape as home-awake's reader, down to the key=value split, because the
# two files are the same kind of thing: a small local record of facts this
# repository must not carry. Unknown keys are ignored the same way too.
read_config() {
    local key
    local value
    local line
    local host

    [ -f "$config_file" ] || return 0
    while IFS= read -r line; do
        case "$line" in
            ''|'#'*) continue ;;
        esac
        key=${line%%=*}
        value=${line#*=}
        [ "$key" != "$line" ] || continue
        case "$key" in
            default_user)
                valid_user "$value" \
                    || die "$config_file: not a usable account name: $value"
                default_user="$value"
                ;;
            user.*)
                host=${key#user.}
                valid_label "$host" \
                    || die "$config_file: not a usable host name: $host"
                valid_user "$value" \
                    || die "$config_file: not a usable account name: $value"
                printf -v user_overrides '%s%s=%s\n' \
                    "$user_overrides" "$host" "$value"
                ;;
            port.*)
                host=${key#port.}
                valid_label "$host" \
                    || die "$config_file: not a usable host name: $host"
                valid_port "$value" \
                    || die "$config_file: not a usable port: $value"
                printf -v port_overrides '%s%s=%s\n' \
                    "$port_overrides" "$host" "$value"
                ;;
            *) ;;
        esac
    done <"$config_file"
}

override_value() {
    local table="$1"
    local host="$2"
    local line

    while IFS= read -r line; do
        case "$line" in
            "$host="*)
                printf '%s\n' "${line#*=}"
                return 0
                ;;
        esac
    done <<EOF
$table
EOF
    return 1
}

# Deliberately never runs `tailscale up`. Reconnecting is
# tailscale-ensure-online's decision to make; a command that writes
# configuration files must not change the machine's network state on the way
# past.
load_status() {
    local backend
    local online

    tailscale_bin=$(tailscale_binary || true)
    [ -n "$tailscale_bin" ] \
        || defer "Tailscale is not installed; nothing was written"
    jq_bin=$(jq_binary || true)
    [ -n "$jq_bin" ] || defer "jq is missing; run: brew install jq"

    # The macOS GUI application and CLI share one executable. Scripts must set
    # this guard so a sparse launchd or Raycast environment selects CLI mode.
    export TAILSCALE_BE_CLI=1

    tailnet_status=$("$tailscale_bin" status --json 2>/dev/null) \
        || defer "the Tailscale CLI could not reach a valid daemon; nothing was written"
    "$jq_bin" -e '
        type == "object"
        and (.BackendState | type == "string" and length > 0)
    ' >/dev/null 2>&1 <<<"$tailnet_status" \
        || defer "the Tailscale daemon returned invalid status; nothing was written"

    backend=$("$jq_bin" -r '.BackendState' <<<"$tailnet_status")
    [ "$backend" = Running ] \
        || defer "Tailscale is $backend, so its device list is not current; nothing was written"

    online=$("$jq_bin" -r '
        if (.Self.Online | type) == "boolean" then .Self.Online else "invalid" end
    ' <<<"$tailnet_status")
    [ "$online" = true ] \
        || defer "this node is offline, so Tailscale's device list is not current; nothing was written"
}

# Self is included: a host alias should mean the same thing on every machine in
# the tailnet, so every machine generates the same set.
tailnet_devices() {
    "$jq_bin" -r '
        ([.Self] + ((.Peer // {}) | to_entries | map(.value)))
        | map(select(type == "object"))
        | .[]
        | [(.HostName // ""), ((.DNSName // "") | rtrimstr("."))]
        | @tsv
    ' <<<"$tailnet_status"
}

collect_hosts() {
    local suffix
    local host_name
    local dns_name
    local host
    local fqdn

    suffix=$("$jq_bin" -r '.MagicDNSSuffix // empty' <<<"$tailnet_status")
    suffix=${suffix%.}

    while IFS=$'\t' read -r host_name dns_name; do
        # The alias is the MagicDNS label, not the operating system's hostname.
        # Tailscale sanitises a hostname into a label once and then keeps the
        # label across renames, so the two drift apart and only the label
        # resolves: a phone reporting itself as "MIKE's S22" is reachable
        # nowhere but smolbird.tailnet. HostName is the fallback for a tailnet
        # with MagicDNS off, which reports no DNS name at all.
        host=${dns_name%%.*}
        [ -n "$host" ] || host=$host_name
        # A tailnet can be shared with other people's devices, and they choose
        # their own names -- a name becomes a file name under ~/.ssh here, so
        # anything that is not a plain DNS label is refused rather than
        # sanitised. @tsv escapes an embedded tab or newline as a backslash
        # sequence, so a name cannot split this line apart to get past it.
        if ! valid_label "$host"; then
            refuse "skipping a tailnet device whose name is not usable as a file name: ${host_name:-$dns_name}"
            continue
        fi
        fqdn=$dns_name
        if [ -z "$fqdn" ]; then
            if [ -z "$suffix" ]; then
                refuse "skipping $host: Tailscale reported neither a DNS name nor a MagicDNS suffix"
                continue
            fi
            fqdn="$host.$suffix"
        fi
        printf '%s\t%s\n' "$host" "$fqdn" >>"$host_table"
    done <<EOF
$(tailnet_devices)
EOF
}

# The marker is checked on the first line only, so a hand-written file that
# happens to quote it further down is still protected. A symlink is never this
# command's own file either: following one would write through a Stow link
# straight back into the repository, which is the exact thing this generator
# exists to stop.
generated() {
    local first=

    [ -f "$1" ] && [ ! -L "$1" ] || return 1
    IFS= read -r first <"$1" || true
    [ "$first" = "$marker" ]
}

write_host() {
    local host="$1"
    local fqdn="$2"
    local target="$config_dir/$host"
    local temporary="$work_dir/$host"
    local user
    local port

    user=$(override_value "$user_overrides" "$host") || user=$default_user
    port=$(override_value "$port_overrides" "$host") || port=

    {
        printf '%s\n' "$marker"
        printf '%s\n' "$marker_note"
        printf 'Host %s\n' "$host"
        printf '  Hostname %s\n' "$fqdn"
        [ -z "$port" ] || printf '  Port %s\n' "$port"
        printf '  User %s\n' "$user"
    } >"$temporary"

    if [ -e "$target" ] || [ -L "$target" ]; then
        if ! generated "$target"; then
            refuse "refusing to overwrite $(display_path "$target"): it carries no generated header, so this command did not write it"
            return 0
        fi
        if cmp -s "$temporary" "$target"; then
            return 0
        fi
    fi
    if [ "$check_only" -eq 1 ]; then
        report "would write $(display_path "$target")"
        return 0
    fi
    chmod 0600 "$temporary"
    mv -f "$temporary" "$target"
    report "wrote $(display_path "$target")"
}

prune_departed() {
    local existing
    local host

    [ -d "$config_dir" ] || return 0
    for existing in "$config_dir"/*; do
        [ -e "$existing" ] || [ -L "$existing" ] || continue
        host=${existing##*/}
        # A broken link is the one foreign entry worth complaining about every
        # run: ssh aborts on an Include it cannot read, so it breaks every
        # connection rather than this host's.
        if [ -L "$existing" ] && [ ! -e "$existing" ]; then
            refuse "$(display_path "$existing") is a broken symlink; ssh refuses every connection while it is there"
            continue
        fi
        if grep -qxF "$host" "$keep_table"; then
            continue
        fi
        generated "$existing" || continue
        if [ "$check_only" -eq 1 ]; then
            report "would remove $(display_path "$existing")"
            continue
        fi
        rm -f "$existing"
        report "removed $(display_path "$existing")"
    done
}

case "${1:-}" in
    '') ;;
    --check) check_only=1 ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac
[ "$#" -le 1 ] || { usage >&2; exit 64; }

[ -n "${HOME:-}" ] && [ -d "$HOME" ] || die "HOME is not an existing directory"

read_config
[ -n "$default_user" ] || default_user=$(id -un)
valid_user "$default_user" \
    || die "this account's name cannot be used in an ssh_config: $default_user"

load_status

umask 077
work_dir=$(mktemp -d "${TMPDIR:-/tmp}/funk-ssh-tailnet.XXXXXX")
trap 'rm -rf "$work_dir"' EXIT
host_table="$work_dir/hosts"
keep_table="$work_dir/keep"
duplicate_table="$work_dir/duplicates"
: >"$host_table"
: >"$keep_table"

collect_hosts

# A daemon that answers Running but lists nothing is one that is still starting
# or has lost its netmap. Believing it would prune every host file on the
# machine, so an empty answer is treated as no answer at all.
[ -s "$host_table" ] \
    || defer "Tailscale listed no usable devices; nothing was written or removed"

# ~/.ssh is 0700 and these files name the accounts this machine logs in as, so
# the directory they live in is held to the same mode on every run.
if [ "$check_only" -eq 0 ]; then
    mkdir -p "$config_dir"
    chmod 0700 "$config_dir"
fi

cut -f1 "$host_table" | LC_ALL=C sort | uniq -d >"$duplicate_table"
while IFS= read -r duplicate; do
    [ -n "$duplicate" ] || continue
    refuse "skipping the ambiguous device name $duplicate: more than one tailnet device answers to it"
done <"$duplicate_table"

while IFS=$'\t' read -r host fqdn; do
    [ -n "$host" ] || continue
    # An ambiguous name is still recorded as one to keep. Its existing file is
    # stale, but a stale alias beats deleting the operator's only written record
    # of how to reach that machine.
    printf '%s\n' "$host" >>"$keep_table"
    if grep -qxF "$host" "$duplicate_table"; then
        continue
    fi
    write_host "$host" "$fqdn"
done <"$host_table"

prune_departed
