#!/bin/bash
# Keep a 16GB machine off the swap cliff that kills WindowServer.
#
# The failure this exists for is not a slow machine: it is a kernel panic.
# When memory runs out, the compressor thrashes, WindowServer misses its
# watchdog check-ins, and the kernel panics the box —
# "userspace watchdog timeout: no successful checkins from WindowServer".
# The machine dies with every unsaved thing on it, so the useful moment is
# well before the cliff, not at it.
#
# Two jobs, in escalating order:
#
#   1. Collect garbage, always. Orphaned codex-multi-auth runtime helpers
#      accumulate when a launcher detaches and never comes back; a stranded
#      helper is ~50MB of nothing. Patched wrappers self-reap, so this is the
#      backstop for every unpatched install on the machine.
#   2. Warn, then act. Past the warn threshold the operator gets a banner
#      naming what is eating the machine, while there is still time to close
#      something. Past the act threshold, runaway searches are killed —
#      a multi-gigabyte `ugrep`/`rg` is a mistake, never a workload.
#
# What it will never kill: agent sessions, editors, browsers, the window
# manager, or anything else not on the narrow list above. A guard that starts
# guessing at the operator's real work is worse than the crash it prevents.

set -euo pipefail

warn_swap_gb=${FUNK_MEMORY_GUARD_WARN_SWAP_GB:-3}
act_swap_gb=${FUNK_MEMORY_GUARD_ACT_SWAP_GB:-5}
helper_idle_secs=${FUNK_MEMORY_GUARD_HELPER_IDLE_SECS:-600}
search_rss_mb=${FUNK_MEMORY_GUARD_SEARCH_RSS_MB:-400}
search_age_secs=${FUNK_MEMORY_GUARD_SEARCH_AGE_SECS:-120}
notify_interval_secs=${FUNK_MEMORY_GUARD_NOTIFY_INTERVAL_SECS:-600}
state_dir=${FUNK_MEMORY_GUARD_STATE_DIR:-$HOME/.local/state/funk}
notify_stamp="$state_dir/memory-guard-notified"

usage() {
    cat <<'EOF'
Usage: memory-guard [--status | --dry-run | --check]

Runs one pass: reaps orphaned Codex runtime helpers, and under memory
pressure warns about, then kills, runaway search processes.

  --status    print the current numbers and thresholds, change nothing
  --dry-run   report what a pass would do, kill nothing
  --check     verify the tools this needs, change nothing
EOF
}

mode=act
case "${1:-}" in
    "") ;;
    --status) mode=status ;;
    --dry-run) mode=dry ;;
    --check) mode=check ;;
    --help | -h) usage; exit 0 ;;
    *) usage >&2; exit 64 ;;
esac

log() {
    printf '%s memory-guard: %s\n' "$(date '+%Y-%m-%dT%H:%M:%S%z')" "$*"
}

# A notification is a courtesy wrapped around the outcome, never the outcome:
# a missing notifier must not fail a pass that reclaimed memory.
notify() {
    command -v funk-notify >/dev/null 2>&1 || return 0
    funk-notify --title "$1" --message "$2" --group funk-memory-guard || true
}

swap_used_mb() {
    # vm.swapusage reports like: total = 5120.00M  used = 3594.75M  free = ...
    sysctl -n vm.swapusage 2>/dev/null \
        | awk '{for (i = 1; i <= NF; i++) if ($i == "used") {sub(/M$/, "", $(i + 2)); printf "%.0f", $(i + 2); exit}}'
}

# ps prints elapsed as [[dd-]hh:]mm:ss, which no arithmetic accepts.
etime_to_secs() {
    awk -v t="$1" 'BEGIN {
        n = split(t, p, /[-:]/)
        if (n == 2) print p[1] * 60 + p[2]
        else if (n == 3) print p[1] * 3600 + p[2] * 60 + p[3]
        else if (n == 4) print p[1] * 86400 + p[2] * 3600 + p[3] * 60 + p[4]
        else print 0
    }'
}

top_consumers() {
    ps -Axo rss,comm 2>/dev/null | sort -rn | head -3 \
        | awk '{name = $2; sub(/.*\//, "", name); printf "%s %.1fGB; ", name, $1 / 1048576}'
}

# Orphaned Codex runtime helpers: reparented to launchd, idle, and old enough
# that no launcher is plausibly coming back for them.
orphan_helper_pids() {
    ps -Axo pid,ppid,pcpu,etime,command 2>/dev/null \
        | grep '[c]odex-multi-auth-runtime-app-helper' \
        | while read -r pid ppid pcpu etime _rest; do
            [ "$ppid" = 1 ] || continue
            awk -v c="$pcpu" 'BEGIN {exit !(c + 0 < 0.5)}' || continue
            [ "$(etime_to_secs "$etime")" -ge "$helper_idle_secs" ] || continue
            printf '%s\n' "$pid"
        done
}

# A search holding hundreds of megabytes for minutes is walking a tree nobody
# meant it to walk. Matched by executable name so a file merely *named* rg
# cannot be selected by a path fragment.
runaway_search_pids() {
    ps -Axo pid,rss,etime,comm 2>/dev/null \
        | while read -r pid rss etime comm; do
            case "${comm##*/}" in
                ugrep | rg | ripgrep) ;;
                *) continue ;;
            esac
            [ "$((rss / 1024))" -ge "$search_rss_mb" ] || continue
            [ "$(etime_to_secs "$etime")" -ge "$search_age_secs" ] || continue
            printf '%s\n' "$pid"
        done
}

rss_mb_of() {
    ps -o rss= -p "$1" 2>/dev/null | awk '{printf "%.0f", $1 / 1024}'
}

# SIGTERM first: a helper writes its terminal status stamp and removes its
# owner file on the way out, which a SIGKILL would strand.
reap() {
    local pid=$1
    kill "$pid" 2>/dev/null || return 0
    for _ in 1 2 3 4 5 6; do
        kill -0 "$pid" 2>/dev/null || return 0
        sleep 0.5
    done
    kill -9 "$pid" 2>/dev/null || true
}

if [ "$mode" = check ]; then
    for tool in ps sysctl awk; do
        command -v "$tool" >/dev/null 2>&1 || {
            printf 'memory-guard: required tool missing: %s\n' "$tool" >&2
            exit 1
        }
    done
    [ -n "$(swap_used_mb)" ] || {
        printf 'memory-guard: cannot read vm.swapusage\n' >&2
        exit 1
    }
    command -v funk-notify >/dev/null 2>&1 \
        || printf 'note: funk-notify is not installed; passes will act silently\n'
    printf 'memory-guard checks out (warn at %sGB swap, act at %sGB).\n' \
        "$warn_swap_gb" "$act_swap_gb"
    exit 0
fi

swap_mb=$(swap_used_mb)
[ -n "$swap_mb" ] || swap_mb=0
warn_mb=$((warn_swap_gb * 1024))
act_mb=$((act_swap_gb * 1024))

if [ "$mode" = status ]; then
    printf 'swap used: %sMB (warn %sMB, act %sMB)\n' "$swap_mb" "$warn_mb" "$act_mb"
    printf 'top consumers: %s\n' "$(top_consumers)"
    orphans=$(orphan_helper_pids | grep -c '[0-9]' || true)
    searches=$(runaway_search_pids | grep -c '[0-9]' || true)
    printf 'orphaned helpers: %s\n' "$orphans"
    printf 'runaway searches: %s\n' "$searches"
    exit 0
fi

reclaimed_mb=0
actions=()

# Tier 0, unconditional: stranded helpers are garbage at any pressure level.
while read -r pid; do
    [ -n "$pid" ] || continue
    mb=$(rss_mb_of "$pid")
    [ -n "$mb" ] || continue
    if [ "$mode" = dry ]; then
        log "would reap orphaned helper $pid (${mb}MB)"
    else
        reap "$pid"
        log "reaped orphaned helper $pid (${mb}MB)"
    fi
    reclaimed_mb=$((reclaimed_mb + mb))
    actions+=("helper $pid")
done < <(orphan_helper_pids)

# Tier 2 before tier 1: if the machine is already past the act threshold, the
# operator needs the banner *and* the reclaim, not one or the other.
if [ "$swap_mb" -ge "$act_mb" ]; then
    while read -r pid; do
        [ -n "$pid" ] || continue
        mb=$(rss_mb_of "$pid")
        [ -n "$mb" ] || continue
        cmd=$(ps -o comm= -p "$pid" 2>/dev/null | sed 's|.*/||')
        if [ "$mode" = dry ]; then
            log "would kill runaway search $pid ($cmd, ${mb}MB)"
        else
            reap "$pid"
            log "killed runaway search $pid ($cmd, ${mb}MB)"
        fi
        reclaimed_mb=$((reclaimed_mb + mb))
        actions+=("$cmd $pid")
    done < <(runaway_search_pids)
fi

if [ "${#actions[@]}" -gt 0 ] && [ "$mode" != dry ]; then
    notify "Memory guard reclaimed ${reclaimed_mb}MB" \
        "$(printf '%s, ' "${actions[@]}" | sed 's/, $//')"
fi

# The warning is the point of the whole thing: the operator can close a session
# in seconds, and nothing this script is allowed to kill will save a machine
# that a dozen agent sessions are filling. Rate-limited, because a banner that
# repeats every 30 seconds is one the reader learns to dismiss unread.
if [ "$swap_mb" -ge "$warn_mb" ]; then
    now=$(date +%s)
    last=0
    [ -f "$notify_stamp" ] && last=$(cat "$notify_stamp" 2>/dev/null || echo 0)
    if [ "$((now - last))" -ge "$notify_interval_secs" ]; then
        log "swap at ${swap_mb}MB; top: $(top_consumers)"
        if [ "$mode" != dry ]; then
            mkdir -p "$state_dir"
            printf '%s' "$now" >"$notify_stamp"
            notify "Memory pressure: ${swap_mb}MB swapped" \
                "Close something before the machine swaps itself to death. Top: $(top_consumers)"
        else
            log "would warn: swap ${swap_mb}MB"
        fi
    fi
fi

exit 0
