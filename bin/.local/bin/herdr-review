#!/bin/bash
# Show the diff worth reviewing for the focused Herdr workspace.
# On a branch: merge-base with the repo's default branch through the working
# tree, so an agent's commits and its uncommitted work read as one diff.
# On the default branch or a detached HEAD: uncommitted changes only.
# Usage: herdr-review
#
# Meant for a popup binding, so every exit that prints instead of paging waits
# for a key first — a popup closes the moment the command exits.

pause() {
    printf '\n%s' "press any key"
    read -rsn1
    printf '\n'
}

die() {
    printf '%s\n' "$1"
    pause
    exit 1
}

# Herdr exports this for custom command bindings; the fallback keeps the script
# usable from an ordinary shell.
cwd="${HERDR_ACTIVE_PANE_CWD:-$PWD}"

root=$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null) ||
    die "not a git repository: $cwd"

# Empty when HEAD is detached, which a worktree can be.
branch=$(git -C "$root" symbolic-ref --quiet --short HEAD 2>/dev/null)

base=$(git -C "$root" symbolic-ref --quiet --short refs/remotes/origin/HEAD 2>/dev/null)
base="${base#origin/}"
if [ -z "$base" ]; then
    for candidate in main master; do
        if git -C "$root" rev-parse --verify --quiet "$candidate" >/dev/null; then
            base="$candidate"
            break
        fi
    done
fi

# Prefer the local base branch; fall back to the remote-tracking ref, which is
# all a fresh worktree may have.
base_ref=""
if [ -n "$base" ]; then
    for candidate in "$base" "origin/$base"; do
        if git -C "$root" rev-parse --verify --quiet "$candidate" >/dev/null; then
            base_ref="$candidate"
            break
        fi
    done
fi

range=""
if [ -n "$branch" ] && [ -n "$base_ref" ] && [ "$branch" != "$base" ]; then
    range=$(git -C "$root" merge-base HEAD "$base_ref" 2>/dev/null)
fi

if [ -z "$range" ]; then
    if git -C "$root" diff --quiet HEAD; then
        die "no uncommitted changes in $(basename "$root") on ${branch:-detached HEAD}"
    fi
    git -C "$root" diff HEAD
    exit
fi

if git -C "$root" diff --quiet "$range"; then
    die "$branch matches $base_ref; nothing to review"
fi

git -C "$root" diff "$range"
