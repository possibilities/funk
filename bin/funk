#!/bin/bash

set -euo pipefail

resolve_self() {
    local source_path="$1"
    local source_dir
    local link_target

    while [ -L "$source_path" ]; do
        source_dir=$(cd -P -- "$(dirname -- "$source_path")" && pwd)
        link_target=$(readlink "$source_path")
        case "$link_target" in
            /*) source_path="$link_target" ;;
            *) source_path="$source_dir/$link_target" ;;
        esac
    done

    source_dir=$(cd -P -- "$(dirname -- "$source_path")" && pwd)
    printf '%s/%s\n' "$source_dir" "$(basename -- "$source_path")"
}

usage() {
    cat <<'EOF'
Usage: funk <command>

Commands:
  update [--notify]  Install or upgrade packages declared by Funk
  stow [options]     Link Funk's user configuration packages into HOME
  chuchu-theme       Build/reinstall Chuchu Lab with the Signal Room theme
  install-android-launchers [--check]
                      Install the four native Android launcher applications
  install-ghostty-terminfo
                      Install Ghostty's terminal definition for remote shells
  ssh-tailnet-config [--check]
                      Write ~/.ssh/config.d from live Tailscale state
  git-identity [--status]
                      Set this account's commit name and address, once
  install-updater    Install and load Funk's four-times-daily user LaunchAgent
  install-tailscale-recovery
                      Install the login/five-minute Tailscale recovery agent
  home-awake [option] Converge or report home-network sleep and screen lock
  install-home-awake  Install the home-network sleep and screen-lock agent
  install-agentlaunch-shims
                      Install PATH shims that balance bare claude/codex/pi launches
  verify-local-services
                      Confirm the fleet services are running and reachable
  transcript-vault   Run the transcript preservation pipeline once now
  install-transcript-vault
                      Install the hourly transcript preservation agent
  cass-window-reset  Rebuild the cass search index over the live stores now
  install-cass-window-reset
                      Install the monthly search-window reset agent
  configure-macos    Apply Funk's user-level macOS preferences
  verify-notifications
                      Confirm Funk's health alerts can reach the screen
  configure-system   Apply Funk's privileged machine-wide settings
  harden <action>    Show status or reapply the travel firewall posture
  install-hardening  Install the root-owned hardening service
  yabai <action>     Show or maintain the Yabai scripting-addition layer
  reload-karabiner   Restart Karabiner so it re-reads the Stow-linked config
  install-windows    Install the window stack and converge Yabai Spaces 1-9
  help               Show this help
EOF
}

self=$(resolve_self "$0")
FUNK_ROOT=$(cd -P -- "$(dirname -- "$self")/.." && pwd)
export FUNK_ROOT

command_name=${1:-help}
case "$command_name" in
    update)
        shift
        exec "$FUNK_ROOT/libexec/funk-update" "$@"
        ;;
    stow)
        shift
        exec "$FUNK_ROOT/libexec/stow-config" "$@"
        ;;
    chuchu-theme)
        shift
        exec "$FUNK_ROOT/libexec/install-chuchu-lab-theme" "$@"
        ;;
    install-android-launchers)
        shift
        exec "$FUNK_ROOT/libexec/install-android-launchers" "$@"
        ;;
    install-ghostty-terminfo)
        shift
        exec "$FUNK_ROOT/libexec/install-ghostty-terminfo" "$@"
        ;;
    ssh-tailnet-config)
        shift
        exec "$FUNK_ROOT/bin/.local/bin/ssh-tailnet-config" "$@"
        ;;
    git-identity)
        shift
        exec "$FUNK_ROOT/bin/.local/bin/git-identity" "$@"
        ;;
    install-updater)
        shift
        exec "$FUNK_ROOT/libexec/install-update-agent" "$@"
        ;;
    install-tailscale-recovery)
        shift
        exec "$FUNK_ROOT/libexec/install-tailscale-agent" "$@"
        ;;
    home-awake)
        shift
        exec "$FUNK_ROOT/bin/.local/bin/home-awake" "$@"
        ;;
    install-home-awake)
        shift
        exec "$FUNK_ROOT/libexec/install-home-awake" "$@"
        ;;
    install-agentlaunch-shims)
        shift
        # AgentStart owns the fleet-facing installers; this stays a funk
        # subcommand for muscle memory and delegates.
        agentstart_shims="$HOME/code/agentstart/scripts/install-agentlaunch-shims"
        if [ ! -x "$agentstart_shims" ]; then
            printf 'funk: AgentStart owns the AgentLaunch shims and is missing: %s\n' \
                "$agentstart_shims" >&2
            exit 66
        fi
        exec "$agentstart_shims" "$@"
        ;;
    verify-local-services)
        shift
        exec "$FUNK_ROOT/libexec/verify-local-services" "$@"
        ;;
    transcript-vault)
        shift
        exec "$FUNK_ROOT/bin/.local/bin/transcript-vault" "$@"
        ;;
    install-transcript-vault)
        shift
        exec "$FUNK_ROOT/libexec/install-transcript-vault-agent" "$@"
        ;;
    cass-window-reset)
        shift
        exec "$FUNK_ROOT/bin/.local/bin/cass-window-reset" "$@"
        ;;
    install-cass-window-reset)
        shift
        exec "$FUNK_ROOT/libexec/install-cass-window-reset-agent" "$@"
        ;;
    configure-macos)
        shift
        exec "$FUNK_ROOT/libexec/configure-macos" "$@"
        ;;
    verify-notifications)
        shift
        exec "$FUNK_ROOT/libexec/verify-notifications" "$@"
        ;;
    configure-system)
        shift
        exec "$FUNK_ROOT/libexec/configure-system" "$@"
        ;;
    harden)
        shift
        exec "$FUNK_ROOT/libexec/funk-harden-client" "$@"
        ;;
    install-hardening)
        shift
        exec "$FUNK_ROOT/libexec/install-hardening" "$@"
        ;;
    yabai)
        shift
        exec "$FUNK_ROOT/libexec/funk-yabai" "$@"
        ;;
    reload-karabiner)
        shift
        exec "$FUNK_ROOT/libexec/reload-karabiner" "$@"
        ;;
    install-windows)
        shift
        exec "$FUNK_ROOT/libexec/install-window-manager" "$@"
        ;;
    help|-h|--help)
        usage
        ;;
    *)
        printf 'funk: unknown command: %s\n\n' "$command_name" >&2
        usage >&2
        exit 64
        ;;
esac
