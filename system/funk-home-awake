#!/bin/bash
# Apply only the privileged sleep change home-awake needs.
# Grant the two validated invocations, not passwordless access to pmset itself.

set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022

pmset=/usr/bin/pmset

die() {
    printf 'funk-home-awake: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: funk-home-awake sleep <0|1>
       funk-home-awake validate

sleep       Set or clear the system-wide disablesleep flag
validate    Check that the required system binary is present
EOF
}

validate_environment() {
    [ -x "$pmset" ] || die "missing required binary: $pmset"
}

case "${1:-}" in
    validate)
        [ "$#" -eq 1 ] || { usage >&2; exit 64; }
        validate_environment
        printf 'funk-home-awake is installable.\n'
        exit 0
        ;;
    sleep)
        [ "$#" -eq 2 ] || { usage >&2; exit 64; }
        case "$2" in
            0|1) ;;
            *) die "invalid sleep argument: $2" ;;
        esac
        ;;
    -h|--help)
        usage
        exit 0
        ;;
    *)
        usage >&2
        exit 64
        ;;
esac

[ "$(id -u)" -eq 0 ] || die "must run as root"
validate_environment
exec "$pmset" -a disablesleep "$2"
