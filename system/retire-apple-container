#!/bin/bash
# Explicit administrator retirement of the exact Apple package Funk installed.
set -euo pipefail
[[ $(id -u) == 0 ]] || { echo 'Run this helper with administrator authorization.' >&2; exit 1; }
uninstaller=/usr/local/bin/uninstall-container.sh
[[ -f "$uninstaller" && ! -L "$uninstaller" ]] || { echo 'Apple uninstaller absent or unsafe.' >&2; exit 1; }
[[ $(stat -f %u "$uninstaller") == 0 ]] || { echo 'Apple uninstaller is not root-owned.' >&2; exit 1; }
[[ $(shasum -a 256 "$uninstaller" | cut -d ' ' -f 1) == 076772d8d5c63b781d73a9bf7f19c0d938e122155e295a4181376580bcc35d5d ]] \
    || { echo 'Apple uninstaller differs from the reviewed 0.8.0 package.' >&2; exit 1; }
pkgutil --pkg-info com.apple.container-installer | grep -Fx 'version: 0.8.0' >/dev/null
# -k retains all user data. Never pass -d.
/bin/bash "$uninstaller" -k
[[ ! -e /usr/local/bin/container && ! -e /usr/local/bin/container-apiserver ]]
