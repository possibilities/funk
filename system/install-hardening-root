#!/bin/bash

set -euo pipefail
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
umask 022

helper_target=/usr/local/libexec/funk-harden
daemon_label=io.arthack.funk.harden-boot
legacy_daemon_label=com.arthack.funk.harden-boot
daemon_target="/Library/LaunchDaemons/$daemon_label.plist"
legacy_daemon_target="/Library/LaunchDaemons/$legacy_daemon_label.plist"
pf_conf=/etc/pf.conf
anchor_line='anchor "com.arthack.funk.travel"'

die() {
    printf 'funk hardening installer: %s\n' "$*" >&2
    exit 1
}

guard_root_directory() {
    local directory="$1"
    local owner
    local mode

    [ -d "$directory" ] || die "required directory is missing: $directory"
    [ ! -L "$directory" ] || die "refusing symlink directory: $directory"
    owner=$(stat -f '%Su' "$directory")
    mode=$(stat -f '%Lp' "$directory")
    [ "$owner" = root ] || die "$directory must be root-owned"
    [ $((8#$mode & 8#022)) -eq 0 ] || die "$directory must not be group/world-writable"
}

target_user=
source_root=
while [ "$#" -gt 0 ]; do
    case "$1" in
        --user)
            [ "$#" -ge 2 ] || die "--user requires a value"
            target_user="$2"
            shift 2
            ;;
        --source-root)
            [ "$#" -ge 2 ] || die "--source-root requires a value"
            source_root="$2"
            shift 2
            ;;
        *)
            die "unknown argument: $1"
            ;;
    esac
done

[ "$(id -u)" -eq 0 ] || die "must run as root"
[ -n "$target_user" ] || die "--user is required"
[ -n "$source_root" ] || die "--source-root is required"
printf '%s\n' "$target_user" | grep -Eq '^[A-Za-z_][A-Za-z0-9._-]*$' \
    || die "invalid user name: $target_user"
target_uid=$(id -u "$target_user" 2>/dev/null) || die "user does not exist: $target_user"
[ "$target_uid" -ge 500 ] || die "refusing system account: $target_user"
lock_file=/var/run/funk-hardening-install.lock
/usr/bin/shlock -p "$$" -f "$lock_file" \
    || die "another Funk hardening installation is already running"
tmpdir=
cleanup() {
    [ -z "$tmpdir" ] || rm -rf "$tmpdir"
    rm -f "$lock_file"
}
trap cleanup EXIT

source_root=$(cd -P -- "$source_root" && pwd)
helper_source="$source_root/system/funk-harden"
daemon_source="$source_root/system/$daemon_label.plist"
[ -f "$helper_source" ] && [ ! -L "$helper_source" ] \
    || die "invalid helper source: $helper_source"
[ -f "$daemon_source" ] && [ ! -L "$daemon_source" ] \
    || die "invalid daemon source: $daemon_source"
/usr/bin/plutil -lint "$daemon_source" >/dev/null \
    || die "invalid LaunchDaemon plist"
daemon_marker="$daemon_label.v1"
[ "$(/usr/libexec/PlistBuddy -c 'Print :FunkInstallerOwner' "$daemon_source" 2>/dev/null || true)" = "$daemon_marker" ] \
    || die "LaunchDaemon source lacks ownership marker"
/bin/bash "$helper_source" validate

if [ -e "$daemon_target" ] || [ -L "$daemon_target" ]; then
    [ -f "$daemon_target" ] && [ ! -L "$daemon_target" ] \
        && [ "$(/usr/libexec/PlistBuddy -c 'Print :FunkInstallerOwner' "$daemon_target" 2>/dev/null || true)" = "$daemon_marker" ] \
        || die "refusing to replace a LaunchDaemon Funk does not own: $daemon_target"
fi
daemon_preloaded=0
if /bin/launchctl print "system/$daemon_label" >/dev/null 2>&1; then
    daemon_preloaded=1
    [ -f "$daemon_target" ] \
        || die "refusing to replace a loaded LaunchDaemon with no owned plist: $daemon_label"
fi
legacy_daemon_preloaded=0
if /bin/launchctl print "system/$legacy_daemon_label" >/dev/null 2>&1; then
    legacy_daemon_preloaded=1
    [ -f "$legacy_daemon_target" ] \
        || die "refusing to replace a loaded legacy LaunchDaemon with no owned plist: $legacy_daemon_label"
fi
if [ -e "$legacy_daemon_target" ] || [ -L "$legacy_daemon_target" ]; then
    [ -f "$legacy_daemon_target" ] && [ ! -L "$legacy_daemon_target" ] \
        || die "refusing invalid legacy LaunchDaemon: $legacy_daemon_target"
    [ "$(stat -f '%Su' "$legacy_daemon_target")" = root ] \
        || die "legacy LaunchDaemon must be root-owned"
    /usr/bin/python3 - "$legacy_daemon_target" "$daemon_source" "$daemon_label" <<'PYTHON' \
        || die "refusing to replace a legacy LaunchDaemon Funk does not own: $legacy_daemon_target"
import plistlib
import sys

legacy_path, source_path, new_label = sys.argv[1:]
with open(legacy_path, "rb") as handle:
    legacy = plistlib.load(handle)
with open(source_path, "rb") as handle:
    source = plistlib.load(handle)
legacy["Label"] = new_label
source.pop("FunkInstallerOwner", None)
raise SystemExit(0 if legacy == source else 1)
PYTHON
fi

if [ ! -e /usr/local/libexec ]; then
    /usr/bin/install -d -o root -g wheel -m 0755 /usr/local/libexec
fi
guard_root_directory /usr/local/libexec
guard_root_directory /Library/LaunchDaemons
guard_root_directory /etc/sudoers.d

[ -f "$pf_conf" ] && [ ! -L "$pf_conf" ] || die "invalid $pf_conf"
pf_owner=$(stat -f '%Su' "$pf_conf")
pf_mode=$(stat -f '%Lp' "$pf_conf")
[ "$pf_owner" = root ] || die "$pf_conf must be root-owned"
[ $((8#$pf_mode & 8#022)) -eq 0 ] || die "$pf_conf must not be group/world-writable"

tmpdir=$(mktemp -d /private/tmp/funk-hardening-install.XXXXXX)

if ! grep -Eq '^[[:space:]]*anchor[[:space:]]+"com\\.arthack\\.funk\\.travel"' "$pf_conf"; then
    pf_candidate="$tmpdir/pf.conf"
    cp "$pf_conf" "$pf_candidate"
    printf '\n# Funk fail-closed travel posture\n%s\n' "$anchor_line" >> "$pf_candidate"
    /sbin/pfctl -nf "$pf_candidate" >/dev/null \
        || die "updated $pf_conf failed PF validation"

    if [ ! -e /etc/pf.conf.pre-funk ]; then
        /usr/bin/install -o root -g wheel -m "$pf_mode" "$pf_conf" /etc/pf.conf.pre-funk
    fi
    /usr/bin/install -o root -g wheel -m "$pf_mode" "$pf_candidate" "$pf_conf"
fi

/usr/bin/install -o root -g wheel -m 0755 "$helper_source" "$helper_target"

sudoers_candidate="$tmpdir/sudoers"
printf '%s ALL=(root) NOPASSWD: %s status\n' "$target_user" "$helper_target" > "$sudoers_candidate"
printf '%s ALL=(root) NOPASSWD: %s travel\n' "$target_user" "$helper_target" >> "$sudoers_candidate"
/bin/chmod 0440 "$sudoers_candidate"
/usr/sbin/visudo -cf "$sudoers_candidate" >/dev/null \
    || die "generated sudoers rules failed validation"
sudoers_target="/etc/sudoers.d/funk-harden-$target_uid"
/usr/bin/install -o root -g wheel -m 0440 "$sudoers_candidate" "$sudoers_target"

if [ ! -e /Library/Logs/Funk ]; then
    /usr/bin/install -d -o root -g wheel -m 0755 /Library/Logs/Funk
fi
guard_root_directory /Library/Logs/Funk
daemon_backup=
if [ -f "$daemon_target" ]; then
    daemon_backup="$tmpdir/daemon.plist"
    cp -p "$daemon_target" "$daemon_backup"
fi
/usr/bin/install -o root -g wheel -m 0644 "$daemon_source" "$daemon_target"
current_was_loaded=0
legacy_was_loaded=0
rollback_daemon() {
    rm -f "$daemon_target"
    if [ -n "$daemon_backup" ]; then
        /usr/bin/install -o root -g wheel -m 0644 "$daemon_backup" "$daemon_target"
        [ "$current_was_loaded" -eq 0 ] \
            || /bin/launchctl bootstrap system "$daemon_target" >/dev/null 2>&1 || true
    fi
    [ "$legacy_was_loaded" -eq 0 ] \
        || /bin/launchctl bootstrap system "$legacy_daemon_target" >/dev/null 2>&1 || true
}
if [ "$daemon_preloaded" -eq 1 ]; then
    current_was_loaded=1
    if ! /bin/launchctl bootout "system/$daemon_label" >/dev/null 2>&1; then
        rollback_daemon
        die "failed to stop $daemon_label; restored the previous plist"
    fi
fi
if [ "$legacy_daemon_preloaded" -eq 1 ]; then
    legacy_was_loaded=1
    if ! /bin/launchctl bootout "system/$legacy_daemon_label" >/dev/null 2>&1; then
        rollback_daemon
        die "failed to stop $legacy_daemon_label; restored the previous service"
    fi
fi
if ! /bin/launchctl bootstrap system "$daemon_target"; then
    rollback_daemon
    die "failed to load $daemon_label; restored the previous service"
fi
if [ -f "$legacy_daemon_target" ]; then
    rm "$legacy_daemon_target"
    printf 'Replaced %s with %s\n' "$legacy_daemon_label" "$daemon_label"
fi

printf 'Installed and loaded %s\n' "$daemon_label"
printf 'Installed narrow sudoers rules for %s: status and travel only\n' "$target_user"
