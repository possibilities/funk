          {
            "description": "Right Option + H/J/K/L sends arrow keys and preserves Shift",
            "manipulators": [
              {
                "type": "basic",
                "from": {
                  "key_code": "h",
                  "modifiers": {
                    "mandatory": ["right_option"],
                    "optional": ["shift"]
                  }
                },
                "to": [{ "key_code": "left_arrow" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "j",
                  "modifiers": {
                    "mandatory": ["right_option"],
                    "optional": ["shift"]
                  }
                },
                "to": [{ "key_code": "down_arrow" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "k",
                  "modifiers": {
                    "mandatory": ["right_option"],
                    "optional": ["shift"]
                  }
                },
                "to": [{ "key_code": "up_arrow" }]
              },
              {
                "type": "basic",
                "from": {
                  "key_code": "l",
                  "modifiers": {
                    "mandatory": ["right_option"],
                    "optional": ["shift"]
                  }
                },
                "to": [{ "key_code": "right_arrow" }]
              }
            ]
          },
          {
            "description": "Swap left Command and left Option on the built-in keyboard",
            "manipulators": [
              {
                "type": "basic",
                "conditions": [
                  {
                    "type": "device_if",
                    "identifiers": [{ "is_built_in_keyboard": true }]
                  }
                ],
                "from": {
                  "key_code": "left_command",
                  "modifiers": { "optional": ["any"] }
                },
                "to": [{ "key_code": "left_option" }]
              },
