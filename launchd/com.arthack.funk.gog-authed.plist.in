<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.arthack.funk.gog-authed</string>
  <key>ProgramArguments</key>
  <array>
    <string>__GOG_ENSURE_AUTHED__</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>__FUNK_HOME__</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>900</integer>
  <key>ProcessType</key>
  <string>Background</string>
  <key>StandardOutPath</key>
  <string>__FUNK_LOG_PATH__</string>
  <key>StandardErrorPath</key>
  <string>__FUNK_LOG_PATH__</string>
</dict>
</plist>
