#!/bin/bash

set -euo pipefail

with_hardening=0
with_windows=1
with_system_settings=0

usage() {
    cat <<'EOF'
Usage: ./install [--with-hardening] [--without-windows] [--with-system-settings] [--all]

Default installation:
  - installs Homebrew when missing
  - applies Funk's Brewfile
  - installs the AI desktop applications
  - runs the AgentStart installer, which owns the AI command-line toolchain,
    harness configuration, and every globally managed agent skill
  - stows all user configuration packages into the target user's home
  - installs the window stack and converges Yabai Spaces 1-9
  - links the funk command into the active Homebrew bin directory
  - installs and loads the update and Tailscale recovery LaunchAgents
  - installs the home-network sleep and screen-lock agent
  - verifies the resident services AgentStart installs: the Agentbrain worker
    and share ingress, the Agentweb daemon, and the Agentusage daemon
  - applies Funk's user-level macOS preferences
  - writes ~/.ssh/config.d from the tailnet Tailscale is reporting

Options:
  --with-hardening  Also install and immediately apply boot-time travel hardening
  --without-windows Skip Yabai, skhd, Karabiner startup, and Space convergence
  --with-system-settings
                    Also apply Funk's privileged machine-wide macOS settings
  --all             Enable hardening and machine-wide system settings
EOF
}

die() {
    printf 'Funk installer: %s\n' "$*" >&2
    exit 1
}

resolve_self() {
    local source_path="$1"
    local source_dir
    local target

    while [ -L "$source_path" ]; do
        source_dir=$(cd -P -- "$(dirname -- "$source_path")" && pwd)
        target=$(readlink "$source_path")
        case "$target" in
            /*) source_path="$target" ;;
            *) source_path="$source_dir/$target" ;;
        esac
    done
    source_dir=$(cd -P -- "$(dirname -- "$source_path")" && pwd)
    printf '%s/%s\n' "$source_dir" "$(basename -- "$source_path")"
}

find_brew() {
    if command -v brew >/dev/null 2>&1; then
        command -v brew
        return
    fi
    for candidate in /opt/homebrew/bin/brew /usr/local/bin/brew; do
        if [ -x "$candidate" ]; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    return 1
}

while [ "$#" -gt 0 ]; do
    case "$1" in
        --with-hardening) with_hardening=1 ;;
        # Retained as a compatibility no-op now that windows are installed by default.
        --with-windows) with_windows=1 ;;
        --without-windows) with_windows=0 ;;
        --with-system-settings) with_system_settings=1 ;;
        --all)
            with_hardening=1
            with_windows=1
            with_system_settings=1
            ;;
        -h|--help)
            usage
            exit 0
            ;;
        *)
            usage >&2
            exit 64
            ;;
    esac
    shift
done

[ "$(uname -s)" = Darwin ] || die "macOS is required"
[ "$(id -u)" -ne 0 ] || die "run as the target user, not root"

self=$(resolve_self "$0")
funk_root=$(cd -P -- "$(dirname -- "$self")" && pwd)
funk_command="$funk_root/bin/funk"
[ -x "$funk_command" ] || die "missing command: $funk_command"

if ! brew_bin=$(find_brew); then
    printf 'Homebrew is missing; running Homebrew'\''s official installer.\n'
    /bin/bash -c \
        "$(/usr/bin/curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
    brew_bin=$(find_brew) || die "Homebrew installer completed but brew is unavailable"
fi

brew_prefix=$("$brew_bin" --prefix)
brew_owner=$(stat -f '%Su' "$brew_prefix")
[ "$brew_owner" = "$(id -un)" ] \
    || die "Homebrew prefix $brew_prefix is owned by $brew_owner, not $(id -un); resolve ownership before using Funk"
export PATH="$brew_prefix/bin:/usr/bin:/bin:/usr/sbin:/sbin"

cli_dir="$brew_prefix/bin"
cli_path="$cli_dir/funk"
if [ -e "$cli_path" ] || [ -L "$cli_path" ]; then
    [ -L "$cli_path" ] && [ "$cli_path" -ef "$funk_command" ] \
        || die "refusing to replace existing command: $cli_path"
else
    ln -s "$funk_command" "$cli_path"
fi

# Applications left behind by a previous account cannot be upgraded by this one,
# so Homebrew would fall back to its own sudo chown on every run and the
# scheduled updater, which has no terminal, could never converge them. Reclaim
# them once here; the step is a silent no-op once ownership is correct.
"$funk_root/libexec/reclaim-app-ownership" \
    --brewfile "$funk_root/Brewfile" \
    claude chatgpt stablyai/orca/orca

# A cask installed under a previous account keeps that account's install
# directories forever, so its upgrades fail against a home this one cannot even
# read -- and Homebrew reports only that some source file "is not there". Repair
# is a reinstall, unprivileged for the user-directory artifacts this selects.
"$funk_root/libexec/repair-cask-user-dirs" --brewfile "$funk_root/Brewfile" \
    || printf 'install: some casks could not be reinstalled under this account\n' >&2

FUNK_ROOT="$funk_root" "$funk_root/libexec/converge-brewfile"
"$funk_command" stow
"$funk_root/libexec/initialize-configs"

# The AI desktop applications are Funk's: Homebrew casks, installed here and
# converged greedily because they carry no updater conflict — except Orca,
# which ships its own updater and is installed once, then left alone.
"$funk_root/libexec/converge-brew-casks" claude chatgpt
"$funk_root/libexec/install-orca"

# Everything the agent fleet depends on — harness CLIs, pinned npm globals,
# MCP registration, guidance links, and every globally managed skill — is
# owned by the AgentStart checkout, and this machine is not converged without
# it. A missing checkout is a hard stop, like a missing Art Hack checkout
# inside that installer, not an optional skip.
agentstart_root="$HOME/code/agentstart"
[ -x "$agentstart_root/scripts/install.sh" ] \
    || die "AgentStart owns the AI toolchain and is missing; clone it first: git clone <your AgentStart remote> $agentstart_root"
"$agentstart_root/scripts/install.sh" --install
# Orca owns its own settings file while it runs, so configure-orca refuses to
# race it and exits EX_TEMPFAIL. That is a step to repeat after quitting Orca,
# not a failed installation, so record it and finish everything else.
orca_settings_deferred=0
orca_status=0
"$funk_command" configure-orca || orca_status=$?
if [ "$orca_status" -eq 75 ]; then
    orca_settings_deferred=1
elif [ "$orca_status" -ne 0 ]; then
    exit "$orca_status"
fi

"$funk_command" install-updater
"$funk_command" install-tailscale-recovery
"$funk_command" install-home-awake
"$funk_command" install-transcript-vault
"$funk_command" install-memory-guard
"$funk_command" configure-macos

# ~/.ssh/config.d is generated from live Tailscale state rather than tracked, so
# a fresh account has no tailnet host aliases at all until this runs. Tailscale
# being signed out or offline is a "run it again later", not a failed
# installation: nothing is written, nothing is removed, and whatever aliases are
# already on the machine go on working.
# Asks for a name and address exactly once, on an account that has neither, and
# is silent forever after. It runs before the ssh hosts because both want the
# operator's attention and a question is better asked before a report scrolls
# past it.
"$funk_command" git-identity

ssh_hosts_deferred=0
ssh_hosts_failed=0
ssh_hosts_status=0
"$funk_command" ssh-tailnet-config || ssh_hosts_status=$?
if [ "$ssh_hosts_status" -eq 75 ]; then
    ssh_hosts_deferred=1
elif [ "$ssh_hosts_status" -ne 0 ]; then
    ssh_hosts_failed=1
fi

# Reported, never fatal: a blocked notifier is the operator's toggle to flip,
# and refusing to finish installing over it would help no one.
notifications_blocked=0
"$funk_command" verify-notifications || notifications_blocked=1

# Installing a service proves only that a plist was written. These checks prove
# the daemons answer, which is a different question and the one that matters:
# an ingress that is loaded but unreachable, or a worker whose conduit wiring an
# older installer quietly dropped, both look installed and neither works.
local_services_degraded=0
"$funk_command" verify-local-services || local_services_degraded=1

if [ "$with_system_settings" -eq 1 ]; then
    "$funk_command" configure-system
fi
if [ "$with_hardening" -eq 1 ]; then
    "$funk_command" install-hardening
fi
if [ "$with_windows" -eq 1 ]; then
    "$funk_command" install-windows
fi

cat <<EOF
Funk installation complete.

Command: $cli_path
Repository: $funk_root
Update log: $HOME/Library/Logs/Funk/update.log
Tailscale recovery log: $HOME/Library/Logs/Funk/tailscale-online.log
home-awake log: $HOME/Library/Logs/Funk/home-awake.log
Transcript vault log: $HOME/Library/Logs/Funk/transcript-vault.log
Memory guard log: $HOME/Library/Logs/Funk/memory-guard.log
EOF

if [ "$orca_settings_deferred" -eq 1 ]; then
    cat <<'EOF'

Deferred: Orca was running, so its settings overlay was left alone rather than
raced. Quit Orca and run: funk configure-orca
EOF
fi

if [ "$notifications_blocked" -eq 1 ]; then
    cat <<'EOF'

Action required: notifications are blocked for terminal-notifier, so Funk's
unattended health alerts reach no one. Enable them at System Settings >
Notifications > terminal-notifier, choosing the Alerts style, then run:
funk verify-notifications
EOF
fi

if [ "$local_services_degraded" -eq 1 ]; then
    cat <<'EOF'

Action required: the resident Agentbrain, Agentweb, and Agentusage services
installed, but one or more of them is not answering. The failures are listed
above. Re-check with: funk verify-local-services
EOF
fi

if [ "$ssh_hosts_deferred" -eq 1 ]; then
    cat <<'EOF'

Deferred: Tailscale could not supply the tailnet's device list, so
~/.ssh/config.d was left exactly as it was. Sign in or reconnect Tailscale and
run: funk ssh-tailnet-config
EOF
fi

if [ "$ssh_hosts_failed" -eq 1 ]; then
    cat <<'EOF'

Action required: the tailnet ssh host files could not be written. The reason is
above and ~/.ssh/config.d was left alone. Re-run with: funk ssh-tailnet-config
EOF
fi
