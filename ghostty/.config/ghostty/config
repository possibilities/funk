auto-update-channel = tip
# Funk names the theme, so a fresh account converges to these colors and every
# other layer follows the terminal. Ultra Dark is one of the themes the Ghostty
# cask installs; the `ghostty-themes` picker browses them and writes its pick
# to the machine-local Application Support config, which Ghostty loads second
# and which therefore outranks this line until the pick is promoted here.
theme = Ultra Dark
working-directory = home
window-inherit-working-directory = true
window-save-state = never
font-size = 20
font-family = "0xProto Nerd Font"
copy-on-select = clipboard
window-decoration = none
window-padding-x = 0
window-padding-y = 0
window-padding-balance = true
unfocused-split-opacity = 1
bell-features = no-attention,no-title,no-system,no-audio,no-border
# Native Ghostty splits mirror the directional pane controls used in tmux and
# Herdr, without capturing their unmodified Option bindings.
keybind = cmd+alt+\=new_split:right
keybind = cmd+alt+-=new_split:down
keybind = cmd+alt+h=goto_split:left
keybind = cmd+alt+j=goto_split:down
keybind = cmd+alt+k=goto_split:up
keybind = cmd+alt+l=goto_split:right
keybind = ctrl+cmd+h=resize_split:left,10
keybind = ctrl+cmd+j=resize_split:down,10
keybind = ctrl+cmd+k=resize_split:up,10
keybind = ctrl+cmd+l=resize_split:right,10
keybind = ctrl+cmd+e=equalize_splits
# Send an unambiguous CSI-u Shift+Enter. Legacy ESC+CR is also Alt+Enter
# in tmux and can collide with application shortcuts.
keybind = shift+enter=text:\x1b[13;2u
macos-option-as-alt = true
keybind = alt+1=text:\x1b\x31
keybind = alt+2=text:\x1b\x32
