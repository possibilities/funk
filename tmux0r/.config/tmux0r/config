# tmux0r configuration. Ghostty-shaped: one `key = value` per line, `#` lines
# are comments, later lines win, an empty value restores the default.
# Keys: prefix, tray-width, harness, harness.<name>.<field>, family.<name>.<field>.
# Reference: ~/code/tmux0r/README.md and `tmux0r --help`.

# The one chord tmux keeps. `prefix d` detaches; `prefix prefix` sends the
# chord through to the shown agent. Ghostty key names: ctrl+space, alt+a,
# shift+tab, f5, or a bare key such as `space` (which would then intercept
# every space typed to an agent until the next key).
prefix = ctrl+space

# Tray width in columns at first start; dragging the divider remembers a new
# width per instance in ~/.local/state/tmux0r/<instance>/ui.json.
tray-width = 26

# The harness agent.start uses when none is named. Built in: claude, codex,
# each on PATH with the fleet's model catalog (same data as agentlaunch).
# Override any field or add a harness or family with dotted keys, e.g.
#   harness.claude.args = --dangerously-skip-permissions
#   harness.claude.model = opus-1m
#   harness.pi.command = pi
#   harness.pi.families = gpt
#   harness.pi.model-args = --model {model}:{effort}
#   family.gpt.model = gpt-5.7
# Fields and templates: ~/code/tmux0r/README.md, "Harnesses and models".
harness = claude
